000000                   	; ============================================================================
000000                   	; T48 v2 -- LA VOIE ROM COMPLETE : 47h condense -> 48h cre_top -> 42h resize
000000                   	; ============================================================================
000000                   	; La v1 a mesure (2026-09-25, PC-E500S reel) que 48h REFUSE, erreur 0Ch, tant
000000                   	; que la chaine est jointive : il exige de la place APRES la chaine, et il n'y
000000                   	; en a jamais -- DATA.BAS la detient toute. 47h condense la rend. Cette sonde
000000                   	; enchaine donc les trois commandes que la ROM offre, et regarde si elles font
000000                   	; le travail que notre installateur fait a la main.
000000                   	;
000000                   	; ⛔ LE COMPACTAGE DEPLACE TEXT.BAS ET DATA.BAS, ET LA ROM NE RECALE RIEN.
000000                   	;    47h (0F0A19h) appelle 42h deux fois par bloc puis SUB_F029D, qui ne met a
000000                   	;    jour que [0BFC1Bh] ; il n'efface meme pas le bit du lecteur de
000000                   	;    [(iocsw)+3Ah], contrairement a 48h (0F0330h). Apres un compactage nu,
000000                   	;    (txtbas) et (datbas) designent donc l'ancienne place des blocs du BASIC.
000000                   	;    D'ou la regle de PLINKC, reprise ici : APPELER linkbas DERRIERE CHAQUE
000000                   	;    COMMANDE QUI DEPLACE, SUR TOUS LES CHEMINS, ERREURS COMPRISES. C'est la
000000                   	;    raison d'etre de cette sonde : la sequence ne peut pas s'essayer depuis le
000000                   	;    BASIC, qui reprendrait la main entre deux commandes avec des pointeurs faux.
000000                   	;
000000                   	; ⚠️ A APPELER EN MODE DIRECT, jamais depuis un programme : le programme vit
000000                   	;    dans TEXT.BAS, que le compactage deplace sous ses pieds.
000000                   	;
000000                   	; linkbas est repris mot pour mot de BASEXTDR.ASM (bd_linkbas) : les noms des
000000                   	; deux blocs du BASIC sont ranges en [baswrk]+72h, chacun precede de son numero
000000                   	; de lecteur ; 41h search_phys rend l'adresse et avance X sur l'entree suivante.
000000                   	;
000000                   	; Zone de resultat, hors du code, dans la zone reservee :
000000                   	;   0BFBE0h  1 octet   derniere etape atteinte : 1=47h 2=48h 3=42h(a=0)
000000                   	;                      5=42h(a=1) 4=41h relecture, 6=fini
000000                   	;   0BFBE1h  1 octet   code d'erreur rendu dans A
000000                   	;   0BFBE2h  3 octets  Y rendu par 48h : l'adresse du bloc cree
000000                   	;   0BFBE5h  3 octets  adresse du bloc apres 42h, relue par 41h
000000                   	;   0BFBE8h  3 octets  Y rendu par 42h (taille possible, s'il refuse)
000000                   	;   0BFBEBh  3 octets  SIGNATURE 'T42', ecrite en dernier (voir T48.ASM)
000000                   	;
000000                   	; Assemblage : xasm2026-4 T482.ASM -OT482.OBJ -L -S -B -K
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	txtbas: equ 0CBH ; TEXT.BAS courant
000000                   	datbas: equ 0CEH ; DATA.BAS courant
000000                   	cl:     equ 0D6H ; registre CL / CX bas
000000                   	ch:     equ 0D7H ; registre CH / CX haut
000000                   	iocsw:  equ 0E6H ; zone de travail IOCS : recopie du pointeur [0BFD17h] (3 octets) (manuel technique, IOCS Special Technique p85-86)
000000                   	baswrk:           equ 0BFD0EH ; POINTEUR (3 octets) vers la zone de travail du BASIC, en memoire EXTERNE : il CONTIENT l'adresse, il N'EST PAS la zone. La ROM le recopie dans basptr par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Nom de E. Kako (register.ls ...
000000                   	iocs_call:        equ 0FFFE8H ; IOCS call entry
000000                   	d6_search_phys:   equ 41H   ; memcard_search_phys - adresse physique d'un bloc d'apres son nom ((ch) = slot 0/1/2, X = nom du bloc ;
000000                   	d6_block_resize:  equ 42H   ; memcard_block_resize - changement de taille d'un bloc ((ch) = slot, a = numero de pointeur de zone libr
000000                   	d6_condense:      equ 47H   ; memcard_condense - compactage de l'espace libre des blocs memoire ((ch) = slot)
000000                   	d6_blk_cre_top:   equ 48H   ; memcard_block_create_top - creation d'un bloc memoire EN TETE des blocs, propre au PC-E500 ((ch) = slot, X
000000                   	
000000                   	res_etape:      equ     0BFBE0H
000000                   	res_err:        equ     0BFBE1H
000000                   	res_adr48:      equ     0BFBE2H
000000                   	res_adr42:      equ     0BFBE5H
000000                   	res_y42:        equ     0BFBE8H
000000                   	res_sig:        equ     0BFBEBH
000000                   	
000000                   	taille:         equ     000B17H         ; 2839 octets : la taille du bloc de BASEXT-DRV
000000                   	
0BF000                   	        org     0BF000H
0BF000                   	        pre_on
0BF000                   	
0BF000                   	start:
0BF000 08 00             	        mv      a,000H
0BF002 A8 E0 FB 0B       	        mv      [res_etape],a
0BF006 A8 E1 FB 0B       	        mv      [res_err],a
0BF00A 0D FF FF 0F       	        mv      y,0FFFFFH
0BF00E AD E2 FB 0B       	        mv      [res_adr48],y
0BF012 AD E5 FB 0B       	        mv      [res_adr42],y
0BF016 AD E8 FB 0B       	        mv      [res_y42],y
0BF01A                   	
0BF01A                   	; --- etape 1 : 47h condense -------------------------------------------------
0BF01A 08 01             	        mv      a,001H
0BF01C A8 E0 FB 0B       	        mv      [res_etape],a
0BF020 30 CD D6 06 00    	        mvw     (cl),00006H             ; device 6, lecteur 0 (S1:)
0BF025 09 47             	        mv      il,d6_condense
0BF027 05 E8 FF 0F       	        callf   iocs_call
0BF02B 1C 91             	        jrc     echec
0BF02D 04 D9 F0          	        call    linkbas                 ; il a deplace TEXT.BAS et DATA.BAS
0BF030                   	
0BF030                   	; --- etape 2 : 48h block_create_top -----------------------------------------
0BF030 08 02             	        mv      a,002H
0BF032 A8 E0 FB 0B       	        mv      [res_etape],a
0BF036 30 CD D6 06 00    	        mvw     (cl),00006H
0BF03B 0C 09 F1 0B       	        mv      x,nom
0BF03F 0D 17 0B 00       	        mv      y,taille
0BF043 09 48             	        mv      il,d6_blk_cre_top
0BF045 05 E8 FF 0F       	        callf   iocs_call
0BF049 1C 73             	        jrc     echec
0BF04B AD E2 FB 0B       	        mv      [res_adr48],y           ; adresse du bloc cree
0BF04F 04 D9 F0          	        call    linkbas                 ; il a decale la chaine de 22h octets
0BF052                   	
0BF052                   	; --- etape 3 : 42h block_resize, d'abord avec a=0 ---------------------------
0BF052                   	; Le carnet : « a = numero de pointeur de zone libre 0/1, X = nom, Y = taille
0BF052                   	; demandee ; erreur a = 000h carte protegee, 005h bloc protege, 00Ch memoire
0BF052                   	; insuffisante, Y = taille possible ». Lequel des deux pointeurs fait grandir
0BF052                   	; un bloc n'est pas etabli : on essaie 0, puis 1.
0BF052 08 03             	        mv      a,003H
0BF054 A8 E0 FB 0B       	        mv      [res_etape],a
0BF058 30 CD D6 06 00    	        mvw     (cl),00006H
0BF05D 0C 09 F1 0B       	        mv      x,nom
0BF061 0D 17 0B 00       	        mv      y,taille
0BF065 08 00             	        mv      a,000H                  ; pointeur de zone libre 0
0BF067 09 42             	        mv      il,d6_block_resize
0BF069 05 E8 FF 0F       	        callf   iocs_call
0BF06D 1E 25             	        jrnc    t42_ok
0BF06F                   	
0BF06F AD E8 FB 0B       	        mv      [res_y42],y             ; ce que 42h dit possible
0BF073 A8 E1 FB 0B       	        mv      [res_err],a
0BF077 08 05             	        mv      a,005H
0BF079 A8 E0 FB 0B       	        mv      [res_etape],a
0BF07D 30 CD D6 06 00    	        mvw     (cl),00006H
0BF082 0C 09 F1 0B       	        mv      x,nom
0BF086 0D 17 0B 00       	        mv      y,taille
0BF08A 08 01             	        mv      a,001H                  ; pointeur de zone libre 1
0BF08C 09 42             	        mv      il,d6_block_resize
0BF08E 05 E8 FF 0F       	        callf   iocs_call
0BF092 1C 2A             	        jrc     echec
0BF094                   	
0BF094                   	t42_ok:
0BF094 AD E8 FB 0B       	        mv      [res_y42],y
0BF098 04 D9 F0          	        call    linkbas                 ; il a decale les blocs suivants
0BF09B                   	
0BF09B                   	; --- etape 4 : relire l'adresse du bloc par 41h -----------------------------
0BF09B 08 04             	        mv      a,004H
0BF09D A8 E0 FB 0B       	        mv      [res_etape],a
0BF0A1 30 CD D6 06 00    	        mvw     (cl),00006H
0BF0A6 0C 09 F1 0B       	        mv      x,nom
0BF0AA 09 41             	        mv      il,d6_search_phys
0BF0AC 05 E8 FF 0F       	        callf   iocs_call
0BF0B0 1C 0C             	        jrc     echec
0BF0B2 AD E5 FB 0B       	        mv      [res_adr42],y
0BF0B6                   	
0BF0B6 08 06             	        mv      a,006H                  ; sequence complete
0BF0B8 A8 E0 FB 0B       	        mv      [res_etape],a
0BF0BC 12 07             	        jr      fini
0BF0BE                   	
0BF0BE                   	echec:
0BF0BE A8 E1 FB 0B       	        mv      [res_err],a             ; le code AVANT tout autre usage de A
0BF0C2 04 D9 F0          	        call    linkbas                 ; meme en erreur : PLINKC fait de meme
0BF0C5                   	
0BF0C5                   	fini:
0BF0C5 0C 14 F1 0B       	        mv      x,sig
0BF0C9 0D EB FB 0B       	        mv      y,res_sig
0BF0CD 09 03             	        mv      il,003H
0BF0CF 90 24             	sig_cp: mv      a,[x++]
0BF0D1 B0 25             	        mv      [y++],a
0BF0D3 7C 01             	        dec     il
0BF0D5 1B 08             	        jrnz    sig_cp
0BF0D7 9F                	        rc                              ; retour propre a BASIC
0BF0D8 07                	        retf
0BF0D9                   	
0BF0D9                   	; ---------------------------------------------------------------------------
0BF0D9                   	; linkbas -- (txtbas) et (datbas) retrouves par leur nom, puis drapeau a zero.
0BF0D9                   	;            Repris de BASEXTDR.ASM (bd_linkbas). Appel proche.
0BF0D9                   	; ---------------------------------------------------------------------------
0BF0D9                   	linkbas:
0BF0D9 8C 0E FD 0B       	        mv      x,[baswrk]
0BF0DD 08 72             	        mv      a,072H
0BF0DF 45 40             	        add     x,a
0BF0E1 04 FA F0          	        call    lb_chercher
0BF0E4 1C 13             	        jrc     lb_perdu
0BF0E6 30 A5 CB          	        mv      (txtbas),y
0BF0E9 04 FA F0          	        call    lb_chercher
0BF0EC 1C 0B             	        jrc     lb_perdu
0BF0EE 30 A5 CE          	        mv      (datbas),y
0BF0F1 08 00             	        mv      a,000H
0BF0F3 30 B8 80 E6 3A    	        mv      [(iocsw)+03AH],a
0BF0F8 06                	        ret
0BF0F9                   	lb_perdu:
0BF0F9 FF                	        reset                           ; comme PLINKC : la memoire est incoherente
0BF0FA                   	lb_chercher:
0BF0FA 30 E0 24 D7       	        mv      (ch),[x++]              ; numero de lecteur, puis X sur le nom
0BF0FE 30 CC D6 06       	        mv      (cl),006H
0BF102 09 41             	        mv      il,041H
0BF104 05 E8 FF 0F       	        callf   iocs_call
0BF108 06                	        ret
0BF109                   	
0BF109 54 34 38 20 20 20 	nom:    db      'T48     SYS'
0BF10F 20 20 53 59 53    	
0BF114 54 34 32          	sig:    db      'T42'
0BF117                   	
0BF117                   	btm:
0BF117                   	        assert  btm-start < 0300H       ; la sonde reste loin de res_etape
0BF117                   	        end

