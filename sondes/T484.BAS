10 REM T484 : LA TRACE DE LINKBAS -- OU (TXTBAS) DECROCHE-T-IL ?
20 REM RUN AVANT, CALL &BF000 EN MODE DIRECT, PUIS RUN
30 CLEAR :WAIT 150:DIM V(15)
40 E=PEEK &BFBE0
50 IF E=0 THEN PRINT "SONDE PAS ENCORE APPELEE":END
60 R=PEEK &BFBE1
70 FOR I=0 TO 15
80 P=&BFB80+I*3
90 V(I)=PEEK P+PEEK (P+1)*256+PEEK (P+2)*65536
100 NEXT I
110 POKE &BFBE0,0
120 PRINT "ETAPE ";E;" ERR ";HEX$ R
130 PRINT "ENTREE T ";HEX$ V(0);" D ";HEX$ V(1)
140 PRINT "L1 CHERCHE ";HEX$ V(2);" ";HEX$ V(3)
150 PRINT "L1 ECRIT T ";HEX$ V(4);" D ";HEX$ V(5)
160 PRINT "L2 CHERCHE ";HEX$ V(6);" ";HEX$ V(7)
170 PRINT "L2 ECRIT T ";HEX$ V(8);" D ";HEX$ V(9)
180 PRINT "L3 CHERCHE ";HEX$ V(10);" ";HEX$ V(11)
190 PRINT "L3 ECRIT T ";HEX$ V(12);" D ";HEX$ V(13)
200 PRINT "SORTIE T ";HEX$ V(14);" D ";HEX$ V(15)
210 PRINT "MAINTENANT T ";HEX$ (PEEK &CB+PEEK &CC*256+PEEK &CD*65536);" D ";HEX$ (PEEK &CE+PEEK &CF*256+PEEK &D0*65536)
220 REM --- LA CHAINE, POUR SAVOIR QUI EST OU
230 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
240 X=T+PEEK (T+18)+PEEK (T+19)*256+PEEK (T+20)*65536
250 IF PEEK X<>&FB THEN 300
260 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
270 L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536
280 PRINT HEX$ X;" ";N$;" ";L
290 IF L>0 THEN X=X+L:GOTO 250
300 PRINT "OTER : SET ""S1:T48.SYS"","" "" PUIS KILL"
