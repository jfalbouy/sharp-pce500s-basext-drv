10 REM T484 : LA TRACE DE LINKBAS -- OU (TXTBAS) DECROCHE-T-IL ?
20 REM RUN AVANT, CALL &BF000 EN MODE DIRECT, PUIS RUN
30 REM TOUT EST ECRIT A L ECRAN *ET* DANS F:T484RES.BAS (IDIOME DE MODDIAG)
40 REM POUR REVOIR SANS RAPPELER LA SONDE : POKE &BFBDF,&84 PUIS RUN
50 CLEAR 
60 S=PEEK &BFBDF:E=PEEK &BFBE0:R=PEEK &BFBE1
70 IF S<>&84 THEN PRINT "T484 PAS ENCORE APPELEE (ID ";HEX$ S;")":END
80 CLS :OPEN "F:T484RES.BAS" FOR OUTPUT AS #1
90 L$="ETAPE "+HEX$ E+" ERR "+HEX$ R:GOSUB 900
100 P=&BFB80:GOSUB 800:L$="E-TXT "+H$:GOSUB 900
110 P=&BFB83:GOSUB 800:L$="E-DAT "+H$:GOSUB 900
120 P=&BFB86:GOSUB 800:L$="L1-CHERCHE1 "+H$:GOSUB 900
130 P=&BFB89:GOSUB 800:L$="L1-CHERCHE2 "+H$:GOSUB 900
140 P=&BFB8C:GOSUB 800:L$="L1-TXT "+H$:GOSUB 900
150 P=&BFB8F:GOSUB 800:L$="L1-DAT "+H$:GOSUB 900
160 P=&BFB92:GOSUB 800:L$="L2-CHERCHE1 "+H$:GOSUB 900
170 P=&BFB95:GOSUB 800:L$="L2-CHERCHE2 "+H$:GOSUB 900
180 P=&BFB98:GOSUB 800:L$="L2-TXT "+H$:GOSUB 900
190 P=&BFB9B:GOSUB 800:L$="L2-DAT "+H$:GOSUB 900
200 P=&BFB9E:GOSUB 800:L$="L3-CHERCHE1 "+H$:GOSUB 900
210 P=&BFBA1:GOSUB 800:L$="L3-CHERCHE2 "+H$:GOSUB 900
220 P=&BFBA4:GOSUB 800:L$="L3-TXT "+H$:GOSUB 900
230 P=&BFBA7:GOSUB 800:L$="L3-DAT "+H$:GOSUB 900
240 P=&BFBAA:GOSUB 800:L$="S-TXT "+H$:GOSUB 900
250 P=&BFBAD:GOSUB 800:L$="S-DAT "+H$:GOSUB 900
260 P=&CB:GOSUB 800:L$="MAINTENANT-TXT "+H$:GOSUB 900
270 P=&CE:GOSUB 800:L$="MAINTENANT-DAT "+H$:GOSUB 900
280 REM --- LA CHAINE DES BLOCS
290 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
300 X=T+PEEK (T+18)+PEEK (T+19)*256+PEEK (T+20)*65536
310 IF PEEK X<>&FB THEN 360
320 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
330 L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536
340 L$="BLOC "+HEX$ X+" "+N$+" A"+HEX$ PEEK (X+12)+" L"+HEX$ L:GOSUB 900
350 IF L>0 THEN X=X+L:GOTO 310
360 L$="FIN "+HEX$ X+" S1BTM "+HEX$ (PEEK &BFCDE+PEEK &BFCDF*256+PEEK &BFCE0*65536):GOSUB 900
370 POKE &BFBDF,0:POKE &BFBE0,0
380 CLOSE :PRINT "FIN -- VOIR F:T484RES.BAS"
390 END 
800 REM --- H$ = LES 3 OCTETS EN P, EN HEXA
810 V=PEEK P+PEEK (P+1)*256+PEEK (P+2)*65536:H$=HEX$ V:RETURN 
900 REM --- ECRIT A L ECRAN ET DANS LE FICHIER
910 PRINT L$:PRINT #1, L$:RETURN 
