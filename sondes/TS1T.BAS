10 REM TS1T : S1_TAIL (BFC1B) FACE A LA VRAIE FIN DE CHAINE -- RELECTURE SEULE
20 REM LES INSTANTANES SE PRENNENT PAR CALL &BF800 EN MODE DIRECT, JAMAIS ICI :
30 REM CE PROGRAMME FAIT GRANDIR DATA.BAS, DONC CORRIGE S1_TAIL EN S EXECUTANT
40 REM ECRIT A L ECRAN ET DANS F:TS1TRES.BAS, REECRIT A CHAQUE RUN AVEC TOUS LES INSTANTANES
50 CLEAR 
60 IF PEEK &BFBDF<>&A6 THEN PRINT "AUCUN INSTANTANE DE TS1T":END 
70 CLS :OPEN "F:TS1TRES.BAS" FOR OUTPUT AS #1
80 N=PEEK &BFBE0:L$="TS1T INSTANTANES : "+STR$ N:GOSUB 900
90 IF N=0 THEN 200
100 FOR K=0 TO N-1:P=&BFB80+9*K
110 F=PEEK P+PEEK (P+1)*256+PEEK (P+2)*65536
120 T=PEEK (P+3)+PEEK (P+4)*256+PEEK (P+5)*65536
130 B=PEEK (P+6)+PEEK (P+7)*256+PEEK (P+8)*65536
140 L$=STR$ (K+1)+" FIN "+HEX$ F+" TAIL "+HEX$ T+" BTM "+HEX$ B:GOSUB 900
150 D=T-F-1
160 IF D=0 THEN L$="  EN PHASE : TAIL = FIN + 1":GOSUB 900
170 IF D<>0 THEN L$="  ECART "+STR$ D+" OCTETS":GOSUB 900
180 NEXT K
200 L$="NOUVELLE SERIE : POKE &BFBDF,0":GOSUB 900
210 CLOSE :PRINT "FIN -- VOIR F:TS1TRES.BAS"
220 END 
900 REM --- ECRIT A L ECRAN ET DANS LE FICHIER
910 PRINT L$:PRINT #1, L$:RETURN 
