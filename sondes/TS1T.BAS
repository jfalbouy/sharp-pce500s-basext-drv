10 REM TS1T : S1_TAIL (BFC1B) FACE A LA VRAIE FIN DE CHAINE -- RELECTURE SEULE
20 REM LES INSTANTANES SE PRENNENT PAR CALL &BF800 EN MODE DIRECT, JAMAIS ICI :
30 REM CE PROGRAMME FAIT GRANDIR DATA.BAS, DONC CORRIGE S1_TAIL EN S EXECUTANT
40 CLEAR :WAIT 150
50 IF PEEK &BFBDF<>&A6 THEN PRINT "AUCUN INSTANTANE DE TS1T":END
60 N=PEEK &BFBE0:PRINT "INSTANTANES : ";N
70 IF N=0 THEN END
80 FOR K=0 TO N-1:P=&BFB80+9*K
90 F=PEEK P+PEEK (P+1)*256+PEEK (P+2)*65536
100 T=PEEK (P+3)+PEEK (P+4)*256+PEEK (P+5)*65536
110 B=PEEK (P+6)+PEEK (P+7)*256+PEEK (P+8)*65536
120 PRINT K+1;" FIN ";HEX$ F;" TAIL ";HEX$ T;" BTM ";HEX$ B
130 D=T-F-1
140 IF D=0 THEN PRINT "  EN PHASE : TAIL = FIN + 1"
150 IF D<>0 THEN PRINT "  ECART ";D;" OCTETS"
160 NEXT K
170 PRINT "NOUVELLE SERIE : POKE &BFBDF,0"
