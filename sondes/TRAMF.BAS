10 REM TRAMF : RAMFILE NAIT-IL SOUS LES PILOTES ? LEURRE EN TETE DE S1:
20 REM RUN, PUIS CALL &BF000 EN MODE DIRECT, RUN, INIT E:2K EN MODE DIRECT, RUN
30 REM LE LEURRE EST UN BLOC D ATTRIBUT 25 RELIE A RIEN : S IL MONTE, RIEN NE CASSE
40 CLEAR :WAIT 150
50 S=PEEK &BFBDF:E=PEEK &BFBE0:R=PEEK &BFBE1
60 G=PEEK &BFBE2+PEEK &BFBE3*256+PEEK &BFBE4*65536
70 IF S=&A5 THEN PRINT "SONDE : ETAPE ";E;" ERR ";HEX$ R;" LEURRE ";HEX$ G
80 IF S<>&A5 THEN PRINT "SONDE PAS ENCORE APPELEE (ID ";HEX$ S;")"
90 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
100 X=T+PEEK (T+18)+PEEK (T+19)*256+PEEK (T+20)*65536
110 PL=0:PR=0:PP=0:K=0:XE=0
120 IF PEEK X<>&FB THEN 210
130 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
140 A=PEEK (X+12):L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536
150 K=K+1:PRINT K;" ";HEX$ X;" ";N$;" ";HEX$ A;" ";L
160 D=INT (A/4)-INT (A/16)*4:REM BITS 0CH DE L ATTRIBUT : PILOTE
170 IF N$="LEURRE  SYS" THEN PL=K:D=0
180 IF LEFT$ (N$,7)="RAMFILE" THEN PR=K
190 IF D>0 AND PP=0 THEN PP=K
195 IF N$="EXTSLOT SYS" THEN XE=X
200 IF L>0 THEN X=X+L:GOTO 120
210 PRINT "FIN ";HEX$ X
220 IF XE>0 THEN GOSUB 400
230 IF PL=0 THEN PRINT "PAS DE LEURRE DANS S1:":END
240 IF PR=0 THEN PRINT "PAS DE RAMFILE DANS S1:":END
250 IF PR<PL THEN PRINT "RAMFILE AU RANG ";PR;" SOUS LE LEURRE (RANG ";PL;")"
260 IF PR>PL THEN PRINT "RAMFILE AU RANG ";PR;" AU-DESSUS DU LEURRE (RANG ";PL;")"
270 IF PP>0 THEN PRINT "PILOTE REEL AU RANG ";PP
280 IF PP>0 AND PR>PP THEN PRINT "RAMFILE AU-DESSUS DU PILOTE REEL"
290 IF PP>0 AND PR<PP THEN PRINT "RAMFILE SOUS LE PILOTE REEL : DANGER"
300 END
400 REM EXTSLOT : DE QUOI LE DELIER AVANT SON KILL (SON EN-TETE IOCS EST EN +22H)
410 H=PEEK &BFCA2+PEEK &BFCA3*256+PEEK &BFCA4*65536
420 PRINT "D_LINK ";HEX$ H;" EXTSLOT+22H ";HEX$ (XE+34)
430 IF H<>XE+34 THEN PRINT "EXTSLOT PAS EN TETE DE D_LINK : NE PAS LE RETIRER":RETURN
440 PRINT "DELIER : POKE &BFCA2,&";HEX$ PEEK (XE+34);",&";HEX$ PEEK (XE+35);",&";HEX$ PEEK (XE+36)
450 RETURN
