10 REM TRAMF : RAMFILE NAIT-IL SOUS LES PILOTES ? LEURRE EN TETE DE S1:
20 REM RUN, PUIS CALL &BF000 EN MODE DIRECT, RUN, INIT E:2K EN MODE DIRECT, RUN
30 REM ECRIT A L ECRAN ET DANS F:TRAMFx.BAS, x = ETAT RELEVE : UN FICHIER PAR ETAT
40 REM A SONDE NON APPELEE, L LEURRE, R LEURRE+RAMFILE, X LEURRE+EXTSLOT, Y X+RAMFILE
50 CLEAR 
60 S=PEEK &BFBDF:E=PEEK &BFBE0:R=PEEK &BFBE1
70 G=PEEK &BFBE2+PEEK &BFBE3*256+PEEK &BFBE4*65536
80 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
90 X0=T+PEEK (T+18)+PEEK (T+19)*256+PEEK (T+20)*65536
100 REM 1ER PASSAGE, SANS RIEN ECRIRE : QUEL ETAT ?
110 PL=0:PR=0:PP=0:K=0:XE=0:X=X0
120 IF PEEK X<>&FB THEN 190
130 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
140 A=PEEK (X+12):L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536:K=K+1
150 D=INT (A/4)-INT (A/16)*4:REM BITS 0CH DE L ATTRIBUT : PILOTE
160 IF N$="LEURRE  SYS" THEN PL=K:D=0
170 IF LEFT$ (N$,7)="RAMFILE" THEN PR=K
175 IF N$="EXTSLOT SYS" THEN XE=X
180 IF D>0 AND PP=0 THEN PP=K
185 IF L>0 THEN X=X+L:GOTO 120
190 C$="A":IF PL>0 THEN C$="L":IF PR>0 THEN C$="R"
200 IF XE>0 THEN C$="X":IF PR>0 THEN C$="Y"
210 F$="F:TRAMF"+C$+".BAS"
220 CLS :OPEN F$ FOR OUTPUT AS #1
230 L$="TRAMF ETAT "+C$+" -> "+F$:GOSUB 900
240 IF S=&A5 THEN L$="SONDE : ETAPE "+STR$ E+" ERR "+HEX$ R+" LEURRE "+HEX$ G:GOSUB 900
250 IF S<>&A5 THEN L$="SONDE PAS ENCORE APPELEE (ID "+HEX$ S+")":GOSUB 900
260 REM 2E PASSAGE : LA CHAINE, ECRITE -- RANG ADRESSE NOM ATTRIBUT TAILLE
270 X=X0:K=0
280 IF PEEK X<>&FB THEN 330
290 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
300 A=PEEK (X+12):L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536:K=K+1
310 L$=STR$ K+" "+HEX$ X+" "+N$+" "+HEX$ A+" "+STR$ L:GOSUB 900
320 IF L>0 THEN X=X+L:GOTO 280
330 L$="FIN "+HEX$ X+" S1BTM "+HEX$ (PEEK &BFCDE+PEEK &BFCDF*256+PEEK &BFCE0*65536):GOSUB 900
340 IF XE>0 THEN GOSUB 700
350 IF PL=0 THEN L$="PAS DE LEURRE DANS S1:":GOSUB 900:GOTO 450
360 IF PR=0 THEN L$="PAS DE RAMFILE DANS S1:":GOSUB 900:GOTO 450
370 IF PR<PL THEN L$="RAMFILE AU RANG "+STR$ PR+" SOUS LE LEURRE (RANG "+STR$ PL+")":GOSUB 900
380 IF PR>PL THEN L$="RAMFILE AU RANG "+STR$ PR+" AU-DESSUS DU LEURRE (RANG "+STR$ PL+")":GOSUB 900
390 IF PP>0 THEN L$="PILOTE REEL AU RANG "+STR$ PP:GOSUB 900
400 IF PP>0 AND PR>PP THEN L$="RAMFILE AU-DESSUS DU PILOTE REEL":GOSUB 900
410 IF PP>0 AND PR<PP THEN L$="RAMFILE SOUS LE PILOTE REEL : DANGER":GOSUB 900
450 CLOSE :PRINT "FIN -- VOIR ";F$
460 END 
700 REM EXTSLOT : DE QUOI LE DELIER AVANT SON KILL (SON EN-TETE IOCS EST EN +22H)
710 H=PEEK &BFCA2+PEEK &BFCA3*256+PEEK &BFCA4*65536
720 L$="D_LINK "+HEX$ H+" EXTSLOT+22H "+HEX$ (XE+34):GOSUB 900
730 IF H<>XE+34 THEN L$="EXTSLOT PAS EN TETE DE D_LINK : NE PAS LE RETIRER":GOSUB 900:RETURN 
740 L$="DELIER : POKE &BFCA2,&"+HEX$ PEEK (XE+34)+",&"+HEX$ PEEK (XE+35)+",&"+HEX$ PEEK (XE+36):GOSUB 900
750 RETURN 
900 REM --- ECRIT A L ECRAN ET DANS LE FICHIER
910 PRINT L$:PRINT #1, L$:RETURN 
