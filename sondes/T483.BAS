10 REM T483 : 47H PUIS 48H SEULS -- QUELLE TAILLE A LE BLOC CREE ?
20 REM RUN AVANT, CALL &BF000 EN MODE DIRECT, PUIS RUN
30 CLEAR :WAIT 150
40 S=PEEK &BFBDF:E=PEEK &BFBE0
50 IF S<>&83 THEN PRINT "T483 PAS ENCORE APPELEE (ID ";HEX$ S;")":GOTO 200
60 R=PEEK &BFBE1
70 A8=PEEK &BFBE2+PEEK &BFBE3*256+PEEK &BFBE4*65536
80 A1=PEEK &BFBE5+PEEK &BFBE6*256+PEEK &BFBE7*65536
90 TL=PEEK &BFBE8+PEEK &BFBE9*256+PEEK &BFBEA*65536
100 POKE &BFBDF,0:POKE &BFBE0,0
110 PRINT "ETAPE ";E;" ERR ";HEX$ R
120 IF E=1 THEN PRINT "47H A REFUSE":GOTO 200
130 IF E=2 THEN PRINT "48H A REFUSE":GOTO 200
140 IF E=3 THEN PRINT "41H N A PAS RETROUVE LE BLOC":GOTO 200
150 PRINT "48H REND ";HEX$ A8;" 41H ";HEX$ A1
160 PRINT "TAILLE DU BLOC : ";TL;" (";HEX$ TL;")"
170 IF TL=34 THEN PRINT "-> 48H CREE UN BLOC VIDE"
180 IF TL=2873 THEN PRINT "-> 48H PREND BIEN Y COMME TAILLE"
200 REM --- LA CHAINE DES BLOCS
210 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
220 X=T+PEEK (T+18)+PEEK (T+19)*256+PEEK (T+20)*65536
230 IF PEEK X<>&FB THEN 280
240 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
250 L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536
260 PRINT HEX$ X;" ";N$;" ";HEX$ PEEK (X+12);" ";L
270 IF L>0 THEN X=X+L:GOTO 230
280 PRINT "TXT ";HEX$ (PEEK &CB+PEEK &CC*256+PEEK &CD*65536);" DAT ";HEX$ (PEEK &CE+PEEK &CF*256+PEEK &D0*65536)
290 PRINT "OTER : SET ""S1:T48.SYS"","" "" PUIS KILL"
