260 POKE &BFFE0,&48,&41,&EE,&30,&A0,&00,&90,&24,&48,&41,&30,&7B,&00,&30,&E8,&25
270 POKE &BFFF0,&00,&7C,&01,&1B,&17,&7C,&04,&13,&43,&7A,&00,&FE,&0B,&FF,&9F,&07
