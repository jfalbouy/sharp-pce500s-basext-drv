10 REM T482 : 47H CONDENSE -> 48H CRE_TOP -> 42H RESIZE, PUIS LINKBAS
20 REM LANCER UNE FOIS AVANT, PUIS CALL &BF000 EN MODE DIRECT, PUIS RELANCER
30 REM LE CALL SE FAIT EN MODE DIRECT : LE COMPACTAGE DEPLACE TEXT.BAS
40 CLEAR :WAIT 150
50 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
60 X=T+PEEK (T+18)+PEEK (T+19)*256+PEEK (T+20)*65536
70 IF PEEK X<>&FB THEN 120
80 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
90 L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536
100 PRINT HEX$ X;" ";N$;" ";HEX$ PEEK (X+12);" ";L
110 IF L>0 THEN X=X+L:GOTO 70
120 PRINT "FIN ";HEX$ X;" S1BTM ";HEX$ (PEEK &BFCDE+PEEK &BFCDF*256+PEEK &BFCE0*65536)
130 PRINT "TXT ";HEX$ (PEEK &CB+PEEK &CC*256+PEEK &CD*65536);" DAT ";HEX$ (PEEK &CE+PEEK &CF*256+PEEK &D0*65536)
140 W=PEEK &E6+PEEK &E7*256+PEEK &E8*65536
150 PRINT "IOCSW ";HEX$ W;" +3A=";HEX$ PEEK (W+&3A)
160 S$="":FOR I=0 TO 2:S$=S$+CHR$ PEEK (&BFBEB+I):NEXT I
170 IF S$<>"T42" THEN PRINT "SONDE PAS ENCORE APPELEE":END
180 E=PEEK &BFBE0:R=PEEK &BFBE1
190 A8=PEEK &BFBE2+PEEK &BFBE3*256+PEEK &BFBE4*65536
200 A2=PEEK &BFBE5+PEEK &BFBE6*256+PEEK &BFBE7*65536
210 Y2=PEEK &BFBE8+PEEK &BFBE9*256+PEEK &BFBEA*65536
220 FOR I=0 TO 2:POKE &BFBEB+I,0:NEXT I
230 PRINT "ETAPE ";E;" ERR ";HEX$ R
240 IF E=1 THEN PRINT "47H CONDENSE A REFUSE":END
250 IF E=2 THEN PRINT "48H A REFUSE APRES CONDENSE":END
260 PRINT "48H A CREE EN ";HEX$ A8
270 IF E=5 AND A2=&FFFFF THEN PRINT "42H A REFUSE (0 ET 1), POSSIBLE ";Y2:END
280 IF E=3 THEN PRINT "42H OK AVEC POINTEUR 0, Y=";Y2
290 IF E=5 THEN PRINT "42H OK AVEC POINTEUR 1, Y=";Y2
300 IF E=4 THEN PRINT "41H N A PAS RETROUVE LE BLOC":END
310 PRINT "BLOC APRES 42H : ";HEX$ A2
320 PRINT "OTER : SET ""S1:T48.SYS"","" "" PUIS KILL"
