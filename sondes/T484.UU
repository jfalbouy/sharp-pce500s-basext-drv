180 IF A$="E:    " OR A$="F:    " THEN 220
190 INPUT "DRIVE(E/F) =";A$
200 IF RIGHT$ (A$,1)<>":" THEN A$=A$+":"
210 A$=LEFT$ (A$+"     ",6)
220 A$=A$+FNAME$+CHR$ (0)
