000000                   	; ============================================================================
000000                   	; T48 -- SONDE : la commande IOCS 48h cree-t-elle vraiment un bloc EN TETE ?
000000                   	; ============================================================================
000000                   	; Referentiel PC-E500S SC62015, 03 §7bis : nos installateurs (BASEXT-DRV,
000000                   	; HISTDRV) compactent par 47h puis inserent le bloc A LA MAIN -- decalage des
000000                   	; blocs suivants, recalage de (txtbas)/(datbas), remise a zero du drapeau
000000                   	; [(iocsw)+3Ah]. Or le device 6 porte une commande 48h, block_create_top,
000000                   	; « creation d'un bloc memoire EN TETE des blocs, propre au PC-E500 ».
000000                   	;
000000                   	; CE QUE LA ROM EN DIT (rom83, lu le 2026-09-25, NON eprouve) :
000000                   	;   0F034Bh est le traitement de 48h. Il fait, dans cet ordre :
000000                   	;     - controle de place (SUB_F0244, SUB_F02AF) puis Y = Y - 22h ;
000000                   	;     - refus si le nom existe deja (SUB_F0063 = 41h search_phys) ;
000000                   	;     - call SUB_F0330 : lit [(iocsw)+03Ah] et EFFACE le bit du lecteur
000000                   	;       (bit 1 pour S1:, bit 2 pour S2:) -- c'est l'octet que bd_linkbas de
000000                   	;       BASEXT-DRV remet a zero ;
000000                   	;     - mv (si),y puis callf 0F01C1h (43h block_transfer) : il DEPLACE la
000000                   	;       memoire, donc il fait lui-meme le decalage ;
000000                   	;     - copie d'un gabarit d'en-tete de 22h octets (DB_F041C) dans le bloc.
000000                   	;   La commande 45h (0F039Eh) est la meme routine SANS le deplacement.
000000                   	;
000000                   	; CE QUE CETTE SONDE MESURE, et elle ne fait que cela : appeler 48h une fois,
000000                   	; sans compactage prealable, et rendre ce que la machine repond. Le programme
000000                   	; T48.BAS releve la chaine des blocs, (txtbas), (datbas) et le drapeau AVANT
000000                   	; et APRES, puis affiche le resultat.
000000                   	;
000000                   	; Assemblage :
000000                   	;   xasm2026-4 T48.ASM -OT48.OBJ -L -S -B -K
000000                   	; Emploi :
000000                   	;   POKE &BFE03,&1A,&FD,&B,0,&C,0 : CALL &FFFD8   ' reserver 3072 octets
000000                   	;   LOAD M "X:T48.OBJ"                            ' ou F:
000000                   	;   RUN "T48.BAS"                                 ' qui fait CALL &BF000
000000                   	;
000000                   	; La zone de resultat est HORS du code, en 0BFBF0h, comme les essais de BASEXT :
000000                   	;   0BFBF0h  3 octets  adresse du bloc cree (Y rendu), 0FFFFFh si refus
000000                   	;   0BFBF3h  1 octet   code d'erreur rendu dans A, 0 si succes
000000                   	;   0BFBF4h  1 octet   1 si la retenue etait armee au retour, 0 sinon
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	cl:     equ 0D6H ; registre CL / CX bas
000000                   	iocs_call:        equ 0FFFE8H ; IOCS call entry
000000                   	d6_blk_cre_top:   equ 48H   ; memcard_block_create_top - creation d'un bloc memoire EN TETE des blocs, propre au PC-E500 ((ch) = slot, X
000000                   	
000000                   	res_adr:        equ     0BFBF0H         ; hors du module, dans la zone reservee
000000                   	res_err:        equ     0BFBF3H
000000                   	res_carry:      equ     0BFBF4H
000000                   	
000000                   	taille:         equ     000100H         ; 256 octets demandes, en-tete comprise
000000                   	
0BF000                   	        org     0BF000H
0BF000                   	        pre_on
0BF000                   	
0BF000                   	start:
0BF000 0D FF FF 0F       	        mv      y,0FFFFFH               ; zone de resultat en etat « rien »
0BF004 AD F0 FB 0B       	        mv      [res_adr],y
0BF008 08 00             	        mv      a,000H
0BF00A A8 F3 FB 0B       	        mv      [res_err],a
0BF00E A8 F4 FB 0B       	        mv      [res_carry],a
0BF012                   	
0BF012 30 CD D6 06 00    	        mvw     (cl),00006H             ; (cl) = 6 device carte memoire, (ch) = 0 slot S1:
0BF017 0C 39 F0 0B       	        mv      x,nom                   ; X = nom du bloc, 11 caracteres
0BF01B 0D 00 01 00       	        mv      y,taille                ; Y = taille voulue
0BF01F 09 48             	        mv      il,d6_blk_cre_top       ; 48h
0BF021 05 E8 FF 0F       	        callf   iocs_call
0BF025 1C 06             	        jrc     echec
0BF027                   	
0BF027 AD F0 FB 0B       	        mv      [res_adr],y             ; Y = adresse du bloc cree
0BF02B 9F                	        rc                              ; retour propre a BASIC
0BF02C 07                	        retf
0BF02D                   	
0BF02D                   	echec:
0BF02D A8 F3 FB 0B       	        mv      [res_err],a             ; code d'erreur du device
0BF031 08 01             	        mv      a,001H
0BF033 A8 F4 FB 0B       	        mv      [res_carry],a
0BF037 9F                	        rc                              ; la sonde rend TOUJOURS la main proprement
0BF038 07                	        retf
0BF039                   	
0BF039                   	; Le nom occupe 11 octets, 8 + 3, complete par des espaces -- le format des
0BF039                   	; en-tetes de bloc (DRVTEST.BAS lit 11 caracteres en +1).
0BF039 54 34 38 20 20 20 	nom:    db      'T48     SYS'
0BF03F 20 20 53 59 53    	
0BF044                   	
0BF044                   	btm:
0BF044                   	        assert  btm-start < 0100H       ; la sonde reste loin de res_adr
0BF044                   	        end

