000000                   	; ============================================================================
000000                   	; TS1T -- s1_tail (0BFC1Bh) SUIT-IL LA VRAIE FIN DE CHAINE ?  UN INSTANTANE
000000                   	; ============================================================================
000000                   	; s1_tail est la fin de la chaine des blocs de S1: + 1. La ROM la tient a jour
000000                   	; dans SUB_F029D, que seules appellent les commandes du device 6 qui changent la
000000                   	; chaine (42h, 45h, 46h, 47h, 48h). Elle la compare a s1_btm en 0E0571h,
000000                   	; vraisemblablement pour qu'une reservation ne morde pas sur la chaine.
000000                   	;
000000                   	; Nos installateurs (et PLINKC, et EXTSLOT) compactent par 47h -- qui la met a
000000                   	; jour -- puis MONTENT les blocs a la main, de la taille du pilote, sans la
000000                   	; toucher. Question : juste apres, s1_tail est-elle en retard de cette taille ?
000000                   	; Et qui la rattrape ?
000000                   	;
000000                   	; ⛔ LE PIEGE DE LA MESURE (2026-09-26) : lancer un programme BASIC fait grandir
000000                   	;    DATA.BAS par 42h, donc appelle SUB_F029D, donc CORRIGE s1_tail. Un releve en
000000                   	;    BASIC effacerait ce qu'il cherche. D'ou cette sonde : un CALL en mode direct
000000                   	;    ne cree aucune variable, et l'instantane fige FIN, s1_tail et s1_btm AU MEME
000000                   	;    INSTANT. TS1T.BAS ne fait que relire les instantanes, plus tard.
000000                   	;
000000                   	; Chaque appel ajoute un instantane (4 au plus). La serie repart de zero des que
000000                   	; l'identifiant n'est plus le sien (autre sonde, ou POKE &BFBDF,0).
000000                   	;
000000                   	; Zone de resultat (signee, voir T484) :
000000                   	;   0BFBDFh  1 octet   IDENTIFIANT 0A6H
000000                   	;   0BFBE0h  1 octet   nombre d'instantanes (0..4)
000000                   	;   0BFB80h  4 x 9     par instantane : FIN (1er octet hors chaine, 3 o),
000000                   	;                      [s1_tail] (3 o), [s1_btm] (3 o). En phase : s1_tail = FIN + 1
000000                   	;
000000                   	; Chargee en 0BF800h : BASEXTDR occupe 0BE400h-0BF5B7h dans la meme reservation
000000                   	; de 6144 octets, et les deux doivent etre en memoire avant l'installation.
000000                   	;
000000                   	; Assemblage : xasm2026-4 TS1T.ASM -OTS1T.OBJ -L -S -B -K
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	s1_top:           equ 0BFC15H ; top of S1 (nom et libelle de REGISTER.ASM) ; lead address du slot 0 = lecteur S1:, 080000h sur PC-E500S (3 octets ; manuel technique, Parameter of memory block device)
000000                   	s1_tail:          equ 0BFC1BH ; fin de la chaine des blocs de S1: + 1 (3 octets) : ecrite par SUB_F029D (commandes 42h/45h/46h/47h/48h du device 6), comparee a s1_btm par la reservation (0E0571h) ; nom de E. Kako (EXTSLOT, 1991). Un installateur ...
000000                   	s1_btm:           equ 0BFCDEH ; bottom of S1 (nom et libelle de REGISTER.ASM) ; le manuel dit "last address of slot 0 (S1:) + 1" et La Feuille du Sharp en fait le pointeur de la 1re zone de travail, la pile utilisateur U : trois lectures d'une me ...
000000                   	
000000                   	res_id:         equ     0BFBDFH         ; 0A6H = « c'est TS1T qui a ecrit »
000000                   	res_n:          equ     0BFBE0H
000000                   	res_tab:        equ     0BFB80H
000000                   	
0BF800                   	        org     0BF800H
0BF800                   	        pre_on
0BF800                   	
0BF800                   	start:
0BF800 88 DF FB 0B       	        mv      a,[res_id]
0BF804 60 A6             	        cmp     a,0A6H
0BF806 18 0C             	        jrz     suite
0BF808 08 A6             	        mv      a,0A6H                  ; nouvelle serie
0BF80A A8 DF FB 0B       	        mv      [res_id],a
0BF80E 08 00             	        mv      a,000H
0BF810 A8 E0 FB 0B       	        mv      [res_n],a
0BF814                   	suite:
0BF814 88 E0 FB 0B       	        mv      a,[res_n]
0BF818 60 04             	        cmp     a,004H
0BF81A 1E 46             	        jrnc    plein                   ; quatre instantanes : on n'ecrase rien
0BF81C                   	
0BF81C 0D 80 FB 0B       	        mv      y,res_tab               ; Y = res_tab + 9 * n
0BF820 09 09             	        mv      il,009H
0BF822 60 00             	rang:   cmp     a,000H
0BF824 18 06             	        jrz     rang_ok
0BF826 45 51             	        add     y,il
0BF828 48 01             	        sub     a,001H
0BF82A 13 0A             	        jr      rang
0BF82C                   	rang_ok:
0BF82C 2D                	        pushu   y                       ; destination de l'instantane
0BF82D                   	
0BF82D                   	; --- la vraie fin de chaine : meme parcours que SUB_F0278, SANS y ecrire ----
0BF82D 8D 15 FC 0B       	        mv      y,[s1_top]
0BF831 94 85 12          	        mv      x,[y+012H]
0BF834 45 54             	        add     y,x
0BF836 90 05             	parc:   mv      a,[y]
0BF838 60 FB             	        cmp     a,0FBH
0BF83A 1A 0D             	        jrnz    fin
0BF83C 94 85 11          	        mv      x,[y+011H]              ; taille du bloc
0BF83F 6C 04             	        inc     x
0BF841 7C 04             	        dec     x
0BF843 18 04             	        jrz     fin                     ; taille nulle : chaine abimee, on s'arrete
0BF845 45 54             	        add     y,x
0BF847 1F 13             	        jrnc    parc
0BF849                   	fin:
0BF849 3C                	        popu    x
0BF84A B5 24             	        mv      [x++],y                 ; FIN
0BF84C 8D 1B FC 0B       	        mv      y,[s1_tail]
0BF850 B5 24             	        mv      [x++],y                 ; s1_tail
0BF852 8D DE FC 0B       	        mv      y,[s1_btm]
0BF856 B5 24             	        mv      [x++],y                 ; s1_btm
0BF858                   	
0BF858 88 E0 FB 0B       	        mv      a,[res_n]
0BF85C 40 01             	        add     a,001H
0BF85E A8 E0 FB 0B       	        mv      [res_n],a
0BF862                   	plein:
0BF862 9F                	        rc                              ; retour propre a BASIC
0BF863 07                	        retf
0BF864                   	
0BF864                   	btm:
0BF864                   	        assert  res_tab+4*9 <= res_id   ; les instantanes n'atteignent pas l'identifiant
0BF864                   	        assert  btm < res_tab           ; la sonde reste sous sa zone de resultat
0BF864                   	        end

