000000                   	; ============================================================================
000000                   	; T483 -- 47h PUIS 48h SEULS : QUELLE TAILLE A LE BLOC CREE ?
000000                   	; ============================================================================
000000                   	; T482 a mesure (2026-09-25) que la suite 47h -> 48h -> 42h passe entierement
000000                   	; et donne un bloc de 2873 octets = 2839 + 22h. Mais elle enchainait les deux
000000                   	; commandes : impossible de dire LAQUELLE a donne sa taille au bloc.
000000                   	;
000000                   	;   - le carnet dit de 48h « (ch) = slot, X = nom, Y = taille » ;
000000                   	;   - la lecture de la ROM dit le contraire : en 0F0351h, « call SUB_F0244 »
000000                   	;     ECRASE Y par l'espace libre, la chaine n'est decalee que de 22h octets
000000                   	;     (0F0394h : « mv a,022h / add y,a ») et le gabarit copie (DB_F041C) porte
000000                   	;     une taille de 22h. 48h creerait donc un bloc VIDE.
000000                   	;
000000                   	; Cette sonde s'arrete apres 48h et LIT LA TAILLE DU BLOC dans son en-tete
000000                   	; (champ +11h, comme BLOCS.BAS). Une minute de machine pour trancher.
000000                   	;
000000                   	;   taille lue = 22h (34)    -> 48h cree un bloc vide, le carnet est a corriger
000000                   	;   taille lue = 0B39h (2873) -> 48h prend bien Y, ma lecture de la ROM est fausse
000000                   	;   autre valeur              -> a ecrire telle quelle, et a comprendre
000000                   	;
000000                   	; ⚠️ MEME PRECAUTION QUE T482 : le compactage deplace TEXT.BAS et DATA.BAS, et
000000                   	;    la ROM ne recale rien -- d'ou linkbas derriere chaque commande qui deplace,
000000                   	;    erreurs comprises. Et l'appel se fait EN MODE DIRECT.
000000                   	;
000000                   	; ⛔ PLUS DE SIGNATURE. T482 a montre qu'elle n'arrivait pas a destination, sans
000000                   	;    qu'on sache pourquoi, alors que les valeurs qui la precedent y etaient.
000000                   	;    L'octet d'ETAPE fait le meme travail avec une variable de moins : 0 = sonde
000000                   	;    pas appelee, 1..5 = appelee. Le programme BASIC le remet a zero apres l'avoir
000000                   	;    lu, de sorte que ce qu'il affiche vient toujours du dernier appel.
000000                   	;
000000                   	; Zone de resultat :
000000                   	;   0BFBE0h  1 octet   etape : 1=47h 2=48h 3=41h 5=fini
000000                   	;   0BFBE1h  1 octet   code d'erreur rendu dans A
000000                   	;   0BFBE2h  3 octets  Y rendu par 48h
000000                   	;   0BFBE5h  3 octets  adresse relue par 41h
000000                   	;   0BFBE8h  3 octets  TAILLE du bloc, lue dans son en-tete (+11h)
000000                   	;
000000                   	; Assemblage : xasm2026-4 T483.ASM -OT483.OBJ -L -S -B -K
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	txtbas: equ 0CBH ; TEXT.BAS courant
000000                   	datbas: equ 0CEH ; DATA.BAS courant
000000                   	cl:     equ 0D6H ; registre CL / CX bas
000000                   	ch:     equ 0D7H ; registre CH / CX haut
000000                   	iocsw:  equ 0E6H ; zone de travail IOCS : recopie du pointeur [0BFD17h] (3 octets) (manuel technique, IOCS Special Technique p85-86)
000000                   	baswrk:           equ 0BFD0EH ; POINTEUR (3 octets) vers la zone de travail du BASIC, en memoire EXTERNE : il CONTIENT l'adresse, il N'EST PAS la zone. La ROM le recopie dans basptr par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Nom de E. Kako (register.ls ...
000000                   	iocs_call:        equ 0FFFE8H ; IOCS call entry
000000                   	d6_search_phys:   equ 41H   ; memcard_search_phys - adresse physique d'un bloc d'apres son nom ((ch) = slot 0/1/2, X = nom du bloc ;
000000                   	d6_condense:      equ 47H   ; memcard_condense - compactage de l'espace libre des blocs memoire ((ch) = slot)
000000                   	d6_blk_cre_top:   equ 48H   ; memcard_block_create_top - creation d'un bloc memoire EN TETE des blocs, propre au PC-E500 ((ch) = slot, X
000000                   	
000000                   	res_etape:      equ     0BFBE0H
000000                   	res_err:        equ     0BFBE1H
000000                   	res_adr48:      equ     0BFBE2H
000000                   	res_adr41:      equ     0BFBE5H
000000                   	res_taille:     equ     0BFBE8H
000000                   	
000000                   	demande:        equ     000B17H         ; 2839 octets, comme T482
000000                   	
0BF000                   	        org     0BF000H
0BF000                   	        pre_on
0BF000                   	
0BF000                   	start:
0BF000 08 00             	        mv      a,000H
0BF002 A8 E0 FB 0B       	        mv      [res_etape],a
0BF006 A8 E1 FB 0B       	        mv      [res_err],a
0BF00A 0D FF FF 0F       	        mv      y,0FFFFFH
0BF00E AD E2 FB 0B       	        mv      [res_adr48],y
0BF012 AD E5 FB 0B       	        mv      [res_adr41],y
0BF016 AD E8 FB 0B       	        mv      [res_taille],y
0BF01A                   	
0BF01A                   	; --- etape 1 : 47h condense -------------------------------------------------
0BF01A 08 01             	        mv      a,001H
0BF01C A8 E0 FB 0B       	        mv      [res_etape],a
0BF020 30 CD D6 06 00    	        mvw     (cl),00006H
0BF025 09 47             	        mv      il,d6_condense
0BF027 05 E8 FF 0F       	        callf   iocs_call
0BF02B 1C 52             	        jrc     echec
0BF02D 04 88 F0          	        call    linkbas
0BF030                   	
0BF030                   	; --- etape 2 : 48h block_create_top, ET RIEN D'AUTRE ------------------------
0BF030 08 02             	        mv      a,002H
0BF032 A8 E0 FB 0B       	        mv      [res_etape],a
0BF036 30 CD D6 06 00    	        mvw     (cl),00006H
0BF03B 0C B8 F0 0B       	        mv      x,nom
0BF03F 0D 17 0B 00       	        mv      y,demande
0BF043 09 48             	        mv      il,d6_blk_cre_top
0BF045 05 E8 FF 0F       	        callf   iocs_call
0BF049 1C 34             	        jrc     echec
0BF04B AD E2 FB 0B       	        mv      [res_adr48],y
0BF04F 04 88 F0          	        call    linkbas
0BF052                   	
0BF052                   	; --- etape 3 : relire l'adresse, puis la TAILLE dans l'en-tete --------------
0BF052 08 03             	        mv      a,003H
0BF054 A8 E0 FB 0B       	        mv      [res_etape],a
0BF058 30 CD D6 06 00    	        mvw     (cl),00006H
0BF05D 0C B8 F0 0B       	        mv      x,nom
0BF061 09 41             	        mv      il,d6_search_phys
0BF063 05 E8 FF 0F       	        callf   iocs_call
0BF067 1C 16             	        jrc     echec
0BF069 AD E5 FB 0B       	        mv      [res_adr41],y
0BF06D                   	
0BF06D 08 11             	        mv      a,011H                  ; champ « taille du bloc » de l'en-tete
0BF06F 45 50             	        add     y,a
0BF071 95 05             	        mv      y,[y]                   ; les 3 octets de la taille
0BF073 AD E8 FB 0B       	        mv      [res_taille],y
0BF077                   	
0BF077 08 05             	        mv      a,005H                  ; sequence complete
0BF079 A8 E0 FB 0B       	        mv      [res_etape],a
0BF07D 12 07             	        jr      fini
0BF07F                   	
0BF07F                   	echec:
0BF07F A8 E1 FB 0B       	        mv      [res_err],a
0BF083 04 88 F0          	        call    linkbas
0BF086                   	
0BF086                   	fini:
0BF086 9F                	        rc
0BF087 07                	        retf
0BF088                   	
0BF088                   	; ---------------------------------------------------------------------------
0BF088                   	; linkbas -- repris de BASEXTDR.ASM (bd_linkbas). Appel proche.
0BF088                   	; ---------------------------------------------------------------------------
0BF088                   	linkbas:
0BF088 8C 0E FD 0B       	        mv      x,[baswrk]
0BF08C 08 72             	        mv      a,072H
0BF08E 45 40             	        add     x,a
0BF090 04 A9 F0          	        call    lb_chercher
0BF093 1C 13             	        jrc     lb_perdu
0BF095 30 A5 CB          	        mv      (txtbas),y
0BF098 04 A9 F0          	        call    lb_chercher
0BF09B 1C 0B             	        jrc     lb_perdu
0BF09D 30 A5 CE          	        mv      (datbas),y
0BF0A0 08 00             	        mv      a,000H
0BF0A2 30 B8 80 E6 3A    	        mv      [(iocsw)+03AH],a
0BF0A7 06                	        ret
0BF0A8                   	lb_perdu:
0BF0A8 FF                	        reset
0BF0A9                   	lb_chercher:
0BF0A9 30 E0 24 D7       	        mv      (ch),[x++]
0BF0AD 30 CC D6 06       	        mv      (cl),006H
0BF0B1 09 41             	        mv      il,041H
0BF0B3 05 E8 FF 0F       	        callf   iocs_call
0BF0B7 06                	        ret
0BF0B8                   	
0BF0B8 54 34 38 20 20 20 	nom:    db      'T48     SYS'
0BF0BE 20 20 53 59 53    	
0BF0C3                   	
0BF0C3                   	btm:
0BF0C3                   	        assert  btm-start < 0300H
0BF0C3                   	        end

