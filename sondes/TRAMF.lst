000000                   	; ============================================================================
000000                   	; TRAMF -- RAMFILE NAIT-IL SOUS LES PILOTES ?  POSE D'UN LEURRE EN TETE DE S1:
000000                   	; ============================================================================
000000                   	; Lu dans rom83 le 2026-09-27 (referentiel 03 §7bis, « EXTSLOT (1991) ») : le
000000                   	; pilote MEMORY FILE (E:/F:) cree son bloc RAMFILE par la commande IOCS 48h du
000000                   	; device 6 (0E4DBBh -> SUB_E4C4E), et 48h cree EN TETE du lecteur. Si c'est
000000                   	; vrai, INIT "E:" apres l'installation de PLINK/BASEXT/HISTORY glisse RAMFILE
000000                   	; SOUS eux, et ils montent sans relocation -- le plantage du KILL-sous.
000000                   	;
000000                   	; On ne le mesure PAS avec un vrai pilote : s'il bougeait, la machine tomberait.
000000                   	; Cette sonde pose un LEURRE : un bloc « LEURRE  SYS » d'attribut 25h -- un
000000                   	; pilote aux yeux de PLINKC, d'EXTSLOT et de BASEXTDR (bits 0Ch) -- mais RELIE
000000                   	; A RIEN : ni maillon d_link, ni crochet du BASIC. Qu'il monte ou non, aucun
000000                   	; pointeur ne devient faux. INIT "E:2K" ensuite, et TRAMF.BAS dit qui est
000000                   	; dessous.
000000                   	;
000000                   	; Sequence, dans un seul CALL (le BASIC ne doit pas reprendre la main entre
000000                   	; deux commandes qui deplacent) :
000000                   	;   47h condense -> linkbas -> 48h « LEURRE  SYS » -> linkbas
000000                   	;   -> 41h relit son adresse -> attribut +0Ch <- 25h
000000                   	; 48h seul donne un bloc VIDE de 22h octets (T483) : c'est assez pour un leurre.
000000                   	;
000000                   	; ⚠️ Appel EN MODE DIRECT : le compactage deplace TEXT.BAS.
000000                   	;
000000                   	; Zone de resultat (signee, voir T484) :
000000                   	;   0BFBDFh  1 octet   IDENTIFIANT 0A5H, ecrit en PREMIER
000000                   	;   0BFBE0h  1 octet   etape : 1=47h 2=48h 4=41h 6=fini (leurre pose)
000000                   	;   0BFBE1h  1 octet   code d'erreur rendu dans A
000000                   	;   0BFBE2h  3 octets  adresse du leurre, relue par 41h
000000                   	;
000000                   	; Assemblage : xasm2026-4 TRAMF.ASM -OTRAMF.OBJ -L -S -B -K
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	txtbas: equ 0CBH ; TEXT.BAS courant
000000                   	datbas: equ 0CEH ; DATA.BAS courant
000000                   	cl:     equ 0D6H ; registre CL / CX bas
000000                   	ch:     equ 0D7H ; registre CH / CX haut
000000                   	iocsw:  equ 0E6H ; zone de travail IOCS : recopie du pointeur [0BFD17h] (3 octets) (manuel technique, IOCS Special Technique p85-86)
000000                   	baswrk:           equ 0BFD0EH ; POINTEUR (3 octets) vers la zone de travail du BASIC, en memoire EXTERNE : il CONTIENT l'adresse, il N'EST PAS la zone. La ROM le recopie dans basptr par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Nom de E. Kako (register.ls ...
000000                   	iocs_call:        equ 0FFFE8H ; IOCS call entry
000000                   	d6_search_phys:   equ 41H   ; memcard_search_phys - adresse physique d'un bloc d'apres son nom ((ch) = slot 0/1/2, X = nom du bloc ...
000000                   	d6_condense:      equ 47H   ; memcard_condense - compactage de l'espace libre des blocs memoire ((ch) = slot)
000000                   	d6_blk_cre_top:   equ 48H   ; memcard_block_create_top - cree un bloc VIDE de 22h octets EN TETE ; la taille passee dans Y est IGNOREE ...
000000                   	
000000                   	res_id:         equ     0BFBDFH         ; 0A5H = « c'est TRAMF qui a ecrit »
000000                   	res_etape:      equ     0BFBE0H
000000                   	res_err:        equ     0BFBE1H
000000                   	res_adr:        equ     0BFBE2H
000000                   	
0BF000                   	        org     0BF000H
0BF000                   	        pre_on
0BF000                   	
0BF000                   	start:
0BF000 08 A5             	        mv      a,0A5H                  ; l'identifiant AVANT tout
0BF002 A8 DF FB 0B       	        mv      [res_id],a
0BF006 08 00             	        mv      a,000H
0BF008 A8 E0 FB 0B       	        mv      [res_etape],a
0BF00C A8 E1 FB 0B       	        mv      [res_err],a
0BF010 0D FF FF 0F       	        mv      y,0FFFFFH
0BF014 AD E2 FB 0B       	        mv      [res_adr],y
0BF018                   	
0BF018                   	; --- etape 1 : 47h condense -------------------------------------------------
0BF018 08 01             	        mv      a,001H
0BF01A A8 E0 FB 0B       	        mv      [res_etape],a
0BF01E 30 CD D6 06 00    	        mvw     (cl),00006H             ; device 6, lecteur 0 (S1:)
0BF023 09 47             	        mv      il,d6_condense
0BF025 05 E8 FF 0F       	        callf   iocs_call
0BF029 1C 45             	        jrc     echec
0BF02B 04 79 F0          	        call    linkbas
0BF02E                   	
0BF02E                   	; --- etape 2 : 48h block_create_top : le leurre, vide, en tete --------------
0BF02E 08 02             	        mv      a,002H
0BF030 A8 E0 FB 0B       	        mv      [res_etape],a
0BF034 30 CD D6 06 00    	        mvw     (cl),00006H
0BF039 0C A9 F0 0B       	        mv      x,nom
0BF03D 09 48             	        mv      il,d6_blk_cre_top
0BF03F 05 E8 FF 0F       	        callf   iocs_call
0BF043 1C 2B             	        jrc     echec
0BF045 04 79 F0          	        call    linkbas                 ; la chaine a monte de 22h octets
0BF048                   	
0BF048                   	; --- etape 4 : 41h relit l'adresse, puis l'attribut de pilote ---------------
0BF048 08 04             	        mv      a,004H
0BF04A A8 E0 FB 0B       	        mv      [res_etape],a
0BF04E 30 CD D6 06 00    	        mvw     (cl),00006H
0BF053 0C A9 F0 0B       	        mv      x,nom
0BF057 09 41             	        mv      il,d6_search_phys
0BF059 05 E8 FF 0F       	        callf   iocs_call
0BF05D 1C 11             	        jrc     echec
0BF05F AD E2 FB 0B       	        mv      [res_adr],y
0BF063 08 25             	        mv      a,025H                  ; device + protege : bits 0Ch non nuls
0BF065 B0 85 0C          	        mv      [y+00CH],a
0BF068                   	
0BF068 08 06             	        mv      a,006H                  ; leurre pose
0BF06A A8 E0 FB 0B       	        mv      [res_etape],a
0BF06E 9F                	        rc
0BF06F 07                	        retf
0BF070                   	
0BF070                   	echec:
0BF070 A8 E1 FB 0B       	        mv      [res_err],a             ; le code AVANT tout autre usage de A
0BF074 04 79 F0          	        call    linkbas                 ; meme en erreur : PLINKC fait de meme
0BF077 9F                	        rc                              ; retour propre a BASIC
0BF078 07                	        retf
0BF079                   	
0BF079                   	; ---------------------------------------------------------------------------
0BF079                   	; linkbas -- (txtbas) et (datbas) retrouves par leur nom, puis drapeau a zero.
0BF079                   	;            Repris de BASEXTDR.ASM (bd_linkbas), comme T482. Appel proche.
0BF079                   	; ---------------------------------------------------------------------------
0BF079                   	linkbas:
0BF079 8C 0E FD 0B       	        mv      x,[baswrk]
0BF07D 08 72             	        mv      a,072H
0BF07F 45 40             	        add     x,a
0BF081 04 9A F0          	        call    lb_chercher
0BF084 1C 13             	        jrc     lb_perdu
0BF086 30 A5 CB          	        mv      (txtbas),y
0BF089 04 9A F0          	        call    lb_chercher
0BF08C 1C 0B             	        jrc     lb_perdu
0BF08E 30 A5 CE          	        mv      (datbas),y
0BF091 08 00             	        mv      a,000H
0BF093 30 B8 80 E6 3A    	        mv      [(iocsw)+03AH],a
0BF098 06                	        ret
0BF099                   	lb_perdu:
0BF099 FF                	        reset                           ; comme PLINKC : la memoire est incoherente
0BF09A                   	lb_chercher:
0BF09A 30 E0 24 D7       	        mv      (ch),[x++]              ; numero de lecteur, puis X sur le nom
0BF09E 30 CC D6 06       	        mv      (cl),006H
0BF0A2 09 41             	        mv      il,041H
0BF0A4 05 E8 FF 0F       	        callf   iocs_call
0BF0A8 06                	        ret
0BF0A9                   	
0BF0A9 4C 45 55 52 52 45 	nom:    db      'LEURRE  SYS'
0BF0AF 20 20 53 59 53    	
0BF0B4                   	
0BF0B4                   	btm:
0BF0B4                   	        assert  btm-start < 0300H       ; la sonde reste loin de la zone de resultat
0BF0B4                   	        end

