10 REM T48 : LA COMMANDE IOCS 48H CREE-T-ELLE UN BLOC EN TETE ?
20 REM LANCER UNE FOIS AVANT, PUIS CALL &BF000 EN MODE DIRECT, PUIS RELANCER
30 REM PEEK SEULEMENT : AUCUN MOT-CLE D'EXTENSION
40 CLEAR :WAIT 150
50 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
60 X=T+PEEK (T+18)+PEEK (T+19)*256+PEEK (T+20)*65536
70 IF PEEK X<>&FB THEN 120
80 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
90 L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536
100 PRINT HEX$ X;" ";N$;" ";HEX$ PEEK (X+12);" ";L
110 IF L>0 THEN X=X+L:GOTO 70
120 PRINT "FIN ";HEX$ X;" S1BTM ";HEX$ (PEEK &BFCDE+PEEK &BFCDF*256+PEEK &BFCE0*65536)
130 PRINT "TXT ";HEX$ (PEEK &CB+PEEK &CC*256+PEEK &CD*65536);" DAT ";HEX$ (PEEK &CE+PEEK &CF*256+PEEK &D0*65536)
140 W=PEEK &E6+PEEK &E7*256+PEEK &E8*65536
150 PRINT "IOCSW ";HEX$ W;" +3A=";HEX$ PEEK (W+&3A)
160 S$="":FOR I=0 TO 2:S$=S$+CHR$ PEEK (&BFBF5+I):NEXT I
170 IF S$<>"T48" THEN PRINT "SONDE PAS ENCORE APPELEE":END
180 A=PEEK &BFBF0+PEEK &BFBF1*256+PEEK &BFBF2*65536
190 FOR I=0 TO 2:POKE &BFBF5+I,0:NEXT I
200 IF A=&FFFFF THEN PRINT "REFUS : ERR ";HEX$ PEEK &BFBF3;" CY ";PEEK &BFBF4:END
210 PRINT "BLOC CREE EN ";HEX$ A
220 PRINT "OTER : SET ""S1:T48.SYS"","" "" PUIS KILL ""S1:T48.SYS"""
