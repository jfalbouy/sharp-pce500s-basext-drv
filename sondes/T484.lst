000000                   	; ============================================================================
000000                   	; T484 -- OU (txtbas) DECROCHE-T-IL ? LA TRACE DE linkbas, PAS A PAS
000000                   	; ============================================================================
000000                   	; T482 a laisse une anomalie que rien n'explique : apres la sequence complete,
000000                   	; (datbas) designait le bon bloc et (txtbas) l'ANCIEN -- TXT BD852 alors que
000000                   	; TEXT.BAS etait en 80CF5. Or linkbas ecrit les deux a la suite, et il a
000000                   	; forcement tourne : l'etape 6 vient apres lui, et une recherche en echec serait
000000                   	; partie sur « reset ».
000000                   	;
000000                   	; C'est le geste meme dont depend un installateur : tant qu'on ne sait pas
000000                   	; pourquoi, on ne touche pas au sien. Cette sonde refait la sequence de T482 en
000000                   	; ECRIVANT CE QU'ELLE VOIT, a chaque etape :
000000                   	;
000000                   	;   - (txtbas) et (datbas) a l'entree, avant toute commande ;
000000                   	;   - pour CHACUN des trois linkbas : la valeur rendue par la 1re recherche 41h,
000000                   	;     celle rendue par la 2e, puis (txtbas) et (datbas) une fois ecrits ;
000000                   	;   - (txtbas) et (datbas) a la sortie.
000000                   	;
000000                   	; Seize valeurs de 3 octets, dans l'ordre. Elles diront si la recherche rend une
000000                   	; adresse fausse, si l'ecriture n'a pas lieu, ou si quelque chose ecrase
000000                   	; (txtbas) APRES coup -- trois causes que T482 ne savait pas distinguer.
000000                   	;
000000                   	; ⚠️ Appel EN MODE DIRECT, comme T482 : le compactage deplace TEXT.BAS.
000000                   	;
000000                   	; ⛔ UN MARQUEUR DOIT DIRE QUI L'A ECRIT, PAS SEULEMENT QU'ON A ECRIT. Releve du
000000                   	;    2026-09-26 : T484.BAS lance AVANT le LOADM a affiche « ETAPE 5 ERR 0 » et
000000                   	;    des adresses de fantaisie -- c'etait l'etape 5 laissee par T483, qui partage
000000                   	;    la meme zone de resultat et n'avait pas pu l'effacer (il etait mort sur
000000                   	;    « Out of memory »). D'ou res_id : chaque sonde signe ses octets, et le
000000                   	;    programme BASIC refuse ceux d'une autre.
000000                   	;
000000                   	; Zone de resultat :
000000                   	;   0BFBDFh  1 octet   IDENTIFIANT 084H, ecrit en PREMIER : « ces octets sont de T484 »
000000                   	;   0BFBE0h  1 octet   etape : 1=47h 2=48h 3=42h(a=0)
000000                   	;                      5=42h(a=1) 4=41h 6=fini
000000                   	;   0BFBE1h  1 octet   code d'erreur rendu dans A
000000                   	;   0BFB7Dh  3 octets  pointeur d'ecriture de la trace (interne a la sonde)
000000                   	;   0BFB80h  48 octets LA TRACE : 16 valeurs de 3 octets, dans l'ordre ci-dessus
000000                   	;
000000                   	; Assemblage : xasm2026-4 T484.ASM -OT484.OBJ -L -S -B -K
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	txtbas: equ 0CBH ; TEXT.BAS courant
000000                   	datbas: equ 0CEH ; DATA.BAS courant
000000                   	cl:     equ 0D6H ; registre CL / CX bas
000000                   	ch:     equ 0D7H ; registre CH / CX haut
000000                   	iocsw:  equ 0E6H ; zone de travail IOCS : recopie du pointeur [0BFD17h] (3 octets) (manuel technique, IOCS Special Technique p85-86)
000000                   	baswrk:           equ 0BFD0EH ; POINTEUR (3 octets) vers la zone de travail du BASIC, en memoire EXTERNE : il CONTIENT l'adresse, il N'EST PAS la zone. La ROM le recopie dans basptr par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Nom de E. Kako (register.ls ...
000000                   	iocs_call:        equ 0FFFE8H ; IOCS call entry
000000                   	d6_search_phys:   equ 41H   ; memcard_search_phys - adresse physique d'un bloc d'apres son nom ((ch) = slot 0/1/2, X = nom du bloc ...
000000                   	d6_block_resize:  equ 42H   ; memcard_block_resize - changement de taille d'un bloc ((ch) = slot, a = numero de pointeur de zone ...
000000                   	d6_condense:      equ 47H   ; memcard_condense - compactage de l'espace libre des blocs memoire ((ch) = slot)
000000                   	d6_blk_cre_top:   equ 48H   ; memcard_block_create_top - cree un bloc VIDE de 22h octets EN TETE ; la taille passee dans Y est IGNOREE ...
000000                   	
000000                   	res_id:         equ     0BFBDFH         ; 084H = « c'est T484 qui a ecrit »
000000                   	res_etape:      equ     0BFBE0H
000000                   	res_err:        equ     0BFBE1H
000000                   	tr_ptr:         equ     0BFB7DH
000000                   	tr_base:        equ     0BFB80H
000000                   	
000000                   	demande:        equ     000B17H         ; 2839 octets, comme T482
000000                   	
0BF000                   	        org     0BF000H
0BF000                   	        pre_on
0BF000                   	
0BF000                   	start:
0BF000 08 84             	        mv      a,084H                  ; T484 : l'identifiant AVANT tout, il survit a un arret
0BF002 A8 DF FB 0B       	        mv      [res_id],a
0BF006 08 00             	        mv      a,000H
0BF008 A8 E0 FB 0B       	        mv      [res_etape],a
0BF00C A8 E1 FB 0B       	        mv      [res_err],a
0BF010 0D 80 FB 0B       	        mv      y,tr_base               ; la trace repart du debut a chaque appel
0BF014 AD 7D FB 0B       	        mv      [tr_ptr],y
0BF018 04 07 F1          	        call    tr_pair                 ; (1)(2) l'etat d'entree
0BF01B                   	
0BF01B                   	; --- etape 1 : 47h condense -------------------------------------------------
0BF01B 08 01             	        mv      a,001H
0BF01D A8 E0 FB 0B       	        mv      [res_etape],a
0BF021 30 CD D6 06 00    	        mvw     (cl),00006H
0BF026 09 47             	        mv      il,d6_condense
0BF028 05 E8 FF 0F       	        callf   iocs_call
0BF02C 1C 81             	        jrc     echec
0BF02E 04 BB F0          	        call    linkbas                 ; (3)(4)(5)(6)
0BF031                   	
0BF031                   	; --- etape 2 : 48h block_create_top -----------------------------------------
0BF031 08 02             	        mv      a,002H
0BF033 A8 E0 FB 0B       	        mv      [res_etape],a
0BF037 30 CD D6 06 00    	        mvw     (cl),00006H
0BF03C 0C 14 F1 0B       	        mv      x,nom
0BF040 0D 17 0B 00       	        mv      y,demande
0BF044 09 48             	        mv      il,d6_blk_cre_top
0BF046 05 E8 FF 0F       	        callf   iocs_call
0BF04A 1C 63             	        jrc     echec
0BF04C 04 BB F0          	        call    linkbas                 ; (7)(8)(9)(10)
0BF04F                   	
0BF04F                   	; --- etape 3 : 42h block_resize, a=0 puis a=1 -------------------------------
0BF04F 08 03             	        mv      a,003H
0BF051 A8 E0 FB 0B       	        mv      [res_etape],a
0BF055 30 CD D6 06 00    	        mvw     (cl),00006H
0BF05A 0C 14 F1 0B       	        mv      x,nom
0BF05E 0D 17 0B 00       	        mv      y,demande
0BF062 08 00             	        mv      a,000H
0BF064 09 42             	        mv      il,d6_block_resize
0BF066 05 E8 FF 0F       	        callf   iocs_call
0BF06A 1E 21             	        jrnc    t42_ok
0BF06C                   	
0BF06C A8 E1 FB 0B       	        mv      [res_err],a
0BF070 08 05             	        mv      a,005H
0BF072 A8 E0 FB 0B       	        mv      [res_etape],a
0BF076 30 CD D6 06 00    	        mvw     (cl),00006H
0BF07B 0C 14 F1 0B       	        mv      x,nom
0BF07F 0D 17 0B 00       	        mv      y,demande
0BF083 08 01             	        mv      a,001H
0BF085 09 42             	        mv      il,d6_block_resize
0BF087 05 E8 FF 0F       	        callf   iocs_call
0BF08B 1C 22             	        jrc     echec
0BF08D                   	
0BF08D                   	t42_ok:
0BF08D 04 BB F0          	        call    linkbas                 ; (11)(12)(13)(14)
0BF090                   	
0BF090                   	; --- etape 4 : relecture 41h, pour memoire ----------------------------------
0BF090 08 04             	        mv      a,004H
0BF092 A8 E0 FB 0B       	        mv      [res_etape],a
0BF096 30 CD D6 06 00    	        mvw     (cl),00006H
0BF09B 0C 14 F1 0B       	        mv      x,nom
0BF09F 09 41             	        mv      il,d6_search_phys
0BF0A1 05 E8 FF 0F       	        callf   iocs_call
0BF0A5 1C 08             	        jrc     echec
0BF0A7                   	
0BF0A7 08 06             	        mv      a,006H
0BF0A9 A8 E0 FB 0B       	        mv      [res_etape],a
0BF0AD 12 07             	        jr      fini
0BF0AF                   	
0BF0AF                   	echec:
0BF0AF A8 E1 FB 0B       	        mv      [res_err],a
0BF0B3 04 BB F0          	        call    linkbas
0BF0B6                   	
0BF0B6                   	fini:
0BF0B6 04 07 F1          	        call    tr_pair                 ; (15)(16) l'etat de sortie
0BF0B9 9F                	        rc
0BF0BA 07                	        retf
0BF0BB                   	
0BF0BB                   	; ---------------------------------------------------------------------------
0BF0BB                   	; linkbas -- celui de BASEXTDR.ASM, AUGMENTE DE LA TRACE et de rien d'autre :
0BF0BB                   	;            l'ordre des instructions, les registres et les chemins d'erreur
0BF0BB                   	;            sont ceux du pilote, sans quoi la mesure ne vaudrait pas pour lui.
0BF0BB                   	; ---------------------------------------------------------------------------
0BF0BB                   	linkbas:
0BF0BB 8C 0E FD 0B       	        mv      x,[baswrk]
0BF0BF 08 72             	        mv      a,072H
0BF0C1 45 40             	        add     x,a
0BF0C3 04 E9 F0          	        call    lb_chercher
0BF0C6 1C 20             	        jrc     lb_perdu
0BF0C8 2C                	        pushu   x                       ; tr_y detruit X, que l'idiome fait avancer
0BF0C9 04 F8 F0          	        call    tr_y                    ; ce que la 1re recherche a rendu
0BF0CC 3C                	        popu    x
0BF0CD 30 A5 CB          	        mv      (txtbas),y
0BF0D0 04 E9 F0          	        call    lb_chercher
0BF0D3 1C 13             	        jrc     lb_perdu
0BF0D5 2C                	        pushu   x
0BF0D6 04 F8 F0          	        call    tr_y                    ; ce que la 2e recherche a rendu
0BF0D9 3C                	        popu    x
0BF0DA 30 A5 CE          	        mv      (datbas),y
0BF0DD 08 00             	        mv      a,000H
0BF0DF 30 B8 80 E6 3A    	        mv      [(iocsw)+03AH],a
0BF0E4 04 07 F1          	        call    tr_pair                 ; (txtbas) et (datbas) tels qu'ils sont
0BF0E7 06                	        ret
0BF0E8                   	lb_perdu:
0BF0E8 FF                	        reset
0BF0E9                   	lb_chercher:
0BF0E9 30 E0 24 D7       	        mv      (ch),[x++]
0BF0ED 30 CC D6 06       	        mv      (cl),006H
0BF0F1 09 41             	        mv      il,041H
0BF0F3 05 E8 FF 0F       	        callf   iocs_call
0BF0F7 06                	        ret
0BF0F8                   	
0BF0F8                   	; ---------------------------------------------------------------------------
0BF0F8                   	; tr_y    -- ajoute Y a la trace. Detruit A et X ; PRESERVE Y.
0BF0F8                   	; tr_pair -- ajoute (txtbas) puis (datbas). Detruit A, X et Y.
0BF0F8                   	; ---------------------------------------------------------------------------
0BF0F8                   	tr_y:
0BF0F8 8C 7D FB 0B       	        mv      x,[tr_ptr]
0BF0FC B5 04             	        mv      [x],y
0BF0FE 08 03             	        mv      a,003H
0BF100 45 40             	        add     x,a
0BF102 AC 7D FB 0B       	        mv      [tr_ptr],x
0BF106 06                	        ret
0BF107                   	
0BF107                   	tr_pair:
0BF107 30 85 CB          	        mv      y,(txtbas)
0BF10A 04 F8 F0          	        call    tr_y
0BF10D 30 85 CE          	        mv      y,(datbas)
0BF110 04 F8 F0          	        call    tr_y
0BF113 06                	        ret
