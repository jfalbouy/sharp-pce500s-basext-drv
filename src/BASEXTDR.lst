000000                   	; ============================================================================
000000                   	; BASEXTDR.ASM -- BASEXT residant : un pilote de S1: (projet BASEXT-DRV)
000000                   	; ============================================================================
000000                   	; Version 0.3 du 2026-10-14 -- la 0.2 (2026-09-16) est ✅ EPROUVEE SUR PC-E500S
000000                   	; REEL le 2026-09-18 ; la 0.3 ajoute le mot-cle DWGL et descend le chargement de
000000                   	; 0BE400h a 0BE000h, le bloc ne tenant plus sous 0BF000h (3072 octets).
000000                   	;
000000                   	; Les 15 mots-cles de BASEXT (LPEEK ... XCLS, DWGL) vivent dans un bloc protege de
000000                   	; S1: (BASEXT.SYS) au lieu de la zone langage machine. Le code des mots-cles
000000                   	; n'est PAS recopie : il est INCLUS depuis C:\Claude\BASEXT\src\BASEXT.ASM.
000000                   	;
000000                   	; SUR LA MACHINE
000000                   	;   POKE &BFE03,&1A,&FD,&B,0,&1C,0:CALL &FFFD8   reserver 7168 octets (0BE000h)
000000                   	;   LOAD M "X:BASEXTDR.OBJ"                      (ou F:)
000000                   	;   CALL &BF000                                  installer
000000                   	;   CALL &xxxxx                                  reposer crochets et maillon
000000                   	;                                                (adresse affichee a l'installation)
000000                   	;   CALL &BF000 "-U"                             desinstaller (puis SET/KILL)
000000                   	;
000000                   	; ⛔ LA VERSION 0.1 AJOUTAIT LE BLOC EN FIN DE CHAINE, et il BOUGEAIT. Mesure
000000                   	;    sur emulateur le 2026-09-16 (essais/BLOCS.BAS) : copie en 0804E5h, relue en
000000                   	;    0BCF30h au RUN suivant. DATA.BAS est le PREMIER bloc de S1: et contient la
000000                   	;    memoire libre ; en regrossissant, il pousse tout ce qui le suit, et le bloc
000000                   	;    deplace sans relocation laissait crochets, d_link et filtre sur l'ancienne
000000                   	;    adresse (plantage de PockEmul a la ligne tapee suivante). Le DRIVER_TEMPLATE
000000                   	;    n'avait ete valide que jusqu'a « apparait dans FILES ».
000000                   	;    La 0.2 reprend le modele de PLINKC 1.62, VALIDE SUR MATERIEL : insertion
000000                   	;    AVANT le premier bloc qui n'est pas un pilote, decalage des blocs suivants,
000000                   	;    puis recalage de TEXT.BAS/DATA.BAS (linkbas).
000000                   	;
000000                   	; OU EST LE CODE DES MOTS-CLES : PAS ICI. Une seule ligne l'apporte,
000000                   	;   « include ..\..\BASEXT\src\BASEXT.ASM », dans le bloc residant (bandeau
000000                   	;   #### plus bas). Ce fichier n'ecrit que ce qui fait de ce code un pilote :
000000                   	;   en-tetes, bd_arret, bd_reprise, installateur, desinstallateur.
000000                   	;
000000                   	; L'OBJET (charge en 0BE000h)
000000                   	;   0BE000h  block_top    l'IMAGE du bloc, relogee puis copiee dans S1:
000000                   	;            ...          bourrage jusqu'a 0BF000h
000000                   	;   0BF000h  bd_entree    l'installateur (CALL &BF000)
000000                   	;            rel_table    la table de relocation, GENEREE (reloc.inc)
000000                   	;
000000                   	; CONSTRUIRE : python ..\outils\construire.py   (jamais xasm seul : la table
000000                   	; de relocation doit etre regeneree a chaque modification, ici OU dans BASEXT)
000000                   	;
000000                   	; SOURCES : xasm2026-4/Exemples/DRIVER_TEMPLATE (en-tetes, desinstallation) ;
000000                   	; xasm2026-4/Exemples/PLINKC/A62 (insertion, decalage, linkbas, table Kon,
000000                   	; controle de page) ; BASEXT-DRV/CONCEPTION.md (decisions, mesures).
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	; ============================================================================
000000                   	; pce500.inc - constantes systeme du SHARP PC-E500S / SC62015
000000                   	; ============================================================================
000000                   	;
000000                   	; GENERE automatiquement par xasm2026-4/tools/generate_pce500_inc.py a partir des tables
000000                   	; du desassembleur SC62015Disassembler (Data/*.json), source autoritative alignee
000000                   	; sur le listing de reference. NE PAS EDITER A LA MAIN : regenerer depuis les tables.
000000                   	; Genere le 2026-10-12.
000000                   	;
000000                   	; Usage :   include pce500.inc
000000                   	;
000000                   	; Adresses en hexa avec chiffre de tete (0BFC15H) : XASM exige qu'un nombre commence
000000                   	; par un chiffre ou $. Les noms sont ceux qu'emet le desassembleur, d'ou la coherence
000000                   	; entre une source ecrite ici et un desassemblage relu la-bas.
000000                   	
000000                   	; --- Registres et zones de la RAM interne (00h-0FFh) ---------------------------
000000                   	txtbas: equ 0CBH ; TEXT.BAS courant
000000                   	datbas: equ 0CEH ; DATA.BAS courant
000000                   	basptr: equ 0D1H ; POINTEUR (3 octets) vers la zone de travail de l'interpreteur BASIC, en RAM interne. C'est la COPIE de celui que la ROM lit en 0BFD0Eh (baswrk) : elle la fait par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Les crochets d'extension du BAS ...
000000                   	bl:     equ 0D4H ; registre BL / BX bas
000000                   	bh:     equ 0D5H ; registre BH / BX haut
000000                   	cl:     equ 0D6H ; registre CL / CX bas
000000                   	ch:     equ 0D7H ; registre CH / CX haut
000000                   	dl:     equ 0D8H ; registre DL / DX bas
000000                   	dh:     equ 0D9H ; registre DH / DX haut
000000                   	si:     equ 0DAH ; pointeur source (3 octets)
000000                   	di:     equ 0DDH ; pointeur destination (3 octets)
000000                   	iocsw:  equ 0E6H ; zone de travail IOCS : recopie du pointeur [0BFD17h] (3 octets) (manuel technique, IOCS Special Technique p85-86)
000000                   	brkmsk: equ 0EAH ; masque de la touche BREAK
000000                   	iisr:   equ 0EBH ; Interrupt In-Service Register : le bit vaut 1 pendant l'execution de la routine d'interruption ; bits 0-6 : timer rapide, timer lent, clavier, touche ON, emission SIO, reception SIO, batterie faible, bit 7 = instruction IR (man ...
000000                   	bp_ram: equ 0ECH ; base pointer RAM interne
000000                   	px:     equ 0EDH ; pointeur auxiliaire PX
000000                   	py:     equ 0EEH ; pointeur auxiliaire PY
000000                   	amc:    equ 0EFH ; Address Modify Control : bit 7 AME autorise la modification d'adresse, bits 5-0 AM5-AM0 donnent la capacite de la carte RAM cote CE0 en code thermometre (000000 = 2 Ko, 000001 = 4, 000011 = 8, 000111 = 16, 001111 = 32, 011111 = ...
000000                   	ko:     equ 0F0H ; Key Output Buffer bas (KOL) : pilote les pins KO0-KO7, un bit par pin, 1 = niveau haut ; strobe clavier. Lecture/ecriture (manuel CPU p9)
000000                   	koh:    equ 0F1H ; Key Output Buffer haut (KOH) : pilote les pins KO8-KO15. Lecture/ecriture (manuel CPU p9-10)
000000                   	ki:     equ 0F2H ; Key Input Buffer (KI) : etat des pins KI0-KI7, 1 = niveau haut ; lecture du clavier. LECTURE SEULE (manuel CPU p10)
000000                   	eol:    equ 0F3H ; E Port Output Buffer bas (EOL) : pilote les pins E0-E7, port d'E/S general. Lecture/ecriture (manuel CPU p10)
000000                   	eoh:    equ 0F4H ; E Port Output Buffer haut (EOH) : pilote les pins E8-E15. Lecture/ecriture (manuel CPU p10)
000000                   	eil:    equ 0F5H ; E Port Input Buffer bas (EIL) : etat des pins E0-E7. LECTURE SEULE (manuel CPU p11)
000000                   	eih:    equ 0F6H ; E Port Input Buffer haut (EIH) : etat des pins E8-E15. LECTURE SEULE (manuel CPU p11)
000000                   	ucr:    equ 0F7H ; UART Control Register : bit 7 BOE (break : force 0 sur TXD), bits 6-4 debit (0 arrete ET REINITIALISE l UART, 1 300, 2 600, 3 1200, 4 2400, 5 4800, 6 9600, 7 19200 bps), bits 3-2 parite (00 paire, 01 impaire, 1x aucune), bit 1 ...
000000                   	usr:    equ 0F8H ; UART Status Register : bit 5 RXR caractere recu, bit 4 TXE emetteur au repos, bit 3 TXR tampon d'emission libre, bit 2 FE erreur de trame, bit 1 OE surcharge, bit 0 PE erreur de parite. RXR et TXR alimentent les bits RXRI/TXRI ...
000000                   	rxd:    equ 0F9H ; UART Receive Buffer : le caractere recu ; le lire remet RXR a zero. LECTURE SEULE (manuel CPU p12-14)
000000                   	txd:    equ 0FAH ; UART Transmit Buffer : le caractere a emettre ; peut etre ecrit pendant l'emission du precedent, TXR dit si le tampon est libre. ECRITURE SEULE (manuel CPU p14-15)
000000                   	imr:    equ 0FBH ; Interrupt Mask Register : bit 7 IRM masque general, bit 6 EXM interruption EXTERNE (pin IRQ ; sur PC-E500 ce pin est cable au controleur de batterie, d'ou 'batterie faible' cote machine), bit 5 RXRM reception SIO, bit 4 TXRM em ...
000000                   	isr:    equ 0FCH ; Interrupt Status Register : memes bits 6-0 que l'IMR (bit 6 EXI = interruption EXTERNE), pas de bit 7. La demande met le bit a 1, ou il RESTE jusqu'a ce que le logiciel y ecrive 0. Le handler de la ROM lit (isr) ET (imr) puis s ...
000000                   	scr:    equ 0FDH ; System Control Register : bit 7 ISE autorise l'interruption externe (pin IRQ) a reveiller d'un HALT/OFF, bits 6-4 pilotent les pins CO/CI de la cassette (bas, haut, 2 kHz, 4 kHz, et autorisation de l'entree), bit 3 VDDC niveau ...
000000                   	lcc:    equ 0FEH ; LCD Contrast Control : bits 7-3 contraste sur 32 crans, bit 2 KSD inhibe le strobe clavier (tous les KO au niveau bas), bit 1 STCL et bit 0 MTCL remettent a zero le timer secondes / millisecondes lors d'un TCL. Lecture/ecriture ...
000000                   	ssr:    equ 0FFH ; System Status Register : bit 3 ONK touche ON enfoncee, bit 2 RSF (1 : on sort d'un HALT/OFF, 0 : le pin RESET a ete active), bit 1 CI entree cassette, bit 0 TEST entree de test. LECTURE SEULE (manuel CPU p20-21)
000000                   	
