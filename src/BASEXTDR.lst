000000                   	; ============================================================================
000000                   	; BASEXTDR.ASM -- BASEXT residant : un pilote de S1: (projet BASEXT-DRV)
000000                   	; ============================================================================
000000                   	; Version 0.2 du 2026-09-16 -- NON EPROUVEE SUR MACHINE.
000000                   	;
000000                   	; Les 14 mots-cles de BASEXT (LPEEK ... XCLS) vivent dans un bloc protege de
000000                   	; S1: (BASEXT.SYS) au lieu de la zone langage machine. Le code des mots-cles
000000                   	; n'est PAS recopie : il est INCLUS depuis C:\Claude\BASEXT\src\BASEXT.ASM.
000000                   	;
000000                   	; SUR LA MACHINE
000000                   	;   POKE &BFE03,&1A,&FD,&B,0,&18,0:CALL &FFFD8   reserver 6144 octets (0BE400h)
000000                   	;   LOAD M "X:BASEXTDR.OBJ"                      (ou F:)
000000                   	;   CALL &BF000                                  installer
000000                   	;   CALL &xxxxx                                  reposer crochets et maillon
000000                   	;                                                (adresse affichee a l'installation)
000000                   	;   CALL &BF000 "-U"                             desinstaller (puis SET/KILL)
000000                   	;
000000                   	; ⛔ LA VERSION 0.1 AJOUTAIT LE BLOC EN FIN DE CHAINE, et il BOUGEAIT. Mesure
000000                   	;    sur emulateur le 2026-09-16 (essais/BLOCS.BAS) : copie en 0804E5h, relue en
000000                   	;    0BCF30h au RUN suivant. DATA.BAS est le PREMIER bloc de S1: et contient la
000000                   	;    memoire libre ; en regrossissant, il pousse tout ce qui le suit, et le bloc
000000                   	;    deplace sans relocation laissait crochets, d_link et filtre sur l'ancienne
000000                   	;    adresse (plantage de PockEmul a la ligne tapee suivante). Le DRIVER_TEMPLATE
000000                   	;    n'avait ete valide que jusqu'a « apparait dans FILES ».
000000                   	;    La 0.2 reprend le modele de PLINKC 1.62, VALIDE SUR MATERIEL : insertion
000000                   	;    AVANT le premier bloc qui n'est pas un pilote, decalage des blocs suivants,
000000                   	;    puis recalage de TEXT.BAS/DATA.BAS (linkbas).
000000                   	;
000000                   	; L'OBJET (charge en 0BE400h)
000000                   	;   0BE400h  block_top    l'IMAGE du bloc, relogee puis copiee dans S1:
000000                   	;            ...          bourrage jusqu'a 0BF000h
000000                   	;   0BF000h  bd_entree    l'installateur (CALL &BF000)
000000                   	;            rel_table    la table de relocation, GENEREE (reloc.inc)
000000                   	;
000000                   	; CONSTRUIRE : python ..\outils\construire.py   (jamais xasm seul : la table
000000                   	; de relocation doit etre regeneree a chaque modification, ici OU dans BASEXT)
000000                   	;
000000                   	; SOURCES : xasm2026-4/Exemples/DRIVER_TEMPLATE (en-tetes, desinstallation) ;
000000                   	; xasm2026-4/Exemples/PLINKC/A62 (insertion, decalage, linkbas, table Kon,
000000                   	; controle de page) ; BASEXT-DRV/CONCEPTION.md (decisions, mesures).
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	; ============================================================================
000000                   	; pce500.inc - constantes systeme du SHARP PC-E500S / SC62015
000000                   	; ============================================================================
000000                   	;
000000                   	; GENERE automatiquement par tools/generate_pce500_inc.py a partir des tables
000000                   	; du desassembleur SC62015Disassembler (Data/*.json), source autoritative alignee
000000                   	; sur le listing de reference. NE PAS EDITER A LA MAIN : regenerer depuis les tables.
000000                   	; Genere le 2026-09-14.
000000                   	;
000000                   	; Usage :   include pce500.inc
000000                   	;
000000                   	; Adresses en hexa avec chiffre de tete (0BFC15H) : XASM exige qu'un nombre commence
000000                   	; par un chiffre ou $. Les noms sont ceux qu'emet le desassembleur, d'ou la coherence
000000                   	; entre une source ecrite ici et un desassemblage relu la-bas.
000000                   	
000000                   	; --- Registres et zones de la RAM interne (00h-0FFh) ---------------------------
000000                   	txtbas: equ 0CBH ; TEXT.BAS courant
000000                   	datbas: equ 0CEH ; DATA.BAS courant
000000                   	basptr: equ 0D1H ; POINTEUR (3 octets) vers la zone de travail de l'interpreteur BASIC, en RAM interne. C'est la COPIE de celui que la ROM lit en 0BFD0Eh (baswrk) : elle la fait par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Les crochets d'extension du BAS ...
000000                   	bl:     equ 0D4H ; registre BL / BX bas
000000                   	bh:     equ 0D5H ; registre BH / BX haut
000000                   	cl:     equ 0D6H ; registre CL / CX bas
000000                   	ch:     equ 0D7H ; registre CH / CX haut
000000                   	dl:     equ 0D8H ; registre DL / DX bas
000000                   	dh:     equ 0D9H ; registre DH / DX haut
000000                   	si:     equ 0DAH ; pointeur source (3 octets)
000000                   	di:     equ 0DDH ; pointeur destination (3 octets)
000000                   	iocsw:  equ 0E6H ; zone de travail IOCS : recopie du pointeur [0BFD17h] (3 octets) (manuel technique, IOCS Special Technique p85-86)
000000                   	brkmsk: equ 0EAH ; masque de la touche BREAK
000000                   	iisr:   equ 0EBH ; Interrupt In-Service Register : le bit vaut 1 pendant l'execution de la routine d'interruption ; bits 0-6 : timer rapide, timer lent, clavier, touche ON, emission SIO, reception SIO, batterie faible, bit 7 = instruction IR (man ...
000000                   	bp_ram: equ 0ECH ; base pointer RAM interne
000000                   	px:     equ 0EDH ; pointeur auxiliaire PX
000000                   	py:     equ 0EEH ; pointeur auxiliaire PY
000000                   	amc:    equ 0EFH ; Address Modify Control : bit 7 AME autorise la modification d'adresse, bits 5-0 AM5-AM0 donnent la capacite de la carte RAM cote CE0 en code thermometre (000000 = 2 Ko, 000001 = 4, 000011 = 8, 000111 = 16, 001111 = 32, 011111 = ...
000000                   	ko:     equ 0F0H ; Key Output Buffer bas (KOL) : pilote les pins KO0-KO7, un bit par pin, 1 = niveau haut ; strobe clavier. Lecture/ecriture (manuel CPU p9)
000000                   	koh:    equ 0F1H ; Key Output Buffer haut (KOH) : pilote les pins KO8-KO15. Lecture/ecriture (manuel CPU p9-10)
000000                   	ki:     equ 0F2H ; Key Input Buffer (KI) : etat des pins KI0-KI7, 1 = niveau haut ; lecture du clavier. LECTURE SEULE (manuel CPU p10)
000000                   	eol:    equ 0F3H ; E Port Output Buffer bas (EOL) : pilote les pins E0-E7, port d'E/S general. Lecture/ecriture (manuel CPU p10)
000000                   	eoh:    equ 0F4H ; E Port Output Buffer haut (EOH) : pilote les pins E8-E15. Lecture/ecriture (manuel CPU p10)
000000                   	eil:    equ 0F5H ; E Port Input Buffer bas (EIL) : etat des pins E0-E7. LECTURE SEULE (manuel CPU p11)
000000                   	eih:    equ 0F6H ; E Port Input Buffer haut (EIH) : etat des pins E8-E15. LECTURE SEULE (manuel CPU p11)
000000                   	ucr:    equ 0F7H ; UART Control Register : bit 7 BOE (break : force 0 sur TXD), bits 6-4 debit (0 arrete ET REINITIALISE l UART, 1 300, 2 600, 3 1200, 4 2400, 5 4800, 6 9600, 7 19200 bps), bits 3-2 parite (00 paire, 01 impaire, 1x aucune), bit 1 ...
000000                   	usr:    equ 0F8H ; UART Status Register : bit 5 RXR caractere recu, bit 4 TXE emetteur au repos, bit 3 TXR tampon d'emission libre, bit 2 FE erreur de trame, bit 1 OE surcharge, bit 0 PE erreur de parite. RXR et TXR alimentent les bits RXRI/TXRI ...
000000                   	rxd:    equ 0F9H ; UART Receive Buffer : le caractere recu ; le lire remet RXR a zero. LECTURE SEULE (manuel CPU p12-14)
000000                   	txd:    equ 0FAH ; UART Transmit Buffer : le caractere a emettre ; peut etre ecrit pendant l'emission du precedent, TXR dit si le tampon est libre. ECRITURE SEULE (manuel CPU p14-15)
000000                   	imr:    equ 0FBH ; Interrupt Mask Register : bit 7 IRM masque general, bit 6 EXM interruption EXTERNE (pin IRQ ; sur PC-E500 ce pin est cable au controleur de batterie, d'ou 'batterie faible' cote machine), bit 5 RXRM reception SIO, bit 4 TXRM em ...
000000                   	isr:    equ 0FCH ; Interrupt Status Register : memes bits 6-0 que l'IMR (bit 6 EXI = interruption EXTERNE), pas de bit 7. La demande met le bit a 1, ou il RESTE jusqu'a ce que le logiciel y ecrive 0. Le handler de la ROM lit (isr) ET (imr) puis s ...
000000                   	scr:    equ 0FDH ; System Control Register : bit 7 ISE autorise l'interruption externe (pin IRQ) a reveiller d'un HALT/OFF, bits 6-4 pilotent les pins CO/CI de la cassette (bas, haut, 2 kHz, 4 kHz, et autorisation de l'entree), bit 3 VDDC niveau ...
000000                   	lcc:    equ 0FEH ; LCD Contrast Control : bits 7-3 contraste sur 32 crans, bit 2 KSD inhibe le strobe clavier (tous les KO au niveau bas), bit 1 STCL et bit 0 MTCL remettent a zero le timer secondes / millisecondes lors d'un TCL. Lecture/ecriture ...
000000                   	ssr:    equ 0FFH ; System Status Register : bit 3 ONK touche ON enfoncee, bit 2 RSF (1 : on sort d'un HALT/OFF, 0 : le pin RESET a ete active), bit 1 CI entree cassette, bit 0 TEST entree de test. LECTURE SEULE (manuel CPU p20-21)
000000                   	
000000                   	; --- Adresses systeme et vecteurs (20 bits) -----------------------------------
000000                   	lcd_cmd_2000:     equ 02000H  ; meme registre que lcd_cmd, vu en 002000h : les deux bases ne different que du bit 15
000000                   	lcd_data_2000:    equ 02002H  ; meme registre que lcd_data, vu en 002002h : les deux bases ne different que du bit 15
000000                   	lcd1_cmd_2000:    equ 02004H  ; meme registre que lcd1_cmd, vu en 002004h : les deux bases ne different que du bit 15 ; c'est la base que documente La Feuille du Sharp n.9, Voyage au coeur de l'ecran (A. Hansen), et celle qu'emploient S3EXT et RO ...
000000                   	lcd1_stat_2000:   equ 02005H  ; meme registre que lcd1_stat, vu en 002005h : les deux bases ne different que du bit 15
000000                   	lcd1_data_2000:   equ 02006H  ; meme registre que lcd1_data, vu en 002006h : les deux bases ne different que du bit 15
000000                   	lcd1_read_2000:   equ 02007H  ; meme registre que lcd1_read, vu en 002007h : les deux bases ne different que du bit 15
000000                   	lcd2_cmd_2000:    equ 02008H  ; meme registre que lcd2_cmd, vu en 002008h : les deux bases ne different que du bit 15
000000                   	lcd2_stat_2000:   equ 02009H  ; meme registre que lcd2_stat, vu en 002009h : les deux bases ne different que du bit 15
000000                   	lcd2_data_2000:   equ 0200AH  ; meme registre que lcd2_data, vu en 00200Ah : les deux bases ne different que du bit 15
000000                   	lcd2_read_2000:   equ 0200BH  ; meme registre que lcd2_read, vu en 00200Bh : les deux bases ne different que du bit 15
000000                   	lcd_cmd:          equ 0A000H  ; LCD, commande des DEUX controleurs a la fois : rom83/rom53 y font l'initialisation et l'extinction (17 ecritures), vogue y ecrit sa commande avant de streamer vers lcd1_data et lcd2_data
000000                   	lcd_data:         equ 0A002H  ; LCD, donnees vers les deux controleurs a la fois
000000                   	lcd1_cmd:         equ 0A004H  ; HD61202 IC-6 (moitie gauche, 120 colonnes), commande : 03Eh/03Fh eteint-allume, 0C0h+adresse de depart, 0B8h+page (adresse X, 0-7), 040h+adresse Y (0-63) ; cf. La Feuille du Sharp n.9, Voyage au coeur de l'ecran (A ...
000000                   	lcd1_stat:        equ 0A005H  ; HD61202 IC-6, lecture des statuts : bit 7 BUSY, bit 5 ON/OFF, bit 4 RESET
000000                   	lcd1_data:        equ 0A006H  ; HD61202 IC-6, ecriture d'un octet dans la RAM d'affichage ; l'adresse s'incremente apres chaque acces
000000                   	lcd1_read:        equ 0A007H  ; HD61202 IC-6, lecture d'un octet de la RAM d'affichage
000000                   	lcd2_cmd:         equ 0A008H  ; HD61202 IC-5 (moitie droite, 120 colonnes), commande ; memes codes que lcd1_cmd
000000                   	lcd2_stat:        equ 0A009H  ; HD61202 IC-5, lecture des statuts
000000                   	lcd2_data:        equ 0A00AH  ; HD61202 IC-5, ecriture d'un octet dans la RAM d'affichage
000000                   	lcd2_read:        equ 0A00BH  ; HD61202 IC-5, lecture d'un octet de la RAM d'affichage
000000                   	s3_top:           equ 0BFC09H ; lead address du slot 2 = lecteur S3: (3 octets ; manuel technique, Parameter of memory block device)
000000                   	s3_cap:           equ 0BFC0CH ; capacite du slot 2 (S3:) en blocs de 2 Ko (2 octets ; manuel technique, Parameter of memory block device)
000000                   	s2_top:           equ 0BFC0FH ; lead address du slot 1 = lecteur S2:, 040000h sur PC-E500S (3 octets ; manuel technique, Parameter of memory block device)
000000                   	s2_cap:           equ 0BFC12H ; capacite du slot 1 (S2:) en blocs de 2 Ko (2 octets ; manuel technique, Parameter of memory block device)
000000                   	s1_top:           equ 0BFC15H ; top of S1 (nom et libelle de REGISTER.ASM) ; lead address du slot 0 = lecteur S1:, 080000h sur PC-E500S (3 octets ; manuel technique, Parameter of memory block device)
000000                   	s1_cap:           equ 0BFC18H ; capacite du slot 0 (S1:) en blocs de 2 Ko (2 octets ; manuel technique, Parameter of memory block device)
000000                   	scrn_crsr_x:      equ 0BFC27H ; X du curseur du peripherique stdo:/scrn:
000000                   	scrn_crsr_y:      equ 0BFC28H ; Y du curseur du peripherique stdo:/scrn:
000000                   	ctrl_disp:        equ 0BFC29H ; code de controle affiche au lieu d'etre execute (bit 6)
000000                   	linprn:           equ 0BFC2AH ; motif de points du trait et du remplissage de rectangle, 16 points (2 octets) ; employe par les commandes 04Eh line_draw et 04Fh box_fill du device 0. ATTENTION : le manuel se contredit sur ce nom - la liste des pa ...
000000                   	keytbl_1b:        equ 0BFC2DH ; pointeur table conversion clavier, code 1 octet (3 o, table de 62 o)
000000                   	keytbl_2b:        equ 0BFC30H ; pointeur table conversion clavier, code 2 octets (3 o)
000000                   	keytbl_1b_shift:  equ 0BFC33H ; pointeur table conversion clavier SHIFT, code 1 octet (3 o)
000000                   	keytbl_2b_shift:  equ 0BFC36H ; pointeur table conversion clavier SHIFT, code 2 octets (3 o)
000000                   	keytbl_1b_ctrl:   equ 0BFC39H ; pointeur table conversion clavier CTRL, code 1 octet (3 o)
000000                   	keytbl_2b_ctrl:   equ 0BFC3CH ; pointeur table conversion clavier CTRL, code 2 octets (3 o)
000000                   	funckey_flag:     equ 0BFC3FH ; bit 2 = affichage des touches de fonction interdit
000000                   	key_hook1:        equ 0BFC41H ; hook de la routine de traitement clavier (3 o)
000000                   	funckey_slot:     equ 0BFC45H ; numero de slot portant le fichier FUNCKEY (0 = S1:)
000000                   	funckey_name:     equ 0BFC46H ; nom du fichier portant les touches de fonction (BFC46-BFC51)
000000                   	defdrv:           equ 0BFC7DH ; nom du peripherique par defaut, 6 caracteres completes d'espaces : celui qu'insere la ROM quand un nom de fichier n'en porte pas. Initialise a "X:    " en 0E0BDFh, qui n'est le nom d'aucun peripherique de la chaine ...
000000                   	font_pool_end:    equ 0BFC84H ; sixieme emplacement de la table des pointeurs de police, le plus bas : la ROM le remplit avec les cinq autres (18 octets recopies en 0BFC84h, cf. Docs/Synthese/Memoire-et-SDA.md). Sa valeur vaut << fin des cinq pol ...
000000                   	font_00_1f:       equ 0BFC87H ; adresse de la police des caracteres 00h-1Fh (3 o, 6 octets par caractere)
000000                   	font_80_9f:       equ 0BFC8AH ; adresse de la police des caracteres 80h-9Fh (3 o)
000000                   	font_e0_ff:       equ 0BFC8DH ; adresse de la police des caracteres E0h-FFh, 32 glyphes (3 o ; le resolveur 0F2418h borne par cmp a,0E0h)
000000                   	font_20_7f:       equ 0BFC90H ; adresse de la police des caracteres 20h-7Fh, l'ASCII (3 o)
000000                   	font_a0_df:       equ 0BFC93H ; adresse de la police des caracteres A0h-DFh, 64 glyphes (3 o ; et non A0h-CFh comme le dit le manuel)
000000                   	dotsop:           equ 0BFC96H ; operation sur le point deja affiche : 0 allume, 1 efface, 2 inverse
000000                   	lcd_crsr_x:       equ 0BFC9BH ; X du curseur ecran
000000                   	lcd_crsr_y:       equ 0BFC9CH ; Y du curseur ecran
000000                   	lcd_width:        equ 0BFC9DH ; nombre de colonnes affichables
000000                   	lcd_height:       equ 0BFC9EH ; nombre de lignes affichables
000000                   	lcd_mode:         equ 0BFCA1H ; mode d'affichage : bit 6 = video inverse
000000                   	d_link:           equ 0BFCA2H ; device link pointer / IOCSH
000000                   	repeat_wait:      equ 0BFCBAH ; delai avant repetition d'une touche (unite 16 ms)
000000                   	repeat_pitch:     equ 0BFCBBH ; intervalle entre deux repetitions (unite 16 ms)
000000                   	apo_time:         equ 0BFCBCH ; delai d'extinction automatique (2 o, bas puis haut, unite 0,5 s)
000000                   	softint:          equ 0BFCBEH ; bit 7 = break, bit 6 = batterie faible
000000                   	keyrep:           equ 0BFCBFH ; bit 7 = repetition active, bit 4 = clic touche
000000                   	keymtx_tbl:       equ 0BFCC0H ; adresse de la table code materiel -> code matrice clavier (3 o)
000000                   	key_hook2:        equ 0BFCC3H ; hook de la routine de traitement clavier (3 o)
000000                   	intv_ftimer:      equ 0BFCC6H ; vecteur interruption timer principal, ISR/IMR bit 0 MTM ; balayage du clavier, touche BREAK comprise (manuel technique, List of interrupt factor p91-92)
000000                   	intv_stimer:      equ 0BFCC9H ; vecteur interruption timer lent, ISR/IMR bit 1 STM ; clignotement du curseur (manuel technique, List of interrupt factor p91-92)
000000                   	keyvct:           equ 0BFCCCH ; vecteur interruption clavier, ISR/IMR bit 2 KEYM ; non employee par le systeme ; se declenche quand un port K10-K17 passe a 1, soit (kil) non nul (manuel technique, List of interrupt factor p91-92)
000000                   	intv_onkey:       equ 0BFCCFH ; vecteur interruption touche ON, ISR/IMR bit 3 ONKM ; non employee par le systeme (manuel technique, List of interrupt factor p91-92)
000000                   	intv_sio_tx:      equ 0BFCD2H ; vecteur interruption emission SIO, ISR/IMR bit 4 TXRM ; non employee par le systeme ; se declencherait a la fin de l'emission d'un octet (manuel technique, List of interrupt factor p91-92)
000000                   	intv_sio_rx:      equ 0BFCD5H ; vecteur interruption reception SIO, ISR/IMR bit 5 RXRM ; reception d'un octet SIO terminee (manuel technique, List of interrupt factor p91-92)
000000                   	intv_ext:         equ 0BFCD8H ; vecteur interruption externe, ISR/IMR bit 6 EXM ; BATTERIE FAIBLE : l'interruption exterieure est cablee au controleur de batterie de la machine (manuel technique, List of interrupt factor p91-92)
000000                   	intv_soft:        equ 0BFCDBH ; vecteur interruption logicielle : instruction IR, ISR/IMR bit 7 IRM ; non employee par le systeme ; declenchee par l'instruction IR (manuel technique, List of interrupt factor p91-92)
000000                   	s1_btm:           equ 0BFCDEH ; bottom of S1 (nom et libelle de REGISTER.ASM) ; le manuel dit "last address of slot 0 (S1:) + 1" et La Feuille du Sharp en fait le pointeur de la 1re zone de travail, la pile utilisateur U : trois lectures d'une me ...
000000                   	swork:            equ 0BFCE1H ; pointeur de zone de travail : pile systeme S ; taille de la zone U = [0BFCE1h] - [0BFCDEh]
000000                   	baswrk:           equ 0BFD0EH ; POINTEUR (3 octets) vers la zone de travail du BASIC, en memoire EXTERNE : il CONTIENT l'adresse, il N'EST PAS la zone. La ROM le recopie dans basptr par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Nom de E. Kako (register.ls ...
000000                   	iocswrk:          equ 0BFD17H ; pointeur de zone de travail : IOCS ; debut de la zone de travail IOCS ; elle s'etend jusqu'a [0BFD1Ah] et fait environ 246h octets ; ce pointeur est recopie en RAM interne (iocsw) (manuel technique, IOCS Special Te ...
000000                   	usrwrk:           equ 0BFD1AH ; POINTEUR (3 octets) vers le debut de la zone langage machine de l'utilisateur : il CONTIENT l'adresse (defaut 0BFC00h, zone vide), il N'EST PAS la zone. Elle s'etend de [0BFD1Ah] au plafond 0BFC00h, et [0BFD1Ah] cl ...
000000                   	sio_timer:        equ 0BFD31H ; minuterie d'erreur SIO, 2 octets : n x 0,5 s ; 0FFFFh = sans limite (defaut) (manuel technique, Parameter Work du driver SIO p53)
000000                   	sio_baud:         equ 0BFD33H ; reglage de la liaison SIO : bits 6-4 = vitesse (001 300, 010 600, 011 1200, 100 2400, 101 4800, 110 9600 bauds ; 000 aucune), bits 3-2 = parite (00 paire, 01 impaire, 1x aucune), bit 1 = longueur (0 : 8 bits, 1 : 7 ...
000000                   	sio_setup:        equ 0BFD34H ; reglage du protocole SIO : bit 6 = emettre l'octet [0BFD61h] a l'ouverture, bit 4 = emettre [0BFD62h] a la fermeture, bit 2 = XON/XOFF en reception, bit 1 = XON/XOFF en emission ; defaut 021h (manuel technique, Par ...
000000                   	sio_rx_port_cond: equ 0BFD35H ; SIO receive port condition : ce qui CONDITIONNE la reception. bit 2 CS = 1 : ne prendre la donnee que si le signal CS est haut, l'ignorer sinon ; bit 1 CD = 1 : idem sur CD ; 0 = don't care. Defaut 002h. Technical ...
000000                   	sio_rx_port_ctrl: equ 0BFD36H ; SIO receive port control : ce que le Sharp FAIT de ses sorties quand le tampon de reception est plein. bit 6 ER = 0 : ER passe bas ; bit 5 RR = 0 : RR passe bas ; bit 4 RS = 0 : RS passe bas ; 1 = don't care. Defau ...
000000                   	sio_tx_port_cond: equ 0BFD37H ; SIO send port condition : ce qui CONDITIONNE l'emission. bit 2 CS = 1 : n'emettre que si CS est haut, attendre sinon ; bit 1 CD = 1 : idem sur CD ; 0 = don't care. Defaut 004h. ATTENTION, c'est le reglage qui expli ...
000000                   	sio_tx_port_ctrl: equ 0BFD38H ; SIO send port control : ce que le Sharp fait de ses sorties autour d'un bloc emis. bit 6 ER, bit 5 RR, bit 4 RS = 1 : le signal passe haut avant le transfert du bloc et bas apres ; 0 = don't care. Defaut 050h. Tech ...
000000                   	sio_tx_delay:     equ 0BFD39H ; SIO send delay : attente avant ou apres un bloc emis, <000h-0FFh> x 2 ms. Defaut 001h (2 ms). Technical Reference Manual PC-E500 p54 (releve du projet << Sharp transfert serial >>)
000000                   	sio_crlf:         equ 0BFD3BH ; SIO crlf : delimiteur externe converti en delimiteur interne (00Dh + 00Ah). bits 1-0 : 00 aucun, 01 = 00Dh, 10 = 00Ah, 11 = 00Dh + 00Ah. Defaut 001h. Technical Reference Manual PC-E500 p54 (releve du projet << Shar ...
000000                   	sio_eof:          equ 0BFD3CH ; SIO eof code : code de fin de fichier. Defaut 01Ah. Technical Reference Manual PC-E500 p54 (releve du projet << Sharp transfert serial >>)
000000                   	sio_open_wait:    equ 0BFD40H ; SIO open close wait : attente de n x 0,5 ms juste apres l'ouverture et juste avant la fermeture du port. Defaut 004h (20 ms). Technical Reference Manual PC-E500 p54 (releve du projet << Sharp transfert serial >>)
000000                   	sio_open_ctrl:    equ 0BFD41H ; SIO open port control : etat des sorties a l'ouverture du port. Defaut 041h. Technical Reference Manual PC-E500 p54 (releve du projet << Sharp transfert serial >>)
000000                   	sio_open_data:    equ 0BFD61H ; octet emis a l'ouverture du port SIO, si le bit 6 de [0BFD34h] est arme (manuel technique, Parameter Work du driver SIO p53)
000000                   	sio_close_data:   equ 0BFD62H ; octet emis a la fermeture du port SIO, si le bit 4 de [0BFD34h] est arme (manuel technique, Parameter Work du driver SIO p53)
