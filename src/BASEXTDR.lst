0BEAB3                   	
0BEAB3                   	; ============================================================================
0BEAB3                   	; XCONSOLE [debut][,[nombre]]  --  la fenetre de la console (INSTRUCTION)
0BEAB3                   	; ============================================================================
0BEAB3                   	; Borne la console aux lignes debut .. debut+nombre-1 de l'ecran de 4 lignes.
0BEAB3                   	;
0BEAB3                   	;   XCONSOLE            0,4 : l'ecran entier, l'etat normal
0BEAB3                   	;   XCONSOLE ,2         lignes 0-1 ; les lignes 2-3 restent figees
0BEAB3                   	;   XCONSOLE 2          lignes 2-3 (le nombre omis va jusqu'en bas)
0BEAB3                   	;   XCONSOLE 1,2        lignes 1-2
0BEAB3                   	;
0BEAB3                   	; Refus : debut > 3, nombre nul, ou debut+nombre > 4 -> erreur 33 ; une chaine
0BEAB3                   	; -> erreur 90 ; un separateur autre que ',' -> erreur 10.
0BEAB3                   	;
0BEAB3                   	; LE LEVIER EST lcd_height (0BFC9Eh), ET NON LE CURSEUR 0BFC27h/0BFC28h.
0BEAB3                   	;    Le pilote d'ecran defile quand (bh) atteint lcd_height (0F2B6Ah), clear_disp
0BEAB3                   	;    n'efface que les lignes 0 .. lcd_height-1 (0F2771h), et LOCATE refuse un Y
0BEAB3                   	;    au-dela (0FC682h). ✅ Mesure sur machine par J.-F. Albouy : POKE &BFC9E,2
0BEAB3                   	;    confine affichage, defilement et CLS aux lignes 0-1, et CLS ne remet PAS la
0BEAB3                   	;    hauteur a 4.
0BEAB3                   	;
0BEAB3                   	; POUR debut > 0, LA ROM NE SUFFIT PLUS : son defilement part TOUJOURS de la
0BEAB3                   	;    ligne 0 (0F27F1h, recopie par 0F28E3h) et emporterait les lignes figees.
0BEAB3                   	;    XCONSOLE branche alors le FILTRE D'ECRITURE (xf_entry, plus bas) sur le
0BEAB3                   	;    handle 0, et l'en debranche quand debut revient a 0.
0BEAB3                   	;
0BEAB3                   	; ⛔ LA FENETRE SURVIT A LA FIN DU PROGRAMME. Mesure : l'invite du mode direct
0BEAB3                   	;    reste dans les lignes de la fenetre, et seul MENU puis BASIC rend l'ecran.
0BEAB3                   	;    Un programme doit donc finir par XCONSOLE (puis CLS) -- apres une erreur ou
0BEAB3                   	;    un BREAK, MENU puis BASIC.
0BEAB3                   	;
0BEAB3                   	; ⚠️ CLS AVEC UNE FENETRE DE MOINS DE 4 LIGNES AFFICHE LES LIBELLES DES TOUCHES
0BEAB3                   	;    DE FONCTION sur la ligne 3. C'est la ROM : CLS teste lcd_height (0F931Ah) et,
0BEAB3                   	;    s'il ne vaut pas 4, appelle fkey_display (commande 46h du clavier, 0F1CFAh),
0BEAB3                   	;    qui dessine les libelles par la commande 58h de l'ecran -- sans passer par le
0BEAB3                   	;    filtre. Constate sur machine, et deja avec un simple POKE &BFC9E,2. Dans une
0BEAB3                   	;    fenetre, effacer par XCLS ; pour tout effacer, XCONSOLE : CLS.
0BEAB3                   	;
0BEAB3                   	; La fin d'instruction est celle de 0F617Ch, que lisent CONSOLE et LOCATE :
0BEAB3                   	; ':' ou 0Dh, regardes sans etre consommes. Les espaces se sautent comme en
0BEAB3                   	; 0FB2D9h. BP est rendu en ABSOLU (sv_bp0) sur tous les chemins : une
0BEAB3                   	; instruction rend BP inchange (MODE-EMPLOI §6.1).
0BEAB3                   	xconsole:
0BEAB3 30 D8 0D EE 0B EC 	        mv      [!sv_bp0],(bp_ram)      ; BP d'entree
0BEAB9 08 00             	        mv      a,000H
0BEABB A8 1B EE 0B       	        mv      [!xc_t],a               ; debut par defaut : 0
0BEABF 08 FF             	        mv      a,0FFH
0BEAC1 A8 1C EE 0B       	        mv      [!xc_c],a               ; nombre : absent
0BEAC5 04 54 EB          	        call    xc_skip                 ; A = premier non-espace, X dessus
0BEAC8 60 3A             	        cmp     a,03AH                  ; ':'
0BEACA 18 36             	        jrz     xc_apply
0BEACC 60 0D             	        cmp     a,00DH                  ; fin de ligne
0BEACE 18 32             	        jrz     xc_apply                ; XCONSOLE seul
0BEAD0 60 2C             	        cmp     a,02CH
0BEAD2 18 18             	        jrz     xc_comma                ; XCONSOLE ,n : debut omis
0BEAD4 04 5F EB          	        call    xc_num                  ; le debut
0BEAD7 1C 73             	        jrc     xc_err
0BEAD9 A8 1B EE 0B       	        mv      [!xc_t],a
0BEADD 04 54 EB          	        call    xc_skip
0BEAE0 60 3A             	        cmp     a,03AH
0BEAE2 18 1E             	        jrz     xc_apply
0BEAE4 60 0D             	        cmp     a,00DH
0BEAE6 18 1A             	        jrz     xc_apply
0BEAE8 60 2C             	        cmp     a,02CH
0BEAEA 1A 5A             	        jrnz    xc_syn
0BEAEC                   	xc_comma:
0BEAEC 6C 04             	        inc     x                       ; consommer la virgule
0BEAEE 04 54 EB          	        call    xc_skip
0BEAF1 60 3A             	        cmp     a,03AH
0BEAF3 18 0D             	        jrz     xc_apply
0BEAF5 60 0D             	        cmp     a,00DH
0BEAF7 18 09             	        jrz     xc_apply                ; XCONSOLE d, : nombre omis
0BEAF9 04 5F EB          	        call    xc_num                  ; le nombre de lignes
0BEAFC 1C 4E             	        jrc     xc_err
0BEAFE A8 1C EE 0B       	        mv      [!xc_c],a
0BEB02                   	
0BEB02                   	xc_apply:
0BEB02 88 1B EE 0B       	        mv      a,[!xc_t]
0BEB06 60 04             	        cmp     a,004H
0BEB08 1E 40             	        jrnc    xc_range                ; debut au-dela de la ligne 3
0BEB0A FD 10             	        mv      il,a                    ; IL = debut
0BEB0C 88 1C EE 0B       	        mv      a,[!xc_c]
0BEB10 60 FF             	        cmp     a,0FFH
0BEB12 18 0E             	        jrz     xc_full                 ; nombre omis : jusqu'en bas
0BEB14 60 00             	        cmp     a,000H
0BEB16 18 32             	        jrz     xc_range                ; une fenetre de zero ligne
0BEB18 46 01             	        add     a,il                    ; A = debut + nombre = la hauteur
0BEB1A 1C 2E             	        jrc     xc_range
0BEB1C 60 05             	        cmp     a,005H
0BEB1E 1E 2A             	        jrnc    xc_range                ; deborde sous la ligne 3
0BEB20 12 02             	        jr      xc_store
0BEB22                   	xc_full:
0BEB22 08 04             	        mv      a,004H
0BEB24                   	xc_store:
0BEB24 A8 9E FC 0B       	        mv      [lcd_height],a
0BEB28 A9 1D EE 0B       	        mv      [!xc_top],il            ; le debut, que XCLS et le filtre reliront
0BEB2C 2C                	        pushu   x                       ; xf_on et xf_off se servent de X et de I
0BEB2D 2B                	        pushu   i
0BEB2E FD 01             	        mv      a,il
0BEB30 60 00             	        cmp     a,000H
0BEB32 18 05             	        jrz     xc_unhook
