0BF000                   	; ============================================================================
0BF000                   	;  L'INSTALLATEUR -- CALL &BF000 installe, CALL &BF000 "-U" desinstalle
0BF000                   	; ============================================================================
0BF000                   	;  RAM interne de travail (adresses directes, sous pre_on), comme le gabarit :
0BF000                   	;    (000H)        drapeau d'argument, puis octet de comparaison
0BF000                   	;    (001H)-(004H) conversion hexadecimale
0BF000                   	;    (005H)-(007H) block_top          (008H)-(00AH) ecart = dest - block_top
0BF000                   	;    (00BH)-(00DH) champ en cours     (00EH)-(010H) dest, ou notre en-tete
0BF000                   	;    (011H)-(013H) fin de chaine, ou predecesseur
0BF000                   	;    (014H)-(016H) comparaisons       (017H)-(019H) bloc trouve
0BF000                   	bd_entree:
0BF000                   	;  (0) l'argument de CALL : "-U" ou "-u" desinstalle. Pointeur de ligne rendu
0BF000                   	;      AVANCE au-dela de l'argument (gabarit : sinon Syntax error au retour).
0BF000 3C                	        popu    x
0BF001 30 CC 00 00       	        mv      (000H),000H
0BF005                   	bd_arg:
0BF005 90 24             	        mv      a,[x++]
0BF007 60 00             	        cmp     a,000H
0BF009 18 20             	        jrz     bd_arg_f
0BF00B 60 0D             	        cmp     a,00DH
0BF00D 18 1C             	        jrz     bd_arg_f
0BF00F 60 1A             	        cmp     a,01AH
0BF011 18 18             	        jrz     bd_arg_f
0BF013 60 FF             	        cmp     a,0FFH
0BF015 18 14             	        jrz     bd_arg_f
0BF017 60 2D             	        cmp     a,'-'
0BF019 1B 16             	        jrnz    bd_arg
0BF01B 90 04             	        mv      a,[x]
0BF01D 60 75             	        cmp     a,'u'
0BF01F 18 04             	        jrz     bd_arg_u
0BF021 60 55             	        cmp     a,'U'
0BF023 1B 20             	        jrnz    bd_arg
0BF025                   	bd_arg_u:
0BF025 30 CC 00 01       	        mv      (000H),001H
0BF029 13 26             	        jr      bd_arg
0BF02B                   	bd_arg_f:
0BF02B 7C 04             	        dec     x
0BF02D 2C                	        pushu   x
0BF02E 0C 93 F3 0B       	        mv      x,bd_m_titre
0BF032 0D 18 00 00       	        mv      y,bd_m_titre_f-bd_m_titre
0BF036 04 E9 F2          	        call    bd_ecrire
0BF039 30 80 00          	        mv      a,(000H)
0BF03C 60 00             	        cmp     a,000H
0BF03E 18 03             	        jrz     bi_image
0BF040 02 67 F2          	        jp      bd_desinst
0BF043                   	
0BF043                   	; ----------------------------------------------------------------------------
0BF043                   	;  INSTALLATION
0BF043                   	; ----------------------------------------------------------------------------
0BF043                   	;  (1) l'image a-t-elle deja ete relogee (CALL precedent sans LOAD M) ?
0BF043                   	bi_image:
0BF043 88 92 F3 0B       	        mv      a,[bd_reloge]
0BF047 60 00             	        cmp     a,000H
0BF049 18 0B             	        jrz     bi_doublon
0BF04B 0C F2 F3 0B       	        mv      x,bd_m_recharger
0BF04F 0D 1F 00 00       	        mv      y,bd_m_recharger_f-bd_m_recharger
0BF053 02 E4 F2          	        jp      bd_erreur
0BF056                   	
0BF056                   	;  (2) deja installe ? Alors ne rien toucher, et REDONNER l'adresse de reprise
0BF056                   	;      (le cas normal apres un amorcage qui a perdu crochets et maillon).
0BF056                   	bi_doublon:
0BF056 04 F4 F2          	        call    bd_trouver
0BF059 1C 33             	        jrc     bi_crochets
0BF05B 95 84 11          	        mv      y,[x+011H]
0BF05E 30 A5 14          	        mv      (014H),y
0BF061 0D 45 0C 00       	        mv      y,block_bottom-block_top
0BF065 30 D7 05 14       	        cmpp    (014H),y
0BF069 18 0B             	        jrz     bi_deja
0BF06B 0C B1 F4 0B       	        mv      x,bd_m_autre
0BF06F 0D 1A 00 00       	        mv      y,bd_m_autre_f-bd_m_autre
0BF073 02 E4 F2          	        jp      bd_erreur
0BF076                   	bi_deja:
0BF076 0D 57 00 00       	        mv      y,bd_reprise-block_top
0BF07A 45 45             	        add     x,y
0BF07C 0D EB F3 0B       	        mv      y,bd_m_hex_d
0BF080 04 69 F3          	        call    bd_hexa
0BF083 0C CA F3 0B       	        mv      x,bd_m_deja
0BF087 0D 28 00 00       	        mv      y,bd_m_deja_f-bd_m_deja
0BF08B 02 E4 F2          	        jp      bd_erreur
0BF08E                   	
0BF08E                   	;  (3) les crochets du BASIC doivent porter la sentinelle 0FFFFFh : sinon une
0BF08E                   	;      extension est deja active (BASEXT en 0BF000h, BASCOM...), et start ne
0BF08E                   	;      sauverait pas les crochets d'origine (CONCEPTION.md §4.4).
0BF08E                   	bi_crochets:
0BF08E 30 84 D1          	        mv      x,(basptr)              ; objet : 30 84 D1
0BF091 90 84 92          	        mv      a,[x+092H]
0BF094 60 0F             	        cmp     a,00FH
0BF096 18 0B             	        jrz     bi_compacter
0BF098 0C 11 F4 0B       	        mv      x,bd_m_crochets
0BF09C 0D 20 00 00       	        mv      y,bd_m_crochets_f-bd_m_crochets
0BF0A0 02 E4 F2          	        jp      bd_erreur
0BF0A3                   	
0BF0A3                   	;  (4) compacter S1: (IOCS device 6, commande 47h). ⚠️ LES BLOCS BOUGENT : a
0BF0A3                   	;      partir d'ici, tout chemin de sortie passe par bd_linkbas (bd_erreur_lb),
0BF0A3                   	;      comme PLINKC (msend2).
0BF0A3                   	bi_compacter:
0BF0A3 30 CC D6 06       	        mv      (cl),006H
0BF0A7 30 CC D7 00       	        mv      (ch),000H
0BF0AB 0B 47 00          	        mv      i,00047H
0BF0AE 05 E8 FF 0F       	        callf   iocs_call
0BF0B2                   	
0BF0B2                   	;  (5) dest = premier bloc qui n'est PAS un pilote (attribut, bits 0Ch : regle
0BF0B2                   	;      de register.lst) ; fin = le terminateur 0FFh de la chaine.
0BF0B2 8C 15 FC 0B       	        mv      x,[s1_top]
0BF0B6 95 84 12          	        mv      y,[x+012H]
0BF0B9 45 45             	        add     x,y
0BF0BB 30 A4 0E          	        mv      (00EH),x
0BF0BE                   	bi_pilotes:
0BF0BE 90 04             	        mv      a,[x]
0BF0C0 60 FB             	        cmp     a,0FBH
0BF0C2 1A 1C             	        jrnz    bi_fin_chaine
0BF0C4 90 84 0C          	        mv      a,[x+00CH]
0BF0C7 64 0C             	        test    a,00CH
0BF0C9 18 0A             	        jrz     bi_autres
0BF0CB 95 84 11          	        mv      y,[x+011H]
0BF0CE 45 45             	        add     x,y
0BF0D0 30 A4 0E          	        mv      (00EH),x                ; apres ce pilote
0BF0D3 13 17             	        jr      bi_pilotes
0BF0D5                   	bi_autres:
0BF0D5 95 84 11          	        mv      y,[x+011H]
0BF0D8 45 45             	        add     x,y
0BF0DA 90 04             	        mv      a,[x]
0BF0DC 60 FB             	        cmp     a,0FBH
0BF0DE 19 0B             	        jrz     bi_autres
0BF0E0                   	bi_fin_chaine:
0BF0E0 30 A4 11          	        mv      (011H),x                ; fin = le terminateur
0BF0E3                   	
0BF0E3                   	;  (6) memoire : [s1_btm] - 1 - fin >= taille du bloc
0BF0E3 8D DE FC 0B       	        mv      y,[s1_btm]
0BF0E7 7C 05             	        dec     y
0BF0E9 4D 54             	        sub     y,x
0BF0EB 30 A5 14          	        mv      (014H),y
0BF0EE 0D 45 0C 00       	        mv      y,block_bottom-block_top
0BF0F2 30 D7 05 14       	        cmpp    (014H),y
0BF0F6 1E 0B             	        jrnc    bi_recouvre
0BF0F8 0C 31 F4 0B       	        mv      x,bd_m_memoire
0BF0FC 0D 1B 00 00       	        mv      y,bd_m_memoire_f-bd_m_memoire
0BF100 02 DD F2          	        jp      bd_erreur_lb
0BF103                   	
0BF103                   	;  (7) la chaine decalee ne doit pas atteindre l'objet charge : fin + taille <
0BF103                   	;      bd_objet. Attendu toujours vrai ; verifie plutot que suppose.
0BF103                   	bi_recouvre:
0BF103 0D 45 0C 00       	        mv      y,block_bottom-block_top
0BF107 45 54             	        add     y,x
0BF109 30 A5 14          	        mv      (014H),y
0BF10C 0D 00 E0 0B       	        mv      y,bd_objet
0BF110 30 D7 05 14       	        cmpp    (014H),y
0BF114 1C 0B             	        jrc     bi_page
0BF116 0C 4C F4 0B       	        mv      x,bd_m_recouvre
0BF11A 0D 1B 00 00       	        mv      y,bd_m_recouvre_f-bd_m_recouvre
0BF11E 02 DD F2          	        jp      bd_erreur_lb
0BF121                   	
0BF121                   	;  (8) une seule page de 64 Ko pour le bloc (call/jp PROCHES) : PLINKC 1.62.
0BF121                   	bi_page:
0BF121 30 82 0E          	        mv      ba,(00EH)               ; les 16 bits bas de dest
0BF124 0B 45 0C          	        mv      i,block_bottom-block_top
0BF127 44 23             	        add     ba,i
0BF129 1E 0B             	        jrnc    bi_reloger
0BF12B 0C 67 F4 0B       	        mv      x,bd_m_pages
0BF12F 0D 18 00 00       	        mv      y,bd_m_pages_f-bd_m_pages
0BF133 02 DD F2          	        jp      bd_erreur_lb
0BF136                   	
0BF136                   	;  (9) RELOGER l'image avant la copie. Ecart = dest - block_top sur 3 octets, en
0BF136                   	;      RAM interne ; chaque champ augmente de l'ecart OCTET PAR OCTET (adcl sur 2
0BF136                   	;      ou 3 octets) : le drapeau 4/8 de disp_table ne passe par aucun registre.
0BF136                   	;      Table au format Kon, offsets depuis block_top (reloc.inc).
0BF136                   	bi_reloger:
0BF136 0C 00 E0 0B       	        mv      x,block_top
0BF13A 30 A4 05          	        mv      (005H),x
0BF13D 30 84 0E          	        mv      x,(00EH)
0BF140 30 A4 08          	        mv      (008H),x
0BF143 0B 03 00          	        mv      i,00003H
0BF146 9F                	        rc
0BF147 32 5C 08 05       	        sbcl    (008H),(005H)           ; (008H) = dest - block_top, modulo 2^24
0BF14B 08 01             	        mv      a,001H
0BF14D A8 92 F3 0B       	        mv      [bd_reloge],a           ; a partir d'ici, l'image est engagee
0BF151 0C 1A F5 0B       	        mv      x,rel_table
0BF155 0D 00 E0 0B       	        mv      y,block_top
0BF159                   	br_lp:
0BF159 90 24             	        mv      a,[x++]
0BF15B 60 FF             	        cmp     a,0FFH
0BF15D 18 38             	        jrz     bi_verif
0BF15F 0B 02 00          	        mv      i,00002H
0BF162 64 80             	        test    a,080H
0BF164 18 03             	        jrz     br_larg
0BF166 0B 03 00          	        mv      i,00003H
0BF169                   	br_larg:
0BF169 70 7F             	        and     a,07FH
0BF16B 60 7E             	        cmp     a,07EH
0BF16D 1A 0A             	        jrnz    br_court
0BF16F 92 04             	        mv      ba,[x]                  ; ecart long, 2 octets
0BF171 6C 04             	        inc     x
0BF173 6C 04             	        inc     x
0BF175 45 52             	        add     y,ba
0BF177 12 02             	        jr      br_champ
0BF179                   	br_court:
0BF179 45 50             	        add     y,a
0BF17B                   	br_champ:
0BF17B 30 E2 05 0B       	        mvp     (00BH),[y]
0BF17F 9F                	        rc
0BF180 32 54 0B 08       	        adcl    (00BH),(008H)           ; I octets : 2 ou 3
0BF184                   	; ⛔ PAS « mvp [y],(00BH) » : xasm2026-4 l'assemble EA 05 0B, SANS l'octet PRE
0BF184                   	;    (moteur C : 30 EA 05 0B), et l'ecriture partirait de (BP+0Bh). Voir
0BF184                   	;    xasm2026-4/RAPPORT-BUG-octet-pre.md. Trois octets recrits un par un (un
0BF184                   	;    champ de 2 octets recrit son 3e intact).
0BF184                   	; ✅ CORRIGE dans xasm2026-4 le 2026-09-17 (commit 9e76984) et reverifie. Le
0BF184                   	;    contournement est CONSERVE : c'est le code eprouve sur emulateur, et
0BF184                   	;    revenir a mvp changerait l'objet.
0BF184 30 80 0B          	        mv      a,(00BH)
0BF187 B0 05             	        mv      [y],a
0BF189 30 80 0C          	        mv      a,(00CH)
0BF18C B0 85 01          	        mv      [y+001H],a
0BF18F 30 80 0D          	        mv      a,(00DH)
0BF192 B0 85 02          	        mv      [y+002H],a
0BF195 13 3E             	        jr      br_lp
0BF197                   	
0BF197                   	;  (10) AUTO-VERIFICATION de la relocation, SUR LA MACHINE, avant la copie : trois
0BF197                   	;       champs dont la valeur relogee se calcule autrement, par les registres.
0BF197                   	;       La simulation de construire.py verifie la table ; ceci verifie que la
0BF197                   	;       boucle ci-dessus a fait, sur ce CPU, ce que la simulation suppose.
0BF197                   	bi_verif:
