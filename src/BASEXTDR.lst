000000                   	d9_str_ne:        equ 70H   ; function_str_ne - comparaison de chaines Y<>X
000000                   	d9_str_lt:        equ 71H   ; function_str_lt - comparaison de chaines Y<X
000000                   	d9_str_gt:        equ 72H   ; function_str_gt - comparaison de chaines Y>X
000000                   	d9_str_eq:        equ 73H   ; function_str_eq - comparaison de chaines Y=X
000000                   	d9_str_le:        equ 74H   ; function_str_le - comparaison de chaines Y<=X
000000                   	d9_str_ge:        equ 75H   ; function_str_ge - comparaison de chaines Y>=X
000000                   	d9_asc:           equ 76H   ; function_asc - ASC : code du 1er caractere d'une chaine
000000                   	d9_chr_s:         equ 77H   ; function_chr_s - CHR$ : caractere de code donne
000000                   	d9_str_s:         equ 78H   ; function_str_s - STR$ : nombre converti en chaine
000000                   	d9_val:           equ 79H   ; function_val - VAL : chaine convertie en nombre
000000                   	d9_dec2bin:       equ 7EH   ; function_dec2bin - conversion decimal -> binaire
000000                   	d9_bin2dec:       equ 7FH   ; function_bin2dec - conversion binaire -> decimal
000000                   	
000000                   	; --- Doublons de nom dans les tables source, ignores pour rester univoque ------
000000                   	;   iocs_read_block  (aussi a 23H)
000000                   	;   iocs_write_block  (aussi a 24H)
000000                   	;   iocs_read_byte  (aussi a 25H)
000000                   	;   iocs_write_byte  (aussi a 26H)
000000                   	;   iocs_read_byte_nd  (aussi a 28H)
000000                   	;   system_code_addr  (aussi a 46H)
000000                   	
000000                   	; --- Fin du carnet ------------------------------------------------------------
000000                   	; END est exige par le moteur C dans chaque fichier inclus ; xasm2026-4 l'admet.
000000                   		end
000000                   	
000000                   	; BASEXT.ASM, inclus plus bas, n'emet alors ni son include de pce500.inc, ni
000000                   	; son org, ni son pre_on. ⛔ DEF, pas EQU : IFNDEF ne voit que DEF.
000000                   	        def     basext_pilote
000000                   	
0BE000                   	        org     0BE000H
0BE000                   	        pre_on                          ; INDISPENSABLE (skill pc-e500s §2.2)
0BE000                   	
0BE000                   	bd_objet:
0BE000                   	
0BE000                   	; ============================================================================
0BE000                   	;  LE BLOC RESIDANT -- de block_top a block_bottom
0BE000                   	; ============================================================================
0BE000                   	;  Tout ce qui est ici est RELOGE : toute adresse absolue interne au bloc est
0BE000                   	;  un champ de 2 ou 3 octets que reloc.py mesure. Le bloc ne doit JAMAIS citer
0BE000                   	;  une adresse de l'installateur (elle serait relogee a tort).
0BE000                   	block_top:
0BE000                   	; -- en-tete de bloc memoire (disposition du DRIVER_TEMPLATE) --
0BE000 FB                	        db      0FBH                    ; signature de bloc
0BE001 42 41 53 45 58 54 	        db      'BASEXT  SYS'           ; nom 8.3, 8 + 3, sans point
0BE007 20 20 53 59 53    	
0BE00C 25                	        db      025H                    ; attributs : device + protege (bits 0Ch : pilote)
0BE00D 00 00 00 00       	        dw      0,0                     ; date, heure
0BE011 45 0C 00          	        dp      block_bottom-block_top  ; +11h : taille du bloc (lien vers le suivant)
0BE014 00 00             	        dw      0
0BE016 45 0C 00          	        dp      block_bottom-block_top  ; +16h : taille du fichier (FILES affiche +16h - 22h)
0BE019 45 0C 00          	        dp      block_bottom-block_top
0BE01C 00 00 00 00 00 00 	        dp      0,0
0BE022                   	; -- en-tete IOCS (maillon de la chaine d_link), en +22h --
0BE022                   	iocs_header:
0BE022                   	bd_lien:
0BE022 00 00 00          	        dp      0                       ; lien suivant : ecrit par l'installateur
0BE025 14                	        db      20                      ; numero de device (celui du gabarit)
0BE026 63                	        db      063H                    ; attribut de device (celui du gabarit)
0BE027 30 E0 0B          	        dp      bd_iocs                 ; point d'entree IOCS (reloge)
0BE02A                   	bd_nom:
0BE02A 42 45 58 54 3A    	        db      'BEXT:'
0BE02F                   	bd_nom_f:
0BE02F 00                	        db      0
0BE030                   	; -- entree IOCS : aucune commande geree. La commande IOCS 05h (0E0159h) envoie
0BE030                   	;    40h a tous les pilotes chaines et IGNORE la retenue : ce stub y suffit. --
0BE030                   	bd_iocs:
0BE030 97                	        sc
0BE031 07                	        retf
0BE032                   	
0BE032                   	; bd_arret -- appele par le desinstallateur, par callf a l'adresse relogee.
0BE032                   	;   1. debranche le filtre d'ecran de XCONSOLE s'il est le notre (xf_off) ;
0BE032                   	;   2. rend les crochets du BASIC sauves par start, SEULEMENT s'ils designent
0BE032                   	;      encore ce bloc (sinon une autre extension s'est installee depuis).
0BE032                   	;   Detruit A, I, X, Y, (bl), (014H)-(016H). Preserve (00EH)-(013H), (017H)-(019H).
0BE032                   	;   ⚠️ Son premier octet d'operande (le call proche) sert a l'AUTO-VERIFICATION
0BE032                   	;   de la relocation (bi_verif) : garder « call xf_off » en tete.
0BE032                   	bd_arret:
0BE032 04 37 EA          	        call    xf_off
0BE035 30 84 D1          	        mv      x,(basptr)              ; objet : 30 84 D1
0BE038 95 84 90          	        mv      y,[x+090H]
0BE03B 30 A5 14          	        mv      (014H),y
0BE03E 0D 59 EA 0B       	        mv      y,kw_table
0BE042 30 D7 05 14       	        cmpp    (014H),y
0BE046 1A 0E             	        jrnz    ba_fin                  ; pas nos tables : ne rien rendre
0BE048 8D 3F EC 0B       	        mv      y,[old_kw]
0BE04C B5 84 90          	        mv      [x+090H],y
0BE04F 8D 42 EC 0B       	        mv      y,[old_disp]
0BE053 B5 84 93          	        mv      [x+093H],y
0BE056                   	ba_fin:
0BE056 07                	        retf
0BE057                   	
0BE057                   	; bd_reprise -- CALL &xxxxx depuis le BASIC, SANS installateur.
0BE057                   	;   La ROM remet d_link a sa table d'origine a l'amorcage (0F0D9Eh), et les
0BE057                   	;   crochets peuvent partir avec : le bloc reste, le reste se repare ici.
0BE057                   	;   1. remet notre en-tete en tete de d_link s'il n'y est plus ;
0BE057                   	;   2. saute dans start, qui repose les crochets (idempotent).
0BE057                   	;   Registres seulement (aucune RAM interne) ; X rendu tel quel par start.
0BE057                   	bd_reprise:
0BE057 2C                	        pushu   x
0BE058 0D 22 E0 0B       	        mv      y,iocs_header           ; notre en-tete, a son adresse relogee
0BE05C 8C A2 FC 0B       	        mv      x,[d_link]
0BE060                   	bd_rp_lp:
0BE060 2C                	        pushu   x
0BE061 6C 04             	        inc     x                       ; 0FFFFFh : fin de chaine (idiome du gabarit)
0BE063 3C                	        popu    x                       ; POPU ne touche pas les drapeaux
0BE064 18 0E             	        jrz     bd_rp_absent
0BE066 2C                	        pushu   x
0BE067 4D 45             	        sub     x,y
0BE069 7C 04             	        dec     x
0BE06B 6C 04             	        inc     x                       ; Z = en-tete courant = le notre
0BE06D 3C                	        popu    x
0BE06E 18 10             	        jrz     bd_rp_present
0BE070 94 04             	        mv      x,[x]
0BE072 13 14             	        jr      bd_rp_lp
0BE074                   	bd_rp_absent:
0BE074 8C A2 FC 0B       	        mv      x,[d_link]
0BE078 AC 22 E0 0B       	        mv      [iocs_header],x         ; notre lien <- la tete actuelle
0BE07C AD A2 FC 0B       	        mv      [d_link],y              ; la tete <- notre en-tete
0BE080                   	bd_rp_present:
0BE080 3C                	        popu    x
0BE081 02 84 E0          	        jp      start                   ; start rend la main au BASIC (rc / retf)
0BE084                   	
0BE084                   	; ############################################################################
0BE084                   	; ##                                                                        ##
0BE084                   	; ##   LE CODE DES 15 MOTS-CLES N'EST PAS ECRIT DANS CE FICHIER :           ##
0BE084                   	; ##   IL EST INCLUS ICI, DEPUIS C:\Claude\BASEXT\src\BASEXT.ASM            ##
0BE084                   	; ##                                                                        ##
0BE084                   	; ##   start, LPEEK, WPEEK, LPOKE, MOD, INSTR, TRIM$, LTRIM$, RTRIM$,       ##
0BE084                   	; ##   UCASE$, LCASE$, REPT$, SREPT$, XCONSOLE, XCLS, DWGL, le filtre,      ##
0BE084                   	; ##   kw_table, disp_table et les variables : environ 3000 octets.         ##
0BE084                   	; ##   Le code assemble se lit dans BASEXTDR.lst (sans -K).                 ##
0BE084                   	; ##                                                                        ##
0BE084                   	; ############################################################################
0BE084                   	        include ..\..\BASEXT\src\BASEXT.ASM
0BE084                   	; ============================================================================
0BE084                   	; BASEXT.ASM -- le module d'extensions du BASIC
0BE084                   	; ============================================================================
0BE084                   	; ATTENTION : LES NOMS DE FICHIER SHARP SONT EN 8.3
0BE084                   	;    Ce module s'est d'abord appele BASIC_EXT -- neuf caracteres, un de trop.
0BE084                   	;    La regle vaut pour tout ce qui part sur le lecteur, .OBJ comme .UU :
0BE084                   	;    LOAD M "S1:BASEXT.OBJ" ne pardonne pas un nom trop long.
0BE084                   	; ============================================================================
0BE084                   	;                 LPEEK (fonction, 3 octets), WPEEK (fonction, 2 octets)
0BE084                   	;                 et LPOKE (INSTRUCTION, ecrit des valeurs de 3 octets)
0BE084                   	; ============================================================================
0BE084                   	;
0BE084                   	; ⛔ LE NOM NE POUVAIT PAS ETRE "PEEKX", ET L'ESSAI MACHINE L'A MONTRE.
0BE084                   	;    Le tokeniseur consulte la table de la ROM AVANT la notre. "PEEKX" y est
0BE084                   	;    donc coupe en PEEK + la variable X, et la ligne devient une erreur de
0BE084                   	;    syntaxe -- relue ensuite, elle s'affiche litteralement
0BE084                   	;    "PRINT HEX$ PEEK X &BF100".
0BE084                   	;
0BE084                   	;    LA REGLE, valable pour toute extension : un mot-cle ajoute ne doit pas
0BE084                   	;    COMMENCER par un mot-cle existant, ni etre le debut de l'un d'eux. Cela se
0BE084                   	;    verifie avant d'ecrire une ligne de code, sur les 168 noms de
0BE084                   	;    Data/BasicTokens.csv. LPEEK est libre dans les deux sens.
0BE084                   	;
0BE084                   	;   LPEEK &BF0B8   rend la valeur de l'adresse 3 octets rangee en &BF0B8,
0BE084                   	;                  soit l'equivalent de
0BE084                   	;                  PEEK &BF0B8 + PEEK &BF0B9 * 256 + PEEK &BF0BA * 65536
0BE084                   	;
0BE084                   	; Ce n'est pas un CALL : c'est une INSTRUCTION DU LANGAGE, utilisable dans une
0BE084                   	; expression -- PRINT LPEEK &BF0B8, A = LPEEK X + 1, etc.
0BE084                   	;
0BE084                   	;   LOAD M "S1:LPEEK.OBJ" : CALL &BF000      installe
0BE084                   	;   PRINT HEX$ LPEEK &BF0B8
0BE084                   	;
0BE084                   	; ---------------------------------------------------------------------------
0BE084                   	; COMMENT L'INTERPRETEUR NOUS TROUVE  (tout est lu dans la ROM)
0BE084                   	; ---------------------------------------------------------------------------
0BE084                   	;
0BE084                   	; Deux crochets dans la zone de travail du BASIC, x = (baswrk) = (0D1h) :
0BE084                   	;
0BE084                   	;   [x+090h]   la table de mots-cles      (texte -> token)
0BE084                   	;   [x+093h]   la table de repartition    (token -> routine)
0BE084                   	;
0BE084                   	; La ROM y met 0FFFFFh au demarrage (SUB_F93C3) : la sentinelle "rien".
0BE084                   	;
0BE084                   	; La repartition se balaie par SUB_F593D (0F593Dh) : entrees de QUATRE octets,
0BE084                   	; token puis adresse, arret sur un token 000h.
0BE084                   	;
0BE084                   	; ⛔ ET LE QUARTET HAUT DU 3e OCTET D'ADRESSE EST UN DRAPEAU. Les deux
0BE084                   	;    resolveurs de la ROM sont cote a cote et ne different que par le bit :
0BE084                   	;
0BE084                   	;      0F58E5h  instruction : test a,080h -> routine = l'adresse telle quelle
0BE084                   	;      0F590Bh  FONCTION    : test a,040h -> routine = l'adresse + 3
0BE084                   	;
0BE084                   	;    PEEKX etant une fonction, on range donc (routine - 3) avec le bit 6 arme.
0BE084                   	;    Les trois octets sautes n'ont aucun sens : dans la ROM, ce sont ceux de la
0BE084                   	;    routine precedente. On y met trois zeros.
0BE084                   	;
0BE084                   	; ---------------------------------------------------------------------------
0BE084                   	; LE CORPS -- calque sur BAS_PEEK (0F9F44h), avec les entrees LOINTAINES
0BE084                   	; ---------------------------------------------------------------------------
0BE084                   	;
0BE084                   	; Une extension vit en page 0B, les services en 0E et 0F. Un service termine
0BE084                   	; par RET ne se laisse PAS appeler d'ici : son retour depile 2 octets et reste
0BE084                   	; dans SA page. Il faut donc, pour chaque service, l'entree qui finit par RETF.
0BE084                   	;
0BE084                   	;   BAS_PEEK fait            ici on fait              parce que
0BE084                   	;   -----------------------  -----------------------  ------------------------
0BE084                   	;   call SUB_F5F9C           callf 0EFBF3h            F5F9C finit par RET ;
0BE084                   	;                            puis callf 0EFAD4h       EFBF3 et EFAD4 par RETF.
0BE084                   	;                                                     F5F9C n'etait que
0BE084                   	;                                                     "callf EFBF3 + call
0BE084                   	;                                                     F5C9A", et F5C9A n'etait
0BE084                   	;                                                     que "callf EFAD4 + mv y".
0BE084                   	;   callf SUB_EFB6F          callf 0EFB6Fh            deja lointaine
0BE084                   	;
0BE084                   	; 0EFAD4h et 0EFB6Fh sont les commandes 07Eh et 07Fh du device 9 -- dec2bin et
0BE084                   	; bin2dec. Le travail sur la bibliotheque mathematique sert directement ici.
0BE084                   	;
0BE084                   	; ⛔ LE CADRE BP -- ET J'AI D'ABORD MAL LU SUB_F5C9A.
0BE084                   	;
0BE084                   	;    Elle se termine par "jr LOC_F5C6F", que je n'avais pas suivi. Or LOC_F5C6F
0BE084                   	;    fait "pmdf (bp_ram),00Fh" : BP + 15. Le compte, entree a sortie :
0BE084                   	;
0BE084                   	;      entree                          BP = B
0BE084                   	;      callf chknum                    BP = B-15   <- le cadre de la valeur
0BE084                   	;      SUB_F5C9A finit par +15         BP = B
0BE084                   	;      BAS_PEEK fait -15               BP = B-15   <- ou il ecrit son resultat
0BE084                   	;
0BE084                   	;    Ici on n'appelle pas F5C9A, donc on n'a PAS le +15 : apres chknum, BP vaut
0BE084                   	;    deja B-15, c'est-a-dire exactement le bon cadre. Il ne faut donc AUCUN
0BE084                   	;    pmdf sur le chemin de succes. La premiere version gardait le -15 de
0BE084                   	;    BAS_PEEK sans son +15 : elle ecrivait en B-30.
0BE084                   	;
0BE084                   	;    Sur le chemin d'ERREUR, en revanche, il faut le +15 : F5C9A le fait dans
0BE084                   	;    tous les cas, y compris son erreur 33 (LOC_F5C74 saute a LOC_F5C6F).
0BE084                   	;
0BE084                   	; ⛔ ET ON ECRIT (BP+n), PAS (000H). Sous pre_on, "(000H)" designe l'adresse
0BE084                   	;    DIRECTE 0 ; le mode (BP+n) est celui qui n'emet PAS d'octet PRE. Le
0BE084                   	;    controle se fait dans l'OBJET : sur ces lignes, BAS_PEEK ne porte aucun
0BE084                   	;    PRE (E0 05 01, CC 00 00, CD 02 00 00). Une premiere version de ce fichier
0BE084                   	;    portait "30 80 00" -- un PRE, donc l'adresse directe : la fonction lisait
0BE084                   	;    la RAM interne 0 au lieu du cadre de l'argument.
0BE084                   	;
0BE084                   	;       xasm2026-4 BASEXT.ASM -O -L -S -B -K
0BE084                   	; ============================================================================
0BE084                   	; CE FICHIER EST AUSSI INCLUS PAR C:\Claude\BASEXT-DRV (BASEXT residant dans un
0BE084                   	; bloc de pilote de S1:). Le pilote pose « def basext_pilote » puis fait
0BE084                   	; « include ..\..\BASEXT\src\BASEXT.ASM » : l'include de pce500.inc, l'org et
0BE084                   	; le pre_on ci-dessous sont alors les SIENS, et le corps est assemble a sa place
0BE084                   	; dans le bloc. Le module autonome, lui, ne definit rien et reste identique a
0BE084                   	; l'octet (verifie le 2026-09-16 : .OBJ inchange).
0BE084                   	;
0BE084                   	;    ⚠️ Le pilote RELOGE ce corps : sa table de relocation est mesuree par
0BE084                   	;       double assemblage (BASEXT-DRV/outils/reloc.py). Deux regles en
0BE084                   	;       decoulent pour tout ajout ici :
0BE084                   	;       - aucun octet ne doit dependre de l'adresse autrement que par un champ
0BE084                   	;         de 2 ou 3 octets (un « db etiquette/256 » isole est refuse) ;
0BE084                   	;       - aucun « assert » sur une adresse ABSOLUE (il echouerait aux autres
0BE084                   	;         origines) : ecrire les assertions en differences d'etiquettes.
0BE084                   	;
0BE084                   	;    ⛔ IFNDEF teste un symbole pose par DEF, PAS par EQU : un
0BE084                   	;       « basext_pilote: equ 1 » ne masque rien (mesure le 2026-09-16).
0BE084                   	; ============================================================================
0BE084                   	
0BE084                   	
0BE084                   	; --- les entrees LOINTAINES de la ROM (toutes terminees par RETF) -----------
0BE084                   	chknum:   equ   0EFBF3H    ; evalue l'expression numerique, verifie le type
0BE084                   	dec2bin:  equ   0EFAD4H    ; le nombre -> entier 24 bits en (bp+1)..(bp+3)
0BE084                   	bin2dec:  equ   0EFB6FH    ; l'entier de (bp+0)..(bp+3) -> nombre BASIC
0BE084                   	
0BE084                   	; ⛔ DEUX EVALUATEURS, ET ILS NE LISENT PAS LA MEME CHOSE.
0BE084                   	;    chknum (0EFBF3h) ne lit qu'UN TERME : un nombre, une variable, un appel de
0BE084                   	;    fonction, ou une expression entre parentheses -- mais il s'arrete au premier
0BE084                   	;    OPERATEUR. C'est ce que PEEK emploie (0F5F9Ch), et c'est pourquoi
0BE084                   	;    « PEEK &BFD1C*&100 » se lit « (PEEK &BFD1C)*&100 ».
0BE084                   	;    eval (0EF26Eh) evalue une EXPRESSION COMPLETE, operateurs compris. C'est ce
0BE084                   	;    qu'emploie POINT (x,y), via SUB_F5F65 en 0F5F65h -- et la reconnaissance des
0BE084                   	;    operateurs AND/OR/XOR est cablee juste a cote, en 0EF2C5h. Douze sites de la
0BE084                   	;    ROM l'appellent par « callf ».
0BE084                   	;
0BE084                   	;    MOD emprunte sa syntaxe a POINT : il lui faut donc le second, et LPEEK garde
0BE084                   	;    le premier puisqu'il est calque sur PEEK. Mesure sur machine avant la
0BE084                   	;    correction : MOD (17,5) et MOD (A,B) passaient, mais MOD (A+1,B) et
0BE084                   	;    MOD (I*3571,997) rendaient une erreur -- chknum lisait « A », puis butait
0BE084                   	;    sur le « + ».
0BE084                   	;
0BE084                   	;    ⚠️ eval ne signale PAS lui-meme le type : ses appelants de la ROM font le
0BE084                   	;    « test (000h),080h » a sa suite (0F5F6Bh). On fait de meme.
0BE084                   	eval:     equ   0EF26EH    ; expression numerique complete -> (bp+0)
0BE084                   	
0BE084                   	
0BE084                   	tk_lp:    equ   007H       ; LPEEK -- libre dans la table de la ROM
0BE084                   	tk_wp:    equ   00AH       ; WPEEK -- libre aussi (BASCOM occupe 04-06)
0BE084                   	tk_lpo:   equ   00EH       ; LPOKE -- libre
0BE084                   	tk_mod:   equ   00FH       ; MOD   -- libre
0BE084                   	tk_uc:    equ   0C6H       ; UCASE$ (fonctions chaine ajoutees)
0BE084                   	tk_lc:    equ   0C7H       ; LCASE$
0BE084                   	tk_tr:    equ   0C3H       ; TRIM$
0BE084                   	tk_lt:    equ   0C4H       ; LTRIM$
0BE084                   	tk_rt:    equ   0C5H       ; RTRIM$
0BE084                   	tk_rp:    equ   0C8H       ; REPT$
0BE084                   	tk_sr:    equ   0C9H       ; SREPT$
0BE084                   	tk_in:    equ   0C2H       ; INSTR (rend un NOMBRE)
0BE084                   	tk_xc:    equ   0CAH       ; XCONSOLE (instruction) -- libre, hors BASCOM (CB-CE)
0BE084                   	tk_xcl:   equ   0CFH       ; XCLS     (instruction) -- libre, hors BASCOM
0BE084                   	tk_dw:    equ   0D3H       ; DWGL     (instruction) -- libre, hors BASCOM (CB-CE)
0BE084                   	fhandle:  equ   0BFC6DH    ; FHANDLE : handle -> numero de bloc de controle
0BE084                   	                          ; (absent de pce500.inc ; lu par 0E06A1h)
0BE084                   	alloc:    equ   0EF0DDH    ; reserve BA octets sur U (U -= BA) ; carry = erreur 54
0BE084                   	
0BE084                   	
0BE084                   	; ⛔ NE PAS ECRIRE « baswrk » ICI. C'est la ZONE de travail, en memoire EXTERNE
0BE084                   	;    (0BFD0Eh) -- nom repris du listing de E. Kako, ou il est declare
0BE084                   	;    « baswrk: equ 0bfd0eh ». Le pointeur qu'il nous faut est en RAM INTERNE, a
0BE084                   	;    0D1h, que le carnet nommait « baswrk » lui aussi jusqu'au 2026-09-03 et
0BE084                   	;    nomme desormais « basptr ». Depuis, pce500.inc EXPOSE les deux et le
0BE084                   	;    generateur REFUSE une collision de noms : il n'y a plus d'equ local ici.
0BE084                   	;    Et « mv x,(baswrk) » ne proteste pas : l'operande interne fait 8 bits, XASM
0BE084                   	;    TRONQUE 0BFD0Eh en 0Eh. Le code ecrivait donc les crochets en
0BE084                   	;    [(00Eh)+090h], et la table d'extension n'a jamais ete installee.
0BE084                   	;    Verifiable dans l'objet : on doit lire « 30 84 D1 », pas « 30 84 0E ».
0BE084                   	err_syn:  equ   00AH       ; erreur BASIC 10, Syntax error
0BE084                   	err_range: equ  021H       ; erreur BASIC 33, Data out of range
0BE084                   	err_type: equ   05AH       ; erreur BASIC 90, Type mismatch -- le code que
0BE084                   	                          ; chknum emploie lui-meme (0EFC04h)
0BE084                   	err_buf:  equ   036H       ; erreur BASIC 54, Buffer space exceeded
0BE084                   	dw_lmax:  equ   02FH       ; DWGL : longueur maxi de la chaine (47), tampon 48
0BE084                   	err_div:  equ   015H       ; erreur BASIC 21, Division by zero -- le code
0BE084                   	                          ; que la ROM elle-meme emploie, lu en 0ECD67h
0BE084                   	
0BE084                   	
0BE084                   	; ============================================================================
0BE084                   	; L'INSTALLATION -- c'est ici que mene CALL &BF000
0BE084                   	; ============================================================================
0BE084                   	start:
0BE084 2C                	        pushu   x               ; X porte le point de reprise de l'interpreteur
0BE085 2B                	        pushu   i
0BE086                   	; ⚠️ Un filtre d'une version PRECEDENTE du module peut rester branche sur le
0BE086                   	;    handle 0 (voir XCONSOLE) : ses adresses ne valent plus rien. On le
0BE086                   	;    debranche avant tout, en rendant l'entree d'origine du pilote.
0BE086 04 37 EA          	        call    xf_off
0BE089 30 84 D1          	        mv      x,(basptr)
0BE08C                   	
0BE08C                   	; ⛔ NE SAUVER LES CROCHETS QUE S'ILS SONT ENCORE CEUX DE LA ROM.
0BE08C                   	;    Une premiere version sauvait sans regarder : au SECOND CALL &BF000 elle
0BE08C                   	;    ecrasait old_kw et old_disp avec NOS PROPRES tables, et les valeurs
0BE08C                   	;    d'origine etaient perdues -- la desinstallation avec. Constate sur machine
0BE08C                   	;    le 2026-09-05 : le vidage montrait old_kw = 0BF1B1h et old_disp = 0BF1CCh,
0BE08C                   	;    c'est-a-dire kw_table et disp_table de ce module.
0BE08C                   	;
0BE08C                   	;    ⛔ ET LA RAISON N'EST PAS CELLE QUE J'AVAIS ECRITE. J'avais justifie le
0BE08C                   	;    test par « les tables du BASIC vivent en page 0F ». C'est faux : le crochet
0BE08C                   	;    ne pointe JAMAIS sur la table de la ROM. La ROM y ecrit une SENTINELLE,
0BE08C                   	;    0FFFFFh, et cela se lit en 0F93C3h :
0BE08C                   	;
0BE08C                   	;       mv  x,(basptr)
0BE08C                   	;       mv  y,0FFFFFh
0BE08C                   	;       mv  [x+090h],y
0BE08C                   	;       mv  [x+093h],y
0BE08C                   	;
0BE08C                   	;    L'octet de poids fort d'un crochet vierge vaut donc 0Fh, et le test le
0BE08C                   	;    reconnait -- mais ce qu'il reconnait est la sentinelle, pas une table. Une
0BE08C                   	;    extension, elle, vit en RAM, page 0B : son crochet ne peut pas valoir 0Fh.
0BE08C                   	;    Le test est donc juste, et il l'est desormais pour la bonne raison.
0BE08C                   	;
0BE08C                   	;    ⚠️ Il pourrait etre plus strict : comparer les TROIS octets a 0FFFFFh plutot
0BE08C                   	;    que le seul poids fort. En l'etat il accepterait n'importe quel 0Fxxxxh, ce
0BE08C                   	;    qu'aucune extension ne peut produire -- mais la ROM le pourrait un jour.
0BE08C                   	;
0BE08C                   	;    ⚠️ Et il n'y a PAS de chainage : un second module ecraserait le premier.
0BE08C                   	;    Refuser d'ecraser la sauvegarde est donc la seule conduite sensee.
0BE08C 90 84 92          	        mv      a,[x+092H]      ; poids fort du crochet des mots-cles
0BE08F 60 0F             	        cmp     a,00FH          ; encore la table de la ROM ?
0BE091 1A 0E             	        jrnz    deja_ext        ; non : ne rien ecraser
0BE093 95 84 90          	        mv      y,[x+090H]      ; l'ancienne table de mots-cles
0BE096 AD 3F EC 0B       	        mv      [old_kw],y      ;   sauvee : de quoi desinstaller
0BE09A 95 84 93          	        mv      y,[x+093H]      ; l'ancienne table de repartition
0BE09D AD 42 EC 0B       	        mv      [old_disp],y
0BE0A1                   	deja_ext:
0BE0A1 0D 59 EA 0B       	        mv      y,kw_table
0BE0A5 B5 84 90          	        mv      [x+090H],y
0BE0A8 0D C7 EA 0B       	        mv      y,disp_table
0BE0AC B5 84 93          	        mv      [x+093H],y
0BE0AF 3B                	        popu    i
0BE0B0 3C                	        popu    x
0BE0B1 9F                	        rc                      ; carry CLAIR : retour propre a BASIC
0BE0B2 07                	        retf
0BE0B3                   	
0BE0B3                   	; ============================================================================
0BE0B3                   	; LA FONCTION -- l'interpreteur y saute a lpeek_m3 + 3
0BE0B3                   	; ============================================================================
0BE0B3                   	lpeek_m3:
0BE0B3 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BE0B6                   	
0BE0B6                   	lpeek:
0BE0B6 05 F3 FB 0E       	        callf   chknum          ; l'argument -> cadre pousse, nombre en (bp+0)
0BE0BA 1C 27             	        jrc     dehors          ; X n'est pas encore sauve : rien a rendre
0BE0BC 05 D4 FA 0E       	        callf   dec2bin         ; -> entier 24 bits en (bp+1)..(bp+3)
0BE0C0 1C 21             	        jrc     dehors
0BE0C2 80 00             	        mv      a,(BP+0)        ; (bp+0) : bit 3 = signe
0BE0C4 64 08             	        test    a,008H
0BE0C6 1A 1C             	        jrnz    refus           ; adresse negative
0BE0C8 80 03             	        mv      a,(BP+3)        ; l'octet de poids fort du 24 bits
0BE0CA 60 10             	        cmp     a,010H
0BE0CC 1E 16             	        jrnc    refus           ; au-dela de 0FFFFFh : hors de l'espace
0BE0CE                   	
0BE0CE                   	; ⛔ X PORTE LE POINT DE REPRISE, ET bin2dec L'ECRASE.
0BE0CE                   	;    chknum a fait AVANCER X au-dela de l'argument : c'est cette valeur-la que
0BE0CE                   	;    l'interpreteur attend au retour. On la sauve donc APRES chknum, jamais
0BE0CE                   	;    avant -- exactement ou BAS_PEEK place son pushu (0F9F49h).
0BE0CE                   	;    L'oubli ne plante pas : le nom est reconnu, la fonction s'execute, et
0BE0CE                   	;    l'interpreteur reprend n'importe ou -- "Syntax error" sans autre indice.
0BE0CE 2C                	        pushu   x
0BE0CF                   	
0BE0CF 85 01             	        mv      y,(BP+1)        ; l'adresse demandee
0BE0D1 E2 05 01          	        mvp     (BP+1),[y]      ; les TROIS octets a cette adresse
0BE0D4                   	
0BE0D4                   	; ⛔ bin2dec NE CONVERTIT QUE 20 BITS, et c'est lu dans son code (0EFB8Bh) :
0BE0D4                   	;    trois passes de decalage, 8 bits sur (bp+11), 8 sur (bp+12), puis
0BE0D4                   	;    QUATRE seulement sur (bp+13) -- « mv (00Eh),004h ». 8+8+4 = 20. Le quartet
0BE0D4                   	;    haut du troisieme octet est ignore par construction : c'est un convertisseur
0BE0D4                   	;    d'ADRESSE, et une adresse fait 20 bits sur cette machine.
0BE0D4                   	;    Mesure : &345678 revenait en &045678, sans que rien ne le signale.
0BE0D4                   	;    On REFUSE donc plutot que de mentir -- une valeur fausse en silence est
0BE0D4                   	;    pire qu'une erreur.
0BE0D4 80 03             	        mv      a,(BP+3)
0BE0D6 70 F0             	        and     a,0F0H
0BE0D8 1A 12             	        jrnz    hors_plage      ; quartet haut non nul : bin2dec le perdrait
0BE0DA                   	
0BE0DA CC 00 00          	        mv      (BP+0),000H     ; positif, simple precision
0BE0DD 05 6F FB 0E       	        callf   bin2dec         ; -> nombre BASIC en (bp+0)
0BE0E1 9F                	        rc
0BE0E2 3C                	        popu    x               ; rendre son point de reprise a l'interpreteur
0BE0E3                   	dehors:
0BE0E3 07                	        retf
0BE0E4                   	
0BE0E4                   	refus:
0BE0E4 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; +15 : rendre BP comme le fait SUB_F5C9A
0BE0E8 08 0A             	        mv      a,err_syn
0BE0EA 97                	        sc
0BE0EB 07                	        retf
0BE0EC                   	
0BE0EC                   	; La valeur lue depasse 20 bits : erreur 33, celle que SUB_F5C9A emploie pour
0BE0EC                   	; le meme cas. X a ete sauve, il faut le rendre.
0BE0EC                   	hors_plage:
0BE0EC 3C                	        popu    x
0BE0ED 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BE0F1 08 21             	        mv      a,err_range
0BE0F3 97                	        sc
0BE0F4 07                	        retf
0BE0F5                   	
0BE0F5                   	; ============================================================================
0BE0F5                   	; LA SECONDE FONCTION -- WPEEK, deux octets au lieu de trois
0BE0F5                   	; ============================================================================
0BE0F5                   	; Meme structure exactement. Elle n'existe que pour eprouver l'ENCHAINEMENT :
0BE0F5                   	; nos deux tables n'avaient jamais porte qu'une seule entree, donc ni le
0BE0F5                   	; balayage de SUB_F593D (« add y,004h » en boucle) ni celui du tokeniseur
0BE0F5                   	; n'etaient exerces. Deux entrees suffisent a les mettre en defaut s'ils le
0BE0F5                   	; sont -- et a montrer qu'aucune adresse n'en ecrase une autre.
0BE0F5                   	;
0BE0F5                   	; WPEEK n'a pas besoin du garde-fou des 20 bits : deux octets tiennent
0BE0F5                   	; toujours dedans.
0BE0F5                   	
0BE0F5                   	wpeek_m3:
0BE0F5 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BE0F8                   	
0BE0F8                   	wpeek:
0BE0F8 05 F3 FB 0E       	        callf   chknum
0BE0FC 1C 24             	        jrc     dehors2
0BE0FE 05 D4 FA 0E       	        callf   dec2bin
0BE102 1C 1E             	        jrc     dehors2
0BE104 80 00             	        mv      a,(BP+0)
0BE106 64 08             	        test    a,008H
0BE108 1A 19             	        jrnz    refus2
0BE10A 80 03             	        mv      a,(BP+3)
0BE10C 60 10             	        cmp     a,010H
0BE10E 1E 13             	        jrnc    refus2
0BE110 2C                	        pushu   x
0BE111 85 01             	        mv      y,(BP+1)
0BE113                   	; ⛔ mvw, PAS mv. Les trois largeurs sont mv (1 octet), mvw (2) et mvp (3) --
0BE113                   	;    « mv » ne transfere QU'UN octet, et un commentaire disant « deux octets :
0BE113                   	;    mv, pas mvp » ne le rend pas vrai. Mesure : WPEEK rendait F178 et F1B8,
0BE113                   	;    l'octet bas juste et l'octet haut jamais ecrit, donc laisse a sa valeur
0BE113                   	;    precedente -- F1 les deux fois.
0BE113 E1 05 01          	        mvw     (BP+1),[y]      ; DEUX octets
0BE116 CC 03 00          	        mv      (BP+3),000H     ; le troisieme reste nul
0BE119 CC 00 00          	        mv      (BP+0),000H
0BE11C 05 6F FB 0E       	        callf   bin2dec
0BE120 9F                	        rc
0BE121 3C                	        popu    x
0BE122                   	dehors2:
0BE122 07                	        retf
0BE123                   	
0BE123                   	refus2:
0BE123 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BE127 08 0A             	        mv      a,err_syn
0BE129 97                	        sc
0BE12A 07                	        retf
0BE12B                   	
0BE12B                   	; ============================================================================
0BE12B                   	; L'INSTRUCTION LPOKE destination,valeur1,valeur2,...
0BE12B                   	; ============================================================================
0BE12B                   	; Ecrit chaque valeur sur TROIS octets, en ordre petit-boutien, a des adresses
0BE12B                   	; consecutives :
0BE12B                   	;
0BE12B                   	;   LPOKE &BF000,&123456,&789ABC   met 56 34 12 en &BF000
0BE12B                   	;                                  puis BC 9A 78 en &BF003
0BE12B                   	;
0BE12B                   	; C'est le pendant de LPEEK, et il comble un manque reel : ces pointeurs de
0BE12B                   	; trois octets se decomposaient jusqu'ici a la main, cote BASIC --
0BE12B                   	;   AH=INT (AD/&10000):AM=INT ((AD-AH*&10000)/&100):AL=AD-AH*&10000-AM*&100
0BE12B                   	;   POKE dest,AL,AM,AH
0BE12B                   	;
0BE12B                   	; ⛔ C'EST UNE INSTRUCTION, PAS UNE FONCTION. Le resolveur de la ROM n'est donc
0BE12B                   	;    pas le meme : 0F58E5h teste le bit 7 et prend l'adresse TELLE QUELLE, la ou
0BE12B                   	;    0F590Bh teste le bit 6 et ajoute 3. L'entree de repartition porte donc 080h
0BE12B                   	;    et il n'y a PAS de prefixe de trois octets devant le point d'entree.
0BE12B                   	;
0BE12B                   	; ⛔ LA BOUCLE EST CELLE DE BAS_POKE (0F9F27h), Y COMPRIS SA SORTIE.
0BE12B                   	;    On lit un caractere, on le compare a 02Ch ; si ce n'est pas une virgule, on
0BE12B                   	;    rend la main -- mais en REMETTANT le caractere par un « dec x ». La ROM le
0BE12B                   	;    fait par une chute : son « rc » de 0F9F2Fh tombe dans le « dec x » de
0BE12B                   	;    0F9F30h, partage avec le chemin d'erreur. On copie cette disposition.
0BE12B                   	;
0BE12B                   	; ⛔ ET CHAQUE chknum PREND UN CADRE DE 15 OCTETS, QU'IL FAUT RENDRE.
0BE12B                   	;    LPEEK n'appelle chknum qu'une fois et n'a donc jamais eu a s'en soucier.
0BE12B                   	;    Ici la boucle en appelle un par valeur : sans le « pmdf +15 » apres chacune,
0BE12B                   	;    les cadres s'empilent et BP finit par sortir de sa zone. Le compte doit
0BE12B                   	;    revenir a zero sur TOUS les chemins, erreurs comprises.
0BE12B                   	;
0BE12B                   	; ⛔ PORTEE DES VALEURS : 20 BITS, ET C'EST dec2bin QUI L'IMPOSE.
0BE12B                   	;    Son code (0EFB8Bh) ne convertit que 8+8+4 bits -- constate en ecrivant
0BE12B                   	;    LPEEK. Une valeur au-dela de 0FFFFFh serait donc tronquee AVANT de nous
0BE12B                   	;    parvenir, sans que rien ne le signale et sans que nous puissions le
0BE12B                   	;    detecter apres coup. Sans consequence pour l'usage vise, une adresse de
0BE12B                   	;    cette machine faisant 20 bits, mais cela doit etre dit.
0BE12B                   	
0BE12B                   	lpoke:
0BE12B 05 F3 FB 0E       	        callf   chknum          ; l'adresse de destination
0BE12F 1C 42             	        jrc     lp_ret          ; chknum a echoue : il n'a pas pris de cadre
0BE131 05 D4 FA 0E       	        callf   dec2bin
0BE135 1C 3C             	        jrc     lp_ret
0BE137 80 00             	        mv      a,(BP+0)        ; bit 3 = signe
0BE139 64 08             	        test    a,008H
0BE13B 1A 37             	        jrnz    lp_syn
0BE13D 80 03             	        mv      a,(BP+3)
0BE13F 60 10             	        cmp     a,010H
0BE141 1E 31             	        jrnc    lp_syn          ; au-dela de 0FFFFFh
0BE143 85 01             	        mv      y,(BP+1)        ; Y = la destination
0BE145 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; rendre le cadre de la destination
0BE149                   	
0BE149                   	lp_next:
0BE149 90 24             	        mv      a,[x++]
0BE14B 60 2C             	        cmp     a,02CH          ; ','
0BE14D 1A 21             	        jrnz    lp_done         ; plus de virgule : c'est fini
0BE14F 2D                	        pushu   y               ; la destination, que chknum n'a pas a connaitre
0BE150 05 F3 FB 0E       	        callf   chknum          ; la valeur
0BE154 1C 26             	        jrc     lp_pop
0BE156 05 D4 FA 0E       	        callf   dec2bin
0BE15A 1C 20             	        jrc     lp_pop
0BE15C 80 00             	        mv      a,(BP+0)
0BE15E 64 08             	        test    a,008H
0BE160 1A 1C             	        jrnz    lp_popsyn       ; valeur negative
0BE162 3D                	        popu    y
0BE163 EA 05 01          	        mvp     [y],(BP+1)      ; les TROIS octets, petit-boutien
0BE166 08 03             	        mv      a,003H
0BE168 45 50             	        add     y,a             ; adresse suivante
0BE16A 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; rendre le cadre de la valeur
0BE16E 13 27             	        jr      lp_next
0BE170                   	
0BE170                   	; --- sortie ----------------------------------------------------------------
0BE170                   	; « rc » tombe dans « dec x » : la disposition de BAS_POKE, ou le chemin de
0BE170                   	; succes et celui d'erreur partagent la remise en place du caractere.
0BE170                   	lp_done:
0BE170 9F                	        rc
0BE171                   	lp_back:
0BE171 7C 04             	        dec     x               ; rendre le caractere qui n'etait pas une virgule
0BE173                   	lp_ret:
0BE173 07                	        retf
0BE174                   	
0BE174                   	lp_syn:
0BE174 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BE178 08 0A             	        mv      a,err_syn
0BE17A 97                	        sc
0BE17B 07                	        retf
0BE17C                   	
0BE17C                   	; chknum ou dec2bin a echoue alors que Y etait empile : le depiler, et ne PAS
0BE17C                   	; rendre de cadre -- chknum n'en a pas pris.
0BE17C                   	lp_pop:
0BE17C 3D                	        popu    y
0BE17D 07                	        retf
0BE17E                   	
0BE17E                   	lp_popsyn:
0BE17E 3D                	        popu    y
0BE17F 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BE183 08 0A             	        mv      a,err_syn
0BE185 97                	        sc
0BE186 07                	        retf
0BE187                   	
0BE187                   	; ============================================================================
0BE187                   	; LA FONCTION MOD (A,B) -- le reste de la division entiere
0BE187                   	; ============================================================================
0BE187                   	; L'interpreteur y saute a modu_m3 + 3 : c'est une FONCTION (drapeau 040h).
0BE187                   	;
0BE187                   	;   PRINT MOD (17,5)      2
0BE187                   	;   R = MOD (A,B)
0BE187                   	;
0BE187                   	; ⛔ PAS D'INFIXE POSSIBLE. « A MOD B » est hors d'atteinte : la reconnaissance
0BE187                   	;    des operateurs est CABLEE EN DUR dans l'analyseur d'expression, en 0EF2C5h,
0BE187                   	;    par trois comparaisons litterales contre 0A1h (AND), 0A2h (OR) et 0A5h
0BE187                   	;    (XOR) -- ni table, ni plage, et nos deux crochets n'y donnent pas acces.
0BE187                   	;    La syntaxe est donc celle de POINT (x,y), que la machine possede deja.
0BE187                   	;
0BE187                   	; ⛔ ET LE CALCUL N'EMPRUNTE RIEN A LA BIBLIOTHEQUE FLOTTANTE DE LA ROM. Deux
0BE187                   	;    versions ont essaye de calculer A - B * INT (A/B) par les commandes du
0BE187                   	;    device 9 ; les deux ont plante la machine (CLS puis MENU principal), et la
0BE187                   	;    seconde alors meme que ses cinq adresses etaient JUSTES -- verifiees une a
0BE187                   	;    une dans la table de repartition DB_EF078 du driver drv_function :
0BE187                   	;
0BE187                   	;      047h add 0ECBA9h   048h sub 0ECBB4h   049h mul 0ECBBFh
0BE187                   	;      04Ah div 0ECBD8h   056h int 0EE4D5h
0BE187                   	;
0BE187                   	;    Ce que ces adresses ne disent pas, c'est le CONTRAT. Il y a deux diviseurs
0BE187                   	;    (SUB_ECCEA et SUB_ECD85), l'entree 04Ah ne mene qu'au second, et le seul
0BE187                   	;    appelant connu de la ROM -- l'evaluateur d'expression en 0E8559h -- fait
0BE187                   	;    « mv i,0000Fh / exl (000h),(00Fh) » AVANT d'appeler : il ECHANGE X et Y,
0BE187                   	;    ce que ne fait aucune des trois autres operations.
0BE187                   	;
0BE187                   	;    Le calcul est donc fait ici, en binaire, et ne s'appuie que sur des
0BE187                   	;    primitives EPROUVEES SUR LA MACHINE par LPEEK et LPOKE : chknum, dec2bin,
0BE187                   	;    bin2dec.
0BE187                   	;
0BE187                   	; ⛔ ET ON NE SUPPOSE RIEN DE CE QUE chknum FAIT DE BP. Une premiere version
0BE187                   	;    binaire tenait pour acquis qu'un chknum EMPILE un cadre de 15 octets, donc
0BE187                   	;    qu'apres le second appel le premier operande se lisait en (bp+16)..(bp+18).
0BE187                   	;    Je l'avais deduit d'un enchainement de la ROM en 0ECBCAh -- une inference,
0BE187                   	;    pas une mesure. LA MACHINE L'A DEMENTIE : elle rendait 0 pour toutes les
0BE187                   	;    valeurs, ce qui est la signature d'un A perdu (0 mod B, ou B mod B).
0BE187                   	;
0BE187                   	;    Plutot que de deviner une troisieme fois la taille et le sens du cadre,
0BE187                   	;    cette version REND LA QUESTION SANS OBJET :
0BE187                   	;      . le premier operande est mis a l'abri en RAM du module (sv_a) des que
0BE187                   	;        dec2bin l'a converti, donc avant que le second chknum ne puisse rien
0BE187                   	;        ecraser ;
0BE187                   	;      . BP est SAUVE et RESTAURE en absolu (sv_bp0, sv_bp1) au lieu d'etre
0BE187                   	;        rattrape par des pmdf comptes a la main.
0BE187                   	;    Le module se comporte alors exactement comme LPEEK, qui lui fonctionne :
0BE187                   	;    resultat en (bp+0)..(bp+3), BP tel qu'il etait apres LE PREMIER chknum.
0BE187                   	;    Que chknum empile 15 octets, 8, ou rien du tout, le resultat est le meme.
0BE187                   	;
0BE187                   	; LE DOMAINE : A et B sont des ENTIERS de 0 a 1048575, celui de LPEEK et de
0BE187                   	; LPOKE. La borne n'est pas un choix mais une mesure : dec2bin accumule dans X,
0BE187                   	; registre de 20 bits, et REFUSE lui-meme au-dela (« add x,a / jrc » en
0BE187                   	; 0EFAFBh, puis erreur 33) -- c'est donc la ROM, et non nous, qui signale un
0BE187                   	; operande trop grand. Un operande negatif est refuse ici : dec2bin en rend la
0BE187                   	; valeur absolue en laissant le signe dans le bit 3 de (bp+0), donc l'ignorer
0BE187                   	; rendrait un resultat faux en silence. Le reste etant toujours < B, il tient
0BE187                   	; toujours dans les 20 bits que bin2dec sait reconvertir.
0BE187                   	
0BE187                   	modu_m3:
0BE187 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BE18A                   	
0BE18A                   	modu:
0BE18A                   	; ⛔ LES PARENTHESES SONT OBLIGATOIRES, ET C'EST LA ROM QUI LE DIT.
0BE18A                   	;    SUB_FD5E7, le lecteur d'arguments de POINT (x,y), exige TROIS caracteres :
0BE18A                   	;    '(' en 0FD5ECh, ',' en 0FD5F9h et ')' en 0FD60Ah. Une premiere version de
0BE18A                   	;    cette fonction n'en verifiait qu'un : chknum recevait (17,5) tout entier et
0BE18A                   	;    tentait d'evaluer une expression parenthesee. PRINT MOD(17,5) repondait
0BE18A                   	;    Syntax error. Constate sur emulateur, corrige en relisant SUB_FD5E7.
0BE18A                   	md_sp:
0BE18A 90 24             	        mv      a,[x++]
0BE18C 60 20             	        cmp     a,020H          ; sauter les espaces -- ce que fait SUB_FB2D9
0BE18E 19 06             	        jrz     md_sp
0BE190 60 28             	        cmp     a,028H          ; '(' obligatoire
0BE192 1A 98             	        jrnz    md_syn0
0BE194                   	
0BE194                   	; BP a l'entree : l'etat a rendre si l'on doit signaler une erreur, puisque
0BE194                   	; c'est celui d'avant tout ce que nous avons pu prendre.
0BE194 30 D8 07 EB 0B EC 	        mv      [!sv_bp0],(bp_ram)
0BE19A                   	
0BE19A                   	; --- A, le dividende --------------------------------------------------------
0BE19A 05 6E F2 0E       	        callf   eval            ; expression complete -> (bp+0)
0BE19E 1C 8B             	        jrc     md_ret          ; echec : rien n'a ete pris
