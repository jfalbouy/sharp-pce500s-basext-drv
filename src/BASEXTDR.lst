0BE6B3                   	; ============================================================================
0BE6B3                   	; XCONSOLE [debut][,[nombre]]  --  la fenetre de la console (INSTRUCTION)
0BE6B3                   	; ============================================================================
0BE6B3                   	; Borne la console aux lignes debut .. debut+nombre-1 de l'ecran de 4 lignes.
0BE6B3                   	;
0BE6B3                   	;   XCONSOLE            0,4 : l'ecran entier, l'etat normal
0BE6B3                   	;   XCONSOLE ,2         lignes 0-1 ; les lignes 2-3 restent figees
0BE6B3                   	;   XCONSOLE 2          lignes 2-3 (le nombre omis va jusqu'en bas)
0BE6B3                   	;   XCONSOLE 1,2        lignes 1-2
0BE6B3                   	;
0BE6B3                   	; Refus : debut > 3, nombre nul, ou debut+nombre > 4 -> erreur 33 ; une chaine
0BE6B3                   	; -> erreur 90 ; un separateur autre que ',' -> erreur 10.
0BE6B3                   	;
0BE6B3                   	; LE LEVIER EST lcd_height (0BFC9Eh), ET NON LE CURSEUR 0BFC27h/0BFC28h.
0BE6B3                   	;    Le pilote d'ecran defile quand (bh) atteint lcd_height (0F2B6Ah), clear_disp
0BE6B3                   	;    n'efface que les lignes 0 .. lcd_height-1 (0F2771h), et LOCATE refuse un Y
0BE6B3                   	;    au-dela (0FC682h). ✅ Mesure sur machine par J.-F. Albouy : POKE &BFC9E,2
0BE6B3                   	;    confine affichage, defilement et CLS aux lignes 0-1, et CLS ne remet PAS la
0BE6B3                   	;    hauteur a 4.
0BE6B3                   	;
0BE6B3                   	; POUR debut > 0, LA ROM NE SUFFIT PLUS : son defilement part TOUJOURS de la
0BE6B3                   	;    ligne 0 (0F27F1h, recopie par 0F28E3h) et emporterait les lignes figees.
0BE6B3                   	;    XCONSOLE branche alors le FILTRE D'ECRITURE (xf_entry, plus bas) sur le
0BE6B3                   	;    handle 0, et l'en debranche quand debut revient a 0.
0BE6B3                   	;
0BE6B3                   	; ⛔ LA FENETRE SURVIT A LA FIN DU PROGRAMME. Mesure : l'invite du mode direct
0BE6B3                   	;    reste dans les lignes de la fenetre, et seul MENU puis BASIC rend l'ecran.
0BE6B3                   	;    Un programme doit donc finir par XCONSOLE (puis CLS) -- apres une erreur ou
0BE6B3                   	;    un BREAK, MENU puis BASIC.
0BE6B3                   	;
0BE6B3                   	; ⚠️ CLS AVEC UNE FENETRE DE MOINS DE 4 LIGNES AFFICHE LES LIBELLES DES TOUCHES
0BE6B3                   	;    DE FONCTION sur la ligne 3. C'est la ROM : CLS teste lcd_height (0F931Ah) et,
0BE6B3                   	;    s'il ne vaut pas 4, appelle fkey_display (commande 46h du clavier, 0F1CFAh),
0BE6B3                   	;    qui dessine les libelles par la commande 58h de l'ecran -- sans passer par le
0BE6B3                   	;    filtre. Constate sur machine, et deja avec un simple POKE &BFC9E,2. Dans une
0BE6B3                   	;    fenetre, effacer par XCLS ; pour tout effacer, XCONSOLE : CLS.
0BE6B3                   	;
0BE6B3                   	; La fin d'instruction est celle de 0F617Ch, que lisent CONSOLE et LOCATE :
0BE6B3                   	; ':' ou 0Dh, regardes sans etre consommes. Les espaces se sautent comme en
0BE6B3                   	; 0FB2D9h. BP est rendu en ABSOLU (sv_bp0) sur tous les chemins : une
0BE6B3                   	; instruction rend BP inchange (MODE-EMPLOI §6.1).
0BE6B3                   	xconsole:
0BE6B3 30 D8 07 EB 0B EC 	        mv      [!sv_bp0],(bp_ram)      ; BP d'entree
0BE6B9 08 00             	        mv      a,000H
0BE6BB A8 15 EB 0B       	        mv      [!xc_t],a               ; debut par defaut : 0
0BE6BF 08 FF             	        mv      a,0FFH
0BE6C1 A8 16 EB 0B       	        mv      [!xc_c],a               ; nombre : absent
0BE6C5 04 54 E7          	        call    xc_skip                 ; A = premier non-espace, X dessus
0BE6C8 60 3A             	        cmp     a,03AH                  ; ':'
0BE6CA 18 36             	        jrz     xc_apply
0BE6CC 60 0D             	        cmp     a,00DH                  ; fin de ligne
0BE6CE 18 32             	        jrz     xc_apply                ; XCONSOLE seul
0BE6D0 60 2C             	        cmp     a,02CH
0BE6D2 18 18             	        jrz     xc_comma                ; XCONSOLE ,n : debut omis
0BE6D4 04 5F E7          	        call    xc_num                  ; le debut
0BE6D7 1C 73             	        jrc     xc_err
0BE6D9 A8 15 EB 0B       	        mv      [!xc_t],a
0BE6DD 04 54 E7          	        call    xc_skip
0BE6E0 60 3A             	        cmp     a,03AH
0BE6E2 18 1E             	        jrz     xc_apply
0BE6E4 60 0D             	        cmp     a,00DH
0BE6E6 18 1A             	        jrz     xc_apply
0BE6E8 60 2C             	        cmp     a,02CH
0BE6EA 1A 5A             	        jrnz    xc_syn
0BE6EC                   	xc_comma:
0BE6EC 6C 04             	        inc     x                       ; consommer la virgule
0BE6EE 04 54 E7          	        call    xc_skip
0BE6F1 60 3A             	        cmp     a,03AH
0BE6F3 18 0D             	        jrz     xc_apply
0BE6F5 60 0D             	        cmp     a,00DH
0BE6F7 18 09             	        jrz     xc_apply                ; XCONSOLE d, : nombre omis
0BE6F9 04 5F E7          	        call    xc_num                  ; le nombre de lignes
0BE6FC 1C 4E             	        jrc     xc_err
0BE6FE A8 16 EB 0B       	        mv      [!xc_c],a
0BE702                   	
0BE702                   	xc_apply:
0BE702 88 15 EB 0B       	        mv      a,[!xc_t]
0BE706 60 04             	        cmp     a,004H
0BE708 1E 40             	        jrnc    xc_range                ; debut au-dela de la ligne 3
0BE70A FD 10             	        mv      il,a                    ; IL = debut
0BE70C 88 16 EB 0B       	        mv      a,[!xc_c]
0BE710 60 FF             	        cmp     a,0FFH
0BE712 18 0E             	        jrz     xc_full                 ; nombre omis : jusqu'en bas
0BE714 60 00             	        cmp     a,000H
0BE716 18 32             	        jrz     xc_range                ; une fenetre de zero ligne
0BE718 46 01             	        add     a,il                    ; A = debut + nombre = la hauteur
0BE71A 1C 2E             	        jrc     xc_range
0BE71C 60 05             	        cmp     a,005H
0BE71E 1E 2A             	        jrnc    xc_range                ; deborde sous la ligne 3
0BE720 12 02             	        jr      xc_store
0BE722                   	xc_full:
0BE722 08 04             	        mv      a,004H
0BE724                   	xc_store:
0BE724 A8 9E FC 0B       	        mv      [lcd_height],a
0BE728 A9 17 EB 0B       	        mv      [!xc_top],il            ; le debut, que XCLS et le filtre reliront
0BE72C 2C                	        pushu   x                       ; xf_on et xf_off se servent de X et de I
0BE72D 2B                	        pushu   i
0BE72E FD 01             	        mv      a,il
0BE730 60 00             	        cmp     a,000H
0BE732 18 05             	        jrz     xc_unhook
0BE734 04 1A EA          	        call    xf_on                   ; fenetre haute : le filtre est necessaire
0BE737 12 03             	        jr      xc_hooked
0BE739                   	xc_unhook:
0BE739 04 37 EA          	        call    xf_off                  ; debut 0 : la ROM suffit
0BE73C                   	xc_hooked:
0BE73C 3B                	        popu    i
0BE73D 3C                	        popu    x
0BE73E 30 D0 EC 07 EB 0B 	        mv      (bp_ram),[!sv_bp0]
0BE744 9F                	        rc
0BE745 07                	        retf
0BE746                   	
0BE746                   	xc_syn:
0BE746 08 0A             	        mv      a,err_syn
0BE748 12 02             	        jr      xc_err
0BE74A                   	xc_range:
0BE74A 08 21             	        mv      a,err_range
0BE74C                   	xc_err:
0BE74C 30 D0 EC 07 EB 0B 	        mv      (bp_ram),[!sv_bp0]
0BE752 97                	        sc
0BE753 07                	        retf
0BE754                   	
0BE754                   	; xc_skip -- saute les espaces ; X reste SUR le premier non-espace, rendu dans A.
0BE754                   	;            APPEL PROCHE.
0BE754                   	xc_skip:
0BE754 90 04             	        mv      a,[x]
0BE756 60 20             	        cmp     a,020H
0BE758 1A 04             	        jrnz    xs_ret
0BE75A 6C 04             	        inc     x
0BE75C 13 0A             	        jr      xc_skip
0BE75E                   	xs_ret:
0BE75E 06                	        ret
0BE75F                   	
0BE75F                   	; xc_num -- une expression numerique entiere de 0 a 255.
0BE75F                   	;           CY=0 : A = la valeur, BP rendu a sv_bp0.
0BE75F                   	;           CY=1 : A = code d'erreur, BP rendu a sv_bp0.  APPEL PROCHE.
0BE75F                   	xc_num:
0BE75F 05 6E F2 0E       	        callf   eval
0BE763 1C 26             	        jrc     xn_fail                 ; A porte deja le code
0BE765 65 00 80          	        test    (BP+0),080H
0BE768 1A 1B             	        jrnz    xn_type
0BE76A 05 D4 FA 0E       	        callf   dec2bin
0BE76E 1C 1B             	        jrc     xn_fail
0BE770 65 00 08          	        test    (BP+0),008H
0BE773 1A 14             	        jrnz    xn_range                ; negatif
0BE775 80 02             	        mv      a,(BP+2)
0BE777 7F 03             	        or      a,(BP+3)
0BE779 1A 0E             	        jrnz    xn_range                ; au-dela de 255
0BE77B 80 01             	        mv      a,(BP+1)
0BE77D 30 D0 EC 07 EB 0B 	        mv      (bp_ram),[!sv_bp0]      ; rendre le cadre d'eval
0BE783 9F                	        rc
0BE784 06                	        ret
0BE785                   	xn_type:
0BE785 08 5A             	        mv      a,err_type
0BE787 12 02             	        jr      xn_fail
0BE789                   	xn_range:
0BE789 08 21             	        mv      a,err_range
0BE78B                   	xn_fail:
0BE78B 30 D0 EC 07 EB 0B 	        mv      (bp_ram),[!sv_bp0]
0BE791 97                	        sc
0BE792 06                	        ret
0BE793                   	
0BE793                   	; ============================================================================
0BE793                   	; XCLS  --  efface la fenetre de XCONSOLE (INSTRUCTION)
0BE793                   	; ============================================================================
0BE793                   	; Pendant de CLS, qui reste celui de la ROM et efface les lignes 0 ..
0BE793                   	; lcd_height-1, lignes figees comprises. XCLS n'efface que xc_top ..
0BE793                   	; lcd_height-1 et place le curseur en (0,xc_top).
0BE793                   	;
0BE793                   	; Calque sur 0F9307h, la fin de CLS, avec les commandes documentees du device 0 :
0BE793                   	;   CLS  : 51h clear_disp            / 45h cursor_type, BA=0 / curseur (0,0)
0BE793                   	;   XCLS : 49h clear_line par ligne  / 45h cursor_type, BA=0 / curseur (0,xc_top)
0BE793                   	; et, comme CLS (0F9367h), les bits 0-1 de [(basptr)+070h] remis a zero --
0BE793                   	; ceux que LOCATE arme (0FC698h).
0BE793                   	;
0BE793                   	; La hauteur est RELUE dans lcd_height a chaque appel, et non memorisee : si
0BE793                   	; l'editeur l'a changee, XCLS suit la ROM au lieu de la contredire.
0BE793                   	xcls:
0BE793 2C                	        pushu   x                       ; le point de reprise
0BE794 2B                	        pushu   i
0BE795 88 17 EB 0B       	        mv      a,[!xc_top]
0BE799 A8 18 EB 0B       	        mv      [!xcl_y],a
0BE79D                   	xl_loop:
0BE79D 88 18 EB 0B       	        mv      a,[!xcl_y]
0BE7A1 30 A0 D5          	        mv      (bh),a                  ; ordonnee de la ligne (argument de 49h)
0BE7A4 88 9E FC 0B       	        mv      a,[lcd_height]
0BE7A8 30 63 D5          	        cmp     (bh),a                  ; ligne - hauteur : NC = hors fenetre
0BE7AB 1E 17             	        jrnc    xl_done
0BE7AD 30 CD D6 00 00    	        mvw     (cl),00000H             ; device 0, lecteur 0
0BE7B2 09 49             	        mv      il,d0_clear_line
0BE7B4 05 E8 FF 0F       	        callf   iocs_call
0BE7B8 88 18 EB 0B       	        mv      a,[!xcl_y]
0BE7BC 6C 00             	        inc     a
0BE7BE A8 18 EB 0B       	        mv      [!xcl_y],a
0BE7C2 13 27             	        jr      xl_loop
0BE7C4                   	xl_done:
0BE7C4 09 45             	        mv      il,d0_cursor_type
0BE7C6 4C 22             	        sub     ba,ba                   ; pas de curseur, comme 0F930Eh
0BE7C8 30 CD D6 00 00    	        mvw     (cl),00000H
0BE7CD 05 E8 FF 0F       	        callf   iocs_call
0BE7D1 08 00             	        mv      a,000H
0BE7D3 A8 27 FC 0B       	        mv      [scrn_crsr_x],a
0BE7D7 88 17 EB 0B       	        mv      a,[!xc_top]
0BE7DB A8 28 FC 0B       	        mv      [scrn_crsr_y],a
0BE7DF 30 84 D1          	        mv      x,(basptr)
0BE7E2 90 84 70          	        mv      a,[x+070H]
0BE7E5 70 FC             	        and     a,0FCH                  ; les bits de LOCATE, comme CLS
0BE7E7 B0 84 70          	        mv      [x+070H],a
0BE7EA 3B                	        popu    i
0BE7EB 3C                	        popu    x
0BE7EC 9F                	        rc
0BE7ED 07                	        retf
0BE7EE                   	
0BE7EE                   	; ============================================================================
0BE7EE                   	; L'INSTRUCTION DWGL colonne,ligne,tag,chaine$  --  la barre de cases
0BE7EE                   	; ============================================================================
0BE7EE                   	; La « ligne de guide » du manuel technique (IOCS 058h du device 0), celle de
0BE7EE                   	; l'ecran MENU et des libelles de touches de fonction, ouverte au BASIC :
0BE7EE                   	;
0BE7EE                   	;   DWGL 0,3,0,"BASIC ,DUMPM ,DRIVER,TRDOS ,SUITE "
0BE7EE                   	;        |  | |  les libelles, separes par des virgules : 1 a 5 cases
0BE7EE                   	;        |  | le registre B : bit 0 = parentheses au lieu de crochets,
0BE7EE                   	;        |  |                 bit 7 = garder le reste de la ligne
0BE7EE                   	;        |  la ligne, 0 a 3
0BE7EE                   	;        la colonne de la premiere case
0BE7EE                   	;
0BE7EE                   	; ⛔ SIX CARACTERES PAR CASE, ET C'EST LA ROM QUI LE FIGE (« mv il,006h » en
0BE7EE                   	;    0F2CB5h) : une case fait huit colonnes, cinq cases remplissent la ligne de
0BE7EE                   	;    40. Un libelle plus COURT est complete par des espaces par la ROM elle-meme
0BE7EE                   	;    (LOC_F2CE1), un plus LONG est tronque -- elle saute jusqu'au 0FFh suivant
0BE7EE                   	;    (LOC_F2CCF). DWGL n'a donc ni a completer ni a tronquer : il lui suffit de
0BE7EE                   	;    remplacer chaque virgule par le 0FFh qui termine un libelle.
0BE7EE                   	;
0BE7EE                   	; ⛔ PAS DE REPLI DE LIGNE : l'ecriture d'un caractere refuse des que la colonne
0BE7EE                   	;    atteint 40 ou la ligne 4 (0F23C3h), et les cases perdues le sont EN
0BE7EE                   	;    SILENCE. DWGL refuse donc lui-meme (erreur 33) : ligne >= 4, plus de cinq
0BE7EE                   	;    cases, ou colonne + 8 x cases > 40. Pour dix choix, deux appels -- comme la
0BE7EE                   	;    ROM, qui garde un drapeau de page et ajoute 5 a l'indice (referentiel
0BE7EE                   	;    04-fcs-iocs.md §2.4quater, BASEXT/CONCEPTION-DWGL.md §3).
0BE7EE                   	;
0BE7EE                   	; ⚠️ DWGL N'EST PAS fkey_display : il ne refait aucun de ses trois controles. Il
0BE7EE                   	;    ecrit sur la ligne demandee, qu'elle porte du texte ou non -- c'est a
0BE7EE                   	;    l'appelant de lui reserver la place (CONSOLE 0, ou XCONSOLE). C'est le
0BE7EE                   	;    parti de GUIDE.ASM, eprouve sur PC-E500S le 2026-10-12.
0BE7EE                   	;
0BE7EE                   	; ⚠️ LE FILTRE DE XCONSOLE NE LA VOIT PAS : il est branche sur le handle 0 du
0BE7EE                   	;    FCS, et 058h passe par l'IOCS. Une barre tracee dans une fenetre XCONSOLE
0BE7EE                   	;    en sort.
0BE7EE                   	;
0BE7EE                   	; Les trois nombres se lisent par xc_num (eval + dec2bin, 0 a 255, BP rendu en
0BE7EE                   	; ABSOLU) ; la chaine par eval, comme INSTR : elle vit SUR U, c'est de la qu'on
0BE7EE                   	; la lit (« mv x,u »), et on la libere ensuite (« add u,(BP+4) »).
0BE7EE                   	dwgl:
0BE7EE 30 D8 07 EB 0B EC 	        mv      [!sv_bp0],(bp_ram)      ; une INSTRUCTION rend BP inchange
0BE7F4 04 5F E7          	        call    xc_num                  ; (1) la colonne
0BE7F7 1C D0             	        jrc     dw_err
0BE7F9 A8 0B EC 0B       	        mv      [!dw_col],a
0BE7FD 04 D1 E8          	        call    dw_virg
0BE800 1C C5             	        jrc     dw_syn
0BE802 04 5F E7          	        call    xc_num                  ; (2) la ligne
0BE805 1C C2             	        jrc     dw_err
0BE807 A8 0C EC 0B       	        mv      [!dw_lig],a
0BE80B 04 D1 E8          	        call    dw_virg
0BE80E 1C B7             	        jrc     dw_syn
0BE810 04 5F E7          	        call    xc_num                  ; (3) le tag = le registre B
0BE813 1C B4             	        jrc     dw_err
0BE815 A8 0D EC 0B       	        mv      [!dw_tag],a
0BE819 04 D1 E8          	        call    dw_virg
0BE81C 1C A9             	        jrc     dw_syn
0BE81E                   	
0BE81E                   	; --- (4) la chaine des libelles --------------------------------------------
0BE81E 05 6E F2 0E       	        callf   eval
0BE822 1C A5             	        jrc     dw_err                  ; A porte deja le code d'erreur
0BE824 65 00 80          	        test    (BP+0),080H
0BE827 18 96             	        jrz     dw_type                 ; ce n'est pas une chaine
0BE829 80 04             	        mv      a,(BP+4)                ; sa longueur
0BE82B 60 00             	        cmp     a,000H
0BE82D 18 90             	        jrz     dw_type                 ; chaine vide : aucun libelle
0BE82F 60 30             	        cmp     a,dw_lmax+1
0BE831 1E 84             	        jrnc    dw_long                 ; plus longue que le tampon
0BE833                   	
0BE833                   	; --- le tampon : chaque ',' devient le 0FFh de fin de libelle --------------
0BE833                   	; ⛔ X EST LE POINT DE REPRISE DU BASIC, et « mv x,u » l'ecrase. INSTR le sauve
0BE833                   	;    par pushs/pops autour de sa comparaison (in_cmp) : on fait de meme. La
0BE833                   	;    premiere version ne le faisait pas -- l'interpreteur reprenait alors sur la
0BE833                   	;    pile U, et l'essai en emulation (essais/DWGLEMU.py) l'a montre a la
0BE833                   	;    premiere execution.
0BE833 FD 10             	        mv      il,a                    ; le compteur de caracteres
0BE835 B4 37             	        pushs   x                       ; le point de reprise du BASIC
0BE837 FD 46             	        mv      x,u                     ; la chaine est SUR U (comme INSTR)
0BE839 0D 0F EC 0B       	        mv      y,dw_buf
0BE83D 08 01             	        mv      a,001H
0BE83F A8 0E EC 0B       	        mv      [!dw_n],a               ; une case, plus une par virgule
0BE843                   	dw_cp:
0BE843 90 24             	        mv      a,[x++]
0BE845 60 2C             	        cmp     a,02CH                  ; ','
0BE847 1A 0C             	        jrnz    dw_put
0BE849 88 0E EC 0B       	        mv      a,[!dw_n]
0BE84D 6C 00             	        inc     a
0BE84F A8 0E EC 0B       	        mv      [!dw_n],a
0BE853 08 FF             	        mv      a,0FFH
0BE855                   	dw_put:
0BE855 B0 25             	        mv      [y++],a
0BE857 7C 01             	        dec     il
0BE859 1B 18             	        jrnz    dw_cp
0BE85B 08 FF             	        mv      a,0FFH
0BE85D B0 05             	        mv      [y],a                   ; le 0FFh du dernier libelle
0BE85F 94 27             	        pops    x                       ; rendre le point de reprise
0BE861                   	
0BE861                   	; --- rendre la chaine a U, puis le cadre d'eval ----------------------------
0BE861 80 04             	        mv      a,(BP+4)
0BE863 45 60             	        add     u,a                     ; comme BAS_LEN (0EECB2h) et INSTR
0BE865 30 D0 EC 07 EB 0B 	        mv      (bp_ram),[!sv_bp0]
0BE86B                   	
0BE86B                   	; --- les refus que la ROM ne prononce pas ----------------------------------
0BE86B 88 0E EC 0B       	        mv      a,[!dw_n]
0BE86F 60 06             	        cmp     a,006H
0BE871 1E 50             	        jrnc    dw_range                ; plus de cinq cases
0BE873 FD 10             	        mv      il,a
0BE875 88 0C EC 0B       	        mv      a,[!dw_lig]
0BE879 60 04             	        cmp     a,004H
0BE87B 1E 46             	        jrnc    dw_range                ; 0F23C3h refuse une ligne >= 4
0BE87D 88 0B EC 0B       	        mv      a,[!dw_col]
0BE881                   	dw_lg:
0BE881 40 08             	        add     a,008H                  ; huit colonnes par case
0BE883 7C 01             	        dec     il
0BE885 1B 06             	        jrnz    dw_lg
0BE887 60 29             	        cmp     a,029H
0BE889 1E 38             	        jrnc    dw_range                ; colonne + 8 x cases > 40
0BE88B                   	
0BE88B                   	; --- l'appel, aux octets de la ROM (0F1D29h) -------------------------------
0BE88B 2C                	        pushu   x                       ; X = le point de reprise du BASIC
0BE88C 2B                	        pushu   i
0BE88D 88 0B EC 0B       	        mv      a,[!dw_col]
0BE891 30 A0 D4          	        mv      (bl),a
0BE894 88 0C EC 0B       	        mv      a,[!dw_lig]
0BE898 30 A0 D5          	        mv      (bh),a
0BE89B 88 0D EC 0B       	        mv      a,[!dw_tag]
0BE89F 75                	        mv      b,a                     ; B = le tag (bits 0 et 7)
0BE8A0 88 0E EC 0B       	        mv      a,[!dw_n]               ; A = le nombre de cases
0BE8A4 0C 0F EC 0B       	        mv      x,dw_buf                ; X = les libelles, 0FFh entre chacun
0BE8A8 30 CD D6 00 00    	        mvw     (cl),00000H             ; device 0, lecteur 0 : l'ecran
0BE8AD 09 58             	        mv      il,d0_guide_line
0BE8AF 05 E8 FF 0F       	        callf   iocs_call
0BE8B3 3B                	        popu    i
0BE8B4 3C                	        popu    x
0BE8B5 9F                	        rc                              ; ⛔ 058h ne fixe PAS la retenue
0BE8B6 07                	        retf
0BE8B7                   	
0BE8B7                   	; Refus APRES la lecture de la chaine : elle est sur U, et rendre l'etat
0BE8B7                   	; d'avant l'appel (MODE-EMPLOI §6.6) demande de la rendre aussi. Les deux
0BE8B7                   	; autres refus de chaine n'ont rien a rendre : une chaine vide n'occupe rien,
0BE8B7                   	; et un argument qui n'est pas une chaine n'a rien empile.
0BE8B7                   	dw_long:
0BE8B7 80 04             	        mv      a,(BP+4)
0BE8B9 45 60             	        add     u,a
0BE8BB 08 21             	        mv      a,err_range
0BE8BD 12 0A             	        jr      dw_err
0BE8BF                   	dw_type:
0BE8BF 08 5A             	        mv      a,err_type
0BE8C1 12 06             	        jr      dw_err
0BE8C3                   	dw_range:
0BE8C3 08 21             	        mv      a,err_range
0BE8C5 12 02             	        jr      dw_err
0BE8C7                   	dw_syn:
0BE8C7 08 0A             	        mv      a,err_syn
0BE8C9                   	dw_err:
0BE8C9 30 D0 EC 07 EB 0B 	        mv      (bp_ram),[!sv_bp0]      ; l'etat d'avant l'appel (MODE-EMPLOI §6.6)
0BE8CF 97                	        sc
0BE8D0 07                	        retf
0BE8D1                   	
0BE8D1                   	; dw_virg -- exige une virgule, espaces sautes ; CY=1 si elle manque.
0BE8D1                   	;            APPEL PROCHE.
0BE8D1                   	dw_virg:
0BE8D1 04 54 E7          	        call    xc_skip
0BE8D4 60 2C             	        cmp     a,02CH
0BE8D6 1A 04             	        jrnz    dw_vnon
0BE8D8 6C 04             	        inc     x
0BE8DA 9F                	        rc
0BE8DB 06                	        ret
0BE8DC                   	dw_vnon:
0BE8DC 97                	        sc
0BE8DD 06                	        ret
0BE8DE                   	
0BE8DE                   	; ============================================================================
0BE8DE                   	; LE FILTRE D'ECRITURE DE STDO:  --  confine le defilement a la fenetre
0BE8DE                   	; ============================================================================
0BE8DE                   	; ⛔ LE FILTRE NE SE CHAINE PAS DANS d_link, ET C'EST LA MACHINE QUI LE DIT.
0BE8DE                   	;    L'ecriture par le FCS ne passe PAS par iocs_call : en 0E0907h, il saute
0BE8DE                   	;    (retf) a l'adresse rangee en [bloc+2] du bloc de controle du handle, et
0BE8DE                   	;    cette adresse est memorisee a l'OUVERTURE (0E07F1h). Releve dans la System
0BE8DE                   	;    Data Area d'un PC-E500S reel (Samples/Extraction/s1-1.bin) :
0BE8DE                   	;
0BE8DE                   	;      bloc du handle 0 en 0BEE48h : 00 00 E7 21 0F A2 02
0BE8DE                   	;                                    |  |  \______/ \
0BE8DE                   	;                                device lecteur  0F21E7h = drv_display, attribut
0BE8DE                   	;
0BE8DE                   	;    Un en-tete ajoute en tete de d_link (la methode de MEMCHECK) ne verrait donc
0BE8DE                   	;    jamais un PRINT. On remplace l'adresse du bloc du handle 0 par xf_entry, et
0BE8DE                   	;    le filtre transmet a l'ancienne adresse -- recopiee dans les operandes de
0BE8DE                   	;    xf_pass et xf_call (auto-modification, comme MEMCHECK). Si la ROM rouvre
0BE8DE                   	;    STDO:, le filtre disparait simplement : l'echec est sans danger.
0BE8DE                   	;
0BE8DE                   	; LE BLOC DE CONTROLE se trouve comme en 0E0698h / 0E066Ah :
0BE8DE                   	;    numero = [fhandle + handle] ; bloc = [(iocsw)] + [(iocsw)+25h]
0BE8DE                   	;    + numero * 1Fh, borne par [(iocsw)+27h] ; octet 0 = device (0FFh = libre).
0BE8DE                   	;
0BE8DE                   	; LE PRINCIPE : DEFILER AVANT LA ROM. Pour un octet, le pilote fait (0F2A47h) :
0BE8DE                   	;    affichable        : retour a la ligne differe (0F2B57h : X >= largeur ->
0BE8DE                   	;                        X=0, Y+1), puis 0F2B6Ah (Y >= lcd_height -> defilement
0BE8DE                   	;                        de la ROM, Y = lcd_height-1), puis l'affichage ;
0BE8DE                   	;    0Dh               : 0F2B6Ah seul ;
0BE8DE                   	;    08 09 0A 0B 1C 1D 1F : 0F2B57h puis 0F2B6Ah ;
0BE8DE                   	;    07 0C 1E et le reste : pas de 0F2B6Ah.
0BE8DE                   	; Le filtre calcule la ligne que verra 0F2B6Ah. Si la ROM allait defiler, il
0BE8DE                   	; defile LUI-MEME les lignes debut .. lcd_height-1 (55h pattern_read, 56h
0BE8DE                   	; pattern_write, 49h clear_line), puis remonte Y pour que la ROM ne defile plus.
0BE8DE                   	; L'octet est ensuite transmis tel quel : le pilote fait tout le reste.
0BE8DE                   	;
0BE8DE                   	; ⚠️ SEULS LES ECRITURES DU HANDLE 0 SONT VUES. Un OPEN "SCRN:" ouvre un autre
0BE8DE                   	;    handle, qui garde l'adresse de la ROM.
0BE8DE                   	; ⚠️ NE PAS RECHARGER LE MODULE FILTRE BRANCHE. Entre LOAD M et CALL &BF000, le
0BE8DE                   	;    handle 0 designerait du code ecrase. Faire XCONSOLE avant de recharger ;
0BE8DE                   	;    CALL &BF000 debranche ensuite tout filtre reste dans la zone du module.
0BE8DE                   	
0BE8DE                   	; xf_entry -- l'entree du filtre : memes registres qu'une entree de pilote.
0BE8DE                   	xf_entry:
0BE8DE 2A                	        pushu   ba
0BE8DF FD 23             	        mv      ba,i
0BE8E1 60 0D             	        cmp     a,00DH                  ; write_byte
0BE8E3 18 09             	        jrz     xf_wbyte
0BE8E5 60 0B             	        cmp     a,00BH                  ; write_block
0BE8E7 18 13             	        jrz     xf_wblock
0BE8E9 3A                	        popu    ba
0BE8EA                   	xf_pass:
0BE8EA 03 E7 21 0F       	        jpf     0F21E7H                 ; OPERANDE REECRIT par xf_on
0BE8EE                   	xf_wbyte:
0BE8EE 3A                	        popu    ba                      ; A = l'octet, I = 0Dh
0BE8EF 2C                	        pushu   x
0BE8F0 2D                	        pushu   y
0BE8F1 2B                	        pushu   i
0BE8F2 2A                	        pushu   ba
0BE8F3 04 20 E9          	        call    xf_pre
0BE8F6 3A                	        popu    ba
0BE8F7 3B                	        popu    i
0BE8F8 3D                	        popu    y
0BE8F9 3C                	        popu    x
0BE8FA 13 12             	        jr      xf_pass
0BE8FC                   	
0BE8FC                   	; write_block : X = source, Y = compte. On le rend octet par octet au pilote,
0BE8FC                   	; chacun precede de son controle ; Y est rendu tel quel, comme 0F2A18h.
0BE8FC                   	xf_wblock:
0BE8FC 3A                	        popu    ba
0BE8FD 2D                	        pushu   y
0BE8FE                   	xb_lp:
0BE8FE 6C 05             	        inc     y
0BE900 7C 05             	        dec     y
0BE902 18 14             	        jrz     xb_end
0BE904 90 24             	        mv      a,[x++]
0BE906 2C                	        pushu   x
0BE907 2D                	        pushu   y
0BE908 28                	        pushu   a
0BE909 04 20 E9          	        call    xf_pre
0BE90C 38                	        popu    a
0BE90D 09 0D             	        mv      il,00DH
0BE90F 04 1B E9          	        call    xf_call                 ; write_byte de l'ancien pilote
0BE912 3D                	        popu    y
0BE913 3C                	        popu    x
0BE914 7C 05             	        dec     y
0BE916 13 1A             	        jr      xb_lp
0BE918                   	xb_end:
0BE918 3D                	        popu    y
0BE919 9F                	        rc
0BE91A 07                	        retf
0BE91B                   	
0BE91B                   	; xf_call -- appelle l'ancien pilote, commande dans IL.  APPEL PROCHE.
0BE91B                   	xf_call:
0BE91B 05 E7 21 0F       	        callf   0F21E7H                 ; OPERANDE REECRIT par xf_on
0BE91F 06                	        ret
0BE920                   	
0BE920                   	; xf_pre -- A = l'octet a ecrire. Defile la fenetre si la ROM allait le faire.
0BE920                   	;           Detruit A, I, X, Y, (bl), (bh).  APPEL PROCHE.
0BE920                   	xf_pre:
0BE920 30 A0 D4          	        mv      (bl),a                  ; l'octet, le temps de le classer
0BE923 88 17 EB 0B       	        mv      a,[!xc_top]
0BE927 60 00             	        cmp     a,000H
0BE929 18 6E             	        jrz     xp_none                 ; debut 0 : la ROM suffit
0BE92B 30 A0 D5          	        mv      (bh),a
0BE92E 88 9E FC 0B       	        mv      a,[lcd_height]
0BE932 30 63 D5          	        cmp     (bh),a                  ; debut - hauteur : NC = pas de fenetre
0BE935 1E 62             	        jrnc    xp_none
0BE937 30 80 D4          	        mv      a,(bl)
0BE93A 60 20             	        cmp     a,020H
0BE93C 1E 1B             	        jrnc    xp_wrap                 ; affichable
0BE93E 66 29 FC 0B 40    	        test    [ctrl_disp],040H
0BE943 1A 14             	        jrnz    xp_wrap                 ; code de controle affiche (0F2A56h)
0BE945 60 0D             	        cmp     a,00DH
0BE947 18 25             	        jrz     xp_nw                   ; CR : 0F2B6Ah sans 0F2B57h
0BE949 60 08             	        cmp     a,008H
0BE94B 1C 4C             	        jrc     xp_none                 ; 00-07
0BE94D 60 0C             	        cmp     a,00CH
0BE94F 1C 08             	        jrc     xp_wrap                 ; 08 09 0A 0B
0BE951 60 1C             	        cmp     a,01CH
0BE953 1C 44             	        jrc     xp_none                 ; 0C-1B
0BE955 60 1E             	        cmp     a,01EH
0BE957 18 40             	        jrz     xp_none                 ; 1E, curseur vers le haut
0BE959                   	xp_wrap:                                ; 1C 1D 1F et les affichables
0BE959 09 00             	        mv      il,000H
0BE95B 30 D0 D4 27 FC 0B 	        mv      (bl),[scrn_crsr_x]
0BE961 88 9D FC 0B       	        mv      a,[lcd_width]
0BE965 30 63 D4          	        cmp     (bl),a                  ; X - largeur : NC = retour differe
0BE968 1C 06             	        jrc     xp_chk
0BE96A 09 01             	        mv      il,001H
0BE96C 12 02             	        jr      xp_chk
0BE96E                   	xp_nw:
0BE96E 09 00             	        mv      il,000H
0BE970                   	xp_chk:
0BE970 88 28 FC 0B       	        mv      a,[scrn_crsr_y]
0BE974 46 01             	        add     a,il                    ; la ligne que verra 0F2B6Ah
0BE976 30 A0 D5          	        mv      (bh),a
0BE979 88 9E FC 0B       	        mv      a,[lcd_height]
0BE97D 30 63 D5          	        cmp     (bh),a                  ; NC : la ROM defilerait
0BE980 1C 17             	        jrc     xp_none
0BE982 A9 19 EB 0B       	        mv      [!xf_w],il
0BE986 04 9A E9          	        call    xf_scroll
0BE989 88 9E FC 0B       	        mv      a,[lcd_height]
0BE98D 7C 00             	        dec     a
0BE98F 89 19 EB 0B       	        mv      il,[!xf_w]
0BE993 4E 01             	        sub     a,il                    ; lcd_height-1-retour : plus de defilement ROM
0BE995 A8 28 FC 0B       	        mv      [scrn_crsr_y],a
0BE999                   	xp_none:
0BE999 06                	        ret
0BE99A                   	
0BE99A                   	; xf_scroll -- remonte d'une ligne les lignes debut+1 .. lcd_height-1, puis
0BE99A                   	;              efface la derniere.  APPEL PROCHE.
0BE99A                   	xf_scroll:
0BE99A 88 17 EB 0B       	        mv      a,[!xc_top]
0BE99E A8 1A EB 0B       	        mv      [!xf_y],a
0BE9A2                   	xs_lp:
0BE9A2 88 1A EB 0B       	        mv      a,[!xf_y]
0BE9A6 6C 00             	        inc     a
0BE9A8 30 A0 D5          	        mv      (bh),a                  ; la ligne du dessous
0BE9AB 88 9E FC 0B       	        mv      a,[lcd_height]
0BE9AF 30 63 D5          	        cmp     (bh),a
0BE9B2 1E 25             	        jrnc    xs_clr                  ; plus rien a remonter
0BE9B4 0C 1B EB 0B       	        mv      x,xf_buf
0BE9B8 09 55             	        mv      il,d0_pattern_read
0BE9BA 04 1B E9          	        call    xf_call
0BE9BD 88 1A EB 0B       	        mv      a,[!xf_y]
0BE9C1 30 A0 D5          	        mv      (bh),a
0BE9C4 0C 1B EB 0B       	        mv      x,xf_buf
0BE9C8 09 56             	        mv      il,d0_pattern_write
0BE9CA 04 1B E9          	        call    xf_call
0BE9CD 88 1A EB 0B       	        mv      a,[!xf_y]
0BE9D1 6C 00             	        inc     a
0BE9D3 A8 1A EB 0B       	        mv      [!xf_y],a
0BE9D7 13 37             	        jr      xs_lp
0BE9D9                   	xs_clr:
0BE9D9 88 9E FC 0B       	        mv      a,[lcd_height]
0BE9DD 7C 00             	        dec     a
0BE9DF 30 A0 D5          	        mv      (bh),a
0BE9E2 09 49             	        mv      il,d0_clear_line
0BE9E4 04 1B E9          	        call    xf_call
0BE9E7 06                	        ret
0BE9E8                   	
0BE9E8                   	; xf_fcb -- X = le bloc de controle du handle 0 ; CY=1 s'il n'est pas l'ecran.
0BE9E8                   	;           Detruit A, I, (bl).  APPEL PROCHE.
0BE9E8                   	xf_fcb:
0BE9E8 88 6D FC 0B       	        mv      a,[fhandle]             ; handle 0 -> numero de bloc
0BE9EC 30 A0 D4          	        mv      (bl),a
0BE9EF 30 84 E6          	        mv      x,(iocsw)
0BE9F2 90 84 27          	        mv      a,[x+027H]              ; nombre de blocs
0BE9F5 30 63 D4          	        cmp     (bl),a
0BE9F8 1E 1E             	        jrnc    xfc_no
0BE9FA 93 84 25          	        mv      i,[x+025H]
0BE9FD 45 43             	        add     x,i                     ; le premier bloc
0BE9FF 0B 1F 00          	        mv      i,0001FH                ; 31 octets par bloc
0BEA02                   	xfc_lp:
0BEA02 30 80 D4          	        mv      a,(bl)
0BEA05 60 00             	        cmp     a,000H
0BEA07 18 07             	        jrz     xfc_at
0BEA09 45 43             	        add     x,i
0BEA0B 30 7D D4          	        dec     (bl)
0BEA0E 13 0E             	        jr      xfc_lp
0BEA10                   	xfc_at:
0BEA10 90 04             	        mv      a,[x]                   ; le device du bloc
0BEA12 60 00             	        cmp     a,000H
0BEA14 1A 02             	        jrnz    xfc_no                  ; libre (0FFh) ou pas l'ecran
0BEA16 9F                	        rc
0BEA17 06                	        ret
0BEA18                   	xfc_no:
0BEA18 97                	        sc
0BEA19 06                	        ret
0BEA1A                   	
0BEA1A                   	; xf_on -- branche le filtre sur le handle 0.  APPEL PROCHE.
0BEA1A                   	;          Deja branche (adresse dans la zone du module) : ne rien faire, sans
0BEA1A                   	;          quoi le filtre se transmettrait a lui-meme.
0BEA1A                   	;
0BEA1A                   	;    ⛔ DANS LE PILOTE (BASEXT-DRV), LA PLAGE 0BF000h-0BFFFFh NE DIT RIEN : le
0BEA1A                   	;       bloc reside ailleurs dans S1:, et un « deja nous » par plage laisserait
0BEA1A                   	;       le filtre se brancher sur lui-meme au second XCONSOLE (recursion sans
0BEA1A                   	;       fin). Le pilote compare donc l'adresse en place a xf_entry, exactement.
0BEA1A                   	;       Ces octets de plage ne sont pas des champs d'adresse : la mesure de
0BEA1A                   	;       relocation (reloc.py) ne pouvait pas les voir. Releve a la lecture le
0BEA1A                   	;       2026-09-16. Le module autonome garde son test, eprouve sur machine.
0BEA1A                   	xf_on:
0BEA1A 04 E8 E9          	        call    xf_fcb
0BEA1D 1C 17             	        jrc     xon_ret
0BEA1F 04 49 EA          	        call    xf_nous                 ; Z = l'adresse en place est xf_entry
0BEA22 18 12             	        jrz     xon_ret                 ; deja nous
0BEA24                   	xon_set:
0BEA24 95 84 02          	        mv      y,[x+002H]              ; l'adresse en place : la ROM, ou un autre
0BEA27 AD EB E8 0B       	        mv      [!xf_pass+1],y
0BEA2B AD 1C E9 0B       	        mv      [!xf_call+1],y
0BEA2F 0D DE E8 0B       	        mv      y,xf_entry
0BEA33 B5 84 02          	        mv      [x+002H],y              ; une seule instruction : atomique
0BEA36                   	xon_ret:
0BEA36 06                	        ret
0BEA37                   	
0BEA37                   	; xf_off -- debranche le filtre : rend l'adresse gardee dans xf_pass. Apres un
0BEA37                   	;           rechargement du module, c'est celle de l'assemblage, 0F21E7h.
0BEA37                   	;           APPEL PROCHE.
0BEA37                   	xf_off:
0BEA37 04 E8 E9          	        call    xf_fcb
0BEA3A 1C 0C             	        jrc     xof_ret
0BEA3C 04 49 EA          	        call    xf_nous                 ; pilote : seulement NOTRE filtre
0BEA3F 1A 07             	        jrnz    xof_ret
0BEA41 8D EB E8 0B       	        mv      y,[!xf_pass+1]
0BEA45 B5 84 02          	        mv      [x+002H],y
0BEA48                   	xof_ret:
0BEA48 06                	        ret
0BEA49                   	
0BEA49                   	; xf_nous -- Z=1 si l'adresse en place dans le bloc X ([x+2], 3 octets) est
0BEA49                   	;            xf_entry. Preserve X. Detruit Y. APPEL PROCHE. Pilote seulement.
0BEA49                   	;            Le test de zero sur 20 bits emprunte l'idiome du DRIVER_TEMPLATE
0BEA49                   	;            (« inc x / jrz » sur 0FFFFFh) : dec puis inc ramene a zero.
0BEA49                   	xf_nous:
0BEA49 2C                	        pushu   x
0BEA4A 95 84 02          	        mv      y,[x+002H]
0BEA4D 0C DE E8 0B       	        mv      x,xf_entry
0BEA51 4D 54             	        sub     y,x
0BEA53 3C                	        popu    x
0BEA54 7C 05             	        dec     y
0BEA56 6C 05             	        inc     y
0BEA58 06                	        ret
0BEA59                   	
0BEA59                   	; ============================================================================
0BEA59                   	; LES QUATRE ENTREES
0BEA59                   	; ============================================================================
0BEA59                   	kw_table:
0BEA59 05 4C 50 45 45 4B 	        db      5,'LPEEK',tk_lp
0BEA5F 07                	
0BEA60 05 57 50 45 45 4B 	        db      5,'WPEEK',tk_wp
0BEA66 0A                	
0BEA67 05 4C 50 4F 4B 45 	        db      5,'LPOKE',tk_lpo
0BEA6D 0E                	
0BEA6E 03 4D 4F 44 0F    	        db      3,'MOD',tk_mod
0BEA73 06 55 43 41 53 45 	        db      6,'UCASE$',tk_uc
0BEA79 24 C6             	
0BEA7B 06 4C 43 41 53 45 	        db      6,'LCASE$',tk_lc
0BEA81 24 C7             	
0BEA83 05 54 52 49 4D 24 	        db      5,'TRIM$',tk_tr
0BEA89 C3                	
0BEA8A 06 4C 54 52 49 4D 	        db      6,'LTRIM$',tk_lt
0BEA90 24 C4             	
0BEA92 06 52 54 52 49 4D 	        db      6,'RTRIM$',tk_rt
0BEA98 24 C5             	
0BEA9A 05 52 45 50 54 24 	        db      5,'REPT$',tk_rp
0BEAA0 C8                	
0BEAA1 06 53 52 45 50 54 	        db      6,'SREPT$',tk_sr
0BEAA7 24 C9             	
0BEAA9 05 49 4E 53 54 52 	        db      5,'INSTR',tk_in
0BEAAF C2                	
0BEAB0 08 58 43 4F 4E 53 	        db      8,'XCONSOLE',tk_xc
0BEAB6 4F 4C 45 CA       	
0BEABA 04 58 43 4C 53 CF 	        db      4,'XCLS',tk_xcl
0BEAC0 04 44 57 47 4C D3 	        db      4,'DWGL',tk_dw
0BEAC6 00                	        db      0                       ; fin de table
0BEAC7                   	
0BEAC7                   	disp_table:
0BEAC7                   	; Trois entrees de 4 octets, puis le terminateur. Le quartet haut du 3e octet
0BEAC7                   	; d'adresse est un DRAPEAU : 040h = fonction, routine a l'adresse + 3 ; 080h =
0BEAC7                   	; instruction, routine a l'adresse telle quelle. LPOKE est du second genre, et
0BEAC7                   	; n'a donc pas de prefixe de trois octets.
0BEAC7 07                	        db      tk_lp
0BEAC8 B3                	        db      lpeek_m3
0BEAC9 E0                	        db      lpeek_m3/256
0BEACA 4B                	        db      lpeek_m3/65536+040H
0BEACB 0A                	        db      tk_wp
0BEACC F5                	        db      wpeek_m3
0BEACD E0                	        db      wpeek_m3/256
0BEACE 4B                	        db      wpeek_m3/65536+040H
0BEACF 0E                	        db      tk_lpo
0BEAD0 2B                	        db      lpoke
0BEAD1 E1                	        db      lpoke/256
0BEAD2 8B                	        db      lpoke/65536+080H
0BEAD3 0F                	        db      tk_mod
0BEAD4 87                	        db      modu_m3
0BEAD5 E1                	        db      modu_m3/256
0BEAD6 4B                	        db      modu_m3/65536+040H
0BEAD7 C6 AA E2 4B       	        db      tk_uc, ucase_m3, ucase_m3/256, ucase_m3/65536+040H
0BEADB C7 D5 E2 4B       	        db      tk_lc, lcase_m3, lcase_m3/256, lcase_m3/65536+040H
0BEADF C3 00 E3 4B       	        db      tk_tr, trim_m3,  trim_m3/256,  trim_m3/65536+040H
0BEAE3 C4 07 E3 4B       	        db      tk_lt, ltrim_m3, ltrim_m3/256, ltrim_m3/65536+040H
0BEAE7 C5 0E E3 4B       	        db      tk_rt, rtrim_m3, rtrim_m3/256, rtrim_m3/65536+040H
0BEAEB C8 99 E3 4B       	        db      tk_rp, rept_m3,  rept_m3/256,  rept_m3/65536+040H
0BEAEF C9 7E E4 4B       	        db      tk_sr, srept_m3, srept_m3/256, srept_m3/65536+040H
0BEAF3 C2 8C E5 4B       	        db      tk_in, instr_m3, instr_m3/256, instr_m3/65536+040H
0BEAF7 CA B3 E6 8B       	        db      tk_xc,  xconsole, xconsole/256, xconsole/65536+080H   ; instructions :
0BEAFB CF 93 E7 8B       	        db      tk_xcl, xcls,     xcls/256,     xcls/65536+080H       ; pas de +3
0BEAFF D3 EE E7 8B       	        db      tk_dw,  dwgl,     dwgl/256,     dwgl/65536+080H
0BEB03 00                	        db      0                       ; fin de table
0BEB04                   	
0BEB04                   	; ============================================================================
0BEB04                   	; LES CROCHETS D'ORIGINE, pour desinstaller
0BEB04                   	; ============================================================================
0BEB04                   	; Le premier operande, hors d'atteinte du second chknum. Il n'est PLUS ecrase
0BEB04                   	; ensuite : apres un appel, LPEEK &BF1EC rend A tel que dec2bin l'a converti.
0BEB04                   	; C'est notre seul point de mesure, et le module doit rester assez court pour
0BEB04                   	; que le BASIC ne vienne pas le manger -- le vidage du 2026-09-05 montre du
0BEB04                   	; texte BASIC des 0BF1F7h.
0BEB04 00 00 00          	sv_a:     db    0,0,0
0BEB07 00                	sv_bp0:   db    0             ; BP a l'entree -- l'etat a rendre en erreur
0BEB08 00                	sv_bp1:   db    0             ; BP apres la 1re evaluation -- cadre du resultat
0BEB09                   	
0BEB09                   	; ⛔ LES TROIS TEMOINS DE MESURE ONT ETE RETIRES LE 2026-09-05, une fois MOD
0BEB09                   	;    valide sur machine. Ils portaient A et B tels que dec2bin les rendait, et le
0BEB09                   	;    reste au sortir de la boucle ; c'est par eux que la cause a ete trouvee deux
0BEB09                   	;    fois, la ou le raisonnement s'etait trompe. Les remettre est l'affaire de
0BEB09                   	;    trois « mvp [!dbg_x],(BP+n) » et de trois mots de 3 octets -- le faire
0BEB09                   	;    plutot que de deviner, si la fonction se remet a mentir.
0BEB09                   	
0BEB09                   	
0BEB09 00                	tmode:    db    0
0BEB0A 00                	rp_n:     db    0
0BEB0B 00                	rp_c:     db    0
0BEB0C 00                	in_start: db    0
0BEB0D 00                	in_lt:    db    0
0BEB0E 00                	in_res:   db    0
0BEB0F 00                	in_p:     db    0
0BEB10 00                	sr_n:     db    0
