0BE644                   	md_type:
0BE644 30 D0 EC 0D EE 0B 	        mv      (bp_ram),[!sv_bp0]
0BE64A 08 5A             	        mv      a,err_type      ; une chaine la ou un nombre est attendu
0BE64C 97                	        sc
0BE64D 07                	        retf
0BE64E                   	
0BE64E                   	md_neg:
0BE64E 30 D0 EC 0D EE 0B 	        mv      (bp_ram),[!sv_bp0]
0BE654 08 21             	        mv      a,err_range     ; operande negatif : hors du domaine annonce
0BE656 97                	        sc
0BE657 07                	        retf
0BE658                   	
0BE658                   	md_zero:
0BE658 30 D0 EC 0D EE 0B 	        mv      (bp_ram),[!sv_bp0]
0BE65E 08 15             	        mv      a,err_div
0BE660 97                	        sc
0BE661 07                	        retf
