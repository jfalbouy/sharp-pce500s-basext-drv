0BE400                   	; ============================================================================
0BE400                   	;  Tout ce qui est ici est RELOGE : toute adresse absolue interne au bloc est
0BE400                   	;  un champ de 2 ou 3 octets que reloc.py mesure. Le bloc ne doit JAMAIS citer
0BE400                   	;  une adresse de l'installateur (elle serait relogee a tort).
0BE400                   	block_top:
0BE400                   	; -- en-tete de bloc memoire (disposition du DRIVER_TEMPLATE) --
0BE400 FB                	        db      0FBH                    ; signature de bloc
0BE401 42 41 53 45 58 54 	        db      'BASEXT  SYS'           ; nom 8.3, 8 + 3, sans point
0BE407 20 20 53 59 53    	
0BE40C 25                	        db      025H                    ; attributs : device + protege (bits 0Ch : pilote)
0BE40D 00 00 00 00       	        dw      0,0                     ; date, heure
0BE411 17 0B 00          	        dp      block_bottom-block_top  ; +11h : taille du bloc (lien vers le suivant)
0BE414 00 00             	        dw      0
0BE416 17 0B 00          	        dp      block_bottom-block_top  ; +16h : taille du fichier (FILES affiche +16h - 22h)
0BE419 17 0B 00          	        dp      block_bottom-block_top
0BE41C 00 00 00 00 00 00 	        dp      0,0
0BE422                   	; -- en-tete IOCS (maillon de la chaine d_link), en +22h --
0BE422                   	iocs_header:
0BE422                   	bd_lien:
0BE422 00 00 00          	        dp      0                       ; lien suivant : ecrit par l'installateur
0BE425 14                	        db      20                      ; numero de device (celui du gabarit)
0BE426 63                	        db      063H                    ; attribut de device (celui du gabarit)
0BE427 30 E4 0B          	        dp      bd_iocs                 ; point d'entree IOCS (reloge)
0BE42A                   	bd_nom:
0BE42A 42 45 58 54 3A    	        db      'BEXT:'
0BE42F                   	bd_nom_f:
0BE42F 00                	        db      0
0BE430                   	; -- entree IOCS : aucune commande geree. La commande IOCS 05h (0E0159h) envoie
0BE430                   	;    40h a tous les pilotes chaines et IGNORE la retenue : ce stub y suffit. --
0BE430                   	bd_iocs:
0BE430 97                	        sc
0BE431 07                	        retf
0BE432                   	
0BE432                   	; bd_arret -- appele par le desinstallateur, par callf a l'adresse relogee.
0BE432                   	;   1. debranche le filtre d'ecran de XCONSOLE s'il est le notre (xf_off) ;
0BE432                   	;   2. rend les crochets du BASIC sauves par start, SEULEMENT s'ils designent
0BE432                   	;      encore ce bloc (sinon une autre extension s'est installee depuis).
0BE432                   	;   Detruit A, I, X, Y, (bl), (014H)-(016H). Preserve (00EH)-(013H), (017H)-(019H).
0BE432                   	;   ⚠️ Son premier octet d'operande (le call proche) sert a l'AUTO-VERIFICATION
0BE432                   	;   de la relocation (bi_verif) : garder « call xf_off » en tete.
0BE432                   	bd_arret:
0BE432 04 47 ED          	        call    xf_off
0BE435 30 84 D1          	        mv      x,(basptr)              ; objet : 30 84 D1
0BE438 95 84 90          	        mv      y,[x+090H]
0BE43B 30 A5 14          	        mv      (014H),y
0BE43E 0D 69 ED 0B       	        mv      y,kw_table
0BE442 30 D7 05 14       	        cmpp    (014H),y
0BE446 1A 0E             	        jrnz    ba_fin                  ; pas nos tables : ne rien rendre
0BE448 8D 11 EF 0B       	        mv      y,[old_kw]
0BE44C B5 84 90          	        mv      [x+090H],y
0BE44F 8D 14 EF 0B       	        mv      y,[old_disp]
0BE453 B5 84 93          	        mv      [x+093H],y
0BE456                   	ba_fin:
0BE456 07                	        retf
0BE457                   	
0BE457                   	; bd_reprise -- CALL &xxxxx depuis le BASIC, SANS installateur.
0BE457                   	;   La ROM remet d_link a sa table d'origine a l'amorcage (0F0D9Eh), et les
0BE457                   	;   crochets peuvent partir avec : le bloc reste, le reste se repare ici.
0BE457                   	;   1. remet notre en-tete en tete de d_link s'il n'y est plus ;
0BE457                   	;   2. saute dans start, qui repose les crochets (idempotent).
0BE457                   	;   Registres seulement (aucune RAM interne) ; X rendu tel quel par start.
0BE457                   	bd_reprise:
0BE457 2C                	        pushu   x
0BE458 0D 22 E4 0B       	        mv      y,iocs_header           ; notre en-tete, a son adresse relogee
0BE45C 8C A2 FC 0B       	        mv      x,[d_link]
0BE460                   	bd_rp_lp:
0BE460 2C                	        pushu   x
0BE461 6C 04             	        inc     x                       ; 0FFFFFh : fin de chaine (idiome du gabarit)
0BE463 3C                	        popu    x                       ; POPU ne touche pas les drapeaux
0BE464 18 0E             	        jrz     bd_rp_absent
0BE466 2C                	        pushu   x
0BE467 4D 45             	        sub     x,y
0BE469 7C 04             	        dec     x
0BE46B 6C 04             	        inc     x                       ; Z = en-tete courant = le notre
0BE46D 3C                	        popu    x
0BE46E 18 10             	        jrz     bd_rp_present
0BE470 94 04             	        mv      x,[x]
0BE472 13 14             	        jr      bd_rp_lp
0BE474                   	bd_rp_absent:
0BE474 8C A2 FC 0B       	        mv      x,[d_link]
0BE478 AC 22 E4 0B       	        mv      [iocs_header],x         ; notre lien <- la tete actuelle
0BE47C AD A2 FC 0B       	        mv      [d_link],y              ; la tete <- notre en-tete
0BE480                   	bd_rp_present:
0BE480 3C                	        popu    x
0BE481 02 84 E4          	        jp      start                   ; start rend la main au BASIC (rc / retf)
0BE484                   	
0BE484                   	; -- le corps : les 14 mots-cles, le filtre, les tables, les variables --
0BE484                   	        include ..\..\BASEXT\src\BASEXT.ASM
0BE484                   	; ============================================================================
0BE484                   	; BASEXT.ASM -- le module d'extensions du BASIC
0BE484                   	; ============================================================================
0BE484                   	; ATTENTION : LES NOMS DE FICHIER SHARP SONT EN 8.3
0BE484                   	;    Ce module s'est d'abord appele BASIC_EXT -- neuf caracteres, un de trop.
0BE484                   	;    La regle vaut pour tout ce qui part sur le lecteur, .OBJ comme .UU :
0BE484                   	;    LOAD M "S1:BASEXT.OBJ" ne pardonne pas un nom trop long.
0BE484                   	; ============================================================================
0BE484                   	;                 LPEEK (fonction, 3 octets), WPEEK (fonction, 2 octets)
0BE484                   	;                 et LPOKE (INSTRUCTION, ecrit des valeurs de 3 octets)
0BE484                   	; ============================================================================
0BE484                   	;
0BE484                   	; ⛔ LE NOM NE POUVAIT PAS ETRE "PEEKX", ET L'ESSAI MACHINE L'A MONTRE.
0BE484                   	;    Le tokeniseur consulte la table de la ROM AVANT la notre. "PEEKX" y est
0BE484                   	;    donc coupe en PEEK + la variable X, et la ligne devient une erreur de
0BE484                   	;    syntaxe -- relue ensuite, elle s'affiche litteralement
0BE484                   	;    "PRINT HEX$ PEEK X &BF100".
0BE484                   	;
0BE484                   	;    LA REGLE, valable pour toute extension : un mot-cle ajoute ne doit pas
0BE484                   	;    COMMENCER par un mot-cle existant, ni etre le debut de l'un d'eux. Cela se
0BE484                   	;    verifie avant d'ecrire une ligne de code, sur les 168 noms de
0BE484                   	;    Data/BasicTokens.csv. LPEEK est libre dans les deux sens.
0BE484                   	;
0BE484                   	;   LPEEK &BF0B8   rend la valeur de l'adresse 3 octets rangee en &BF0B8,
0BE484                   	;                  soit l'equivalent de
0BE484                   	;                  PEEK &BF0B8 + PEEK &BF0B9 * 256 + PEEK &BF0BA * 65536
0BE484                   	;
0BE484                   	; Ce n'est pas un CALL : c'est une INSTRUCTION DU LANGAGE, utilisable dans une
0BE484                   	; expression -- PRINT LPEEK &BF0B8, A = LPEEK X + 1, etc.
0BE484                   	;
0BE484                   	;   LOAD M "S1:LPEEK.OBJ" : CALL &BF000      installe
0BE484                   	;   PRINT HEX$ LPEEK &BF0B8
0BE484                   	;
0BE484                   	; ---------------------------------------------------------------------------
0BE484                   	; COMMENT L'INTERPRETEUR NOUS TROUVE  (tout est lu dans la ROM)
0BE484                   	; ---------------------------------------------------------------------------
0BE484                   	;
0BE484                   	; Deux crochets dans la zone de travail du BASIC, x = (baswrk) = (0D1h) :
0BE484                   	;
0BE484                   	;   [x+090h]   la table de mots-cles      (texte -> token)
0BE484                   	;   [x+093h]   la table de repartition    (token -> routine)
0BE484                   	;
0BE484                   	; La ROM y met 0FFFFFh au demarrage (SUB_F93C3) : la sentinelle "rien".
0BE484                   	;
0BE484                   	; La repartition se balaie par SUB_F593D (0F593Dh) : entrees de QUATRE octets,
0BE484                   	; token puis adresse, arret sur un token 000h.
0BE484                   	;
0BE484                   	; ⛔ ET LE QUARTET HAUT DU 3e OCTET D'ADRESSE EST UN DRAPEAU. Les deux
0BE484                   	;    resolveurs de la ROM sont cote a cote et ne different que par le bit :
0BE484                   	;
0BE484                   	;      0F58E5h  instruction : test a,080h -> routine = l'adresse telle quelle
0BE484                   	;      0F590Bh  FONCTION    : test a,040h -> routine = l'adresse + 3
0BE484                   	;
0BE484                   	;    PEEKX etant une fonction, on range donc (routine - 3) avec le bit 6 arme.
0BE484                   	;    Les trois octets sautes n'ont aucun sens : dans la ROM, ce sont ceux de la
0BE484                   	;    routine precedente. On y met trois zeros.
0BE484                   	;
0BE484                   	; ---------------------------------------------------------------------------
0BE484                   	; LE CORPS -- calque sur BAS_PEEK (0F9F44h), avec les entrees LOINTAINES
0BE484                   	; ---------------------------------------------------------------------------
0BE484                   	;
0BE484                   	; Une extension vit en page 0B, les services en 0E et 0F. Un service termine
0BE484                   	; par RET ne se laisse PAS appeler d'ici : son retour depile 2 octets et reste
0BE484                   	; dans SA page. Il faut donc, pour chaque service, l'entree qui finit par RETF.
0BE484                   	;
0BE484                   	;   BAS_PEEK fait            ici on fait              parce que
0BE484                   	;   -----------------------  -----------------------  ------------------------
0BE484                   	;   call SUB_F5F9C           callf 0EFBF3h            F5F9C finit par RET ;
0BE484                   	;                            puis callf 0EFAD4h       EFBF3 et EFAD4 par RETF.
0BE484                   	;                                                     F5F9C n'etait que
0BE484                   	;                                                     "callf EFBF3 + call
0BE484                   	;                                                     F5C9A", et F5C9A n'etait
0BE484                   	;                                                     que "callf EFAD4 + mv y".
0BE484                   	;   callf SUB_EFB6F          callf 0EFB6Fh            deja lointaine
0BE484                   	;
0BE484                   	; 0EFAD4h et 0EFB6Fh sont les commandes 07Eh et 07Fh du device 9 -- dec2bin et
0BE484                   	; bin2dec. Le travail sur la bibliotheque mathematique sert directement ici.
0BE484                   	;
0BE484                   	; ⛔ LE CADRE BP -- ET J'AI D'ABORD MAL LU SUB_F5C9A.
0BE484                   	;
0BE484                   	;    Elle se termine par "jr LOC_F5C6F", que je n'avais pas suivi. Or LOC_F5C6F
0BE484                   	;    fait "pmdf (bp_ram),00Fh" : BP + 15. Le compte, entree a sortie :
0BE484                   	;
0BE484                   	;      entree                          BP = B
0BE484                   	;      callf chknum                    BP = B-15   <- le cadre de la valeur
0BE484                   	;      SUB_F5C9A finit par +15         BP = B
0BE484                   	;      BAS_PEEK fait -15               BP = B-15   <- ou il ecrit son resultat
0BE484                   	;
0BE484                   	;    Ici on n'appelle pas F5C9A, donc on n'a PAS le +15 : apres chknum, BP vaut
0BE484                   	;    deja B-15, c'est-a-dire exactement le bon cadre. Il ne faut donc AUCUN
0BE484                   	;    pmdf sur le chemin de succes. La premiere version gardait le -15 de
0BE484                   	;    BAS_PEEK sans son +15 : elle ecrivait en B-30.
0BE484                   	;
0BE484                   	;    Sur le chemin d'ERREUR, en revanche, il faut le +15 : F5C9A le fait dans
0BE484                   	;    tous les cas, y compris son erreur 33 (LOC_F5C74 saute a LOC_F5C6F).
0BE484                   	;
0BE484                   	; ⛔ ET ON ECRIT (BP+n), PAS (000H). Sous pre_on, "(000H)" designe l'adresse
0BE484                   	;    DIRECTE 0 ; le mode (BP+n) est celui qui n'emet PAS d'octet PRE. Le
0BE484                   	;    controle se fait dans l'OBJET : sur ces lignes, BAS_PEEK ne porte aucun
0BE484                   	;    PRE (E0 05 01, CC 00 00, CD 02 00 00). Une premiere version de ce fichier
0BE484                   	;    portait "30 80 00" -- un PRE, donc l'adresse directe : la fonction lisait
0BE484                   	;    la RAM interne 0 au lieu du cadre de l'argument.
0BE484                   	;
0BE484                   	;       xasm2026-4 BASEXT.ASM -O -L -S -B -K
0BE484                   	; ============================================================================
0BE484                   	; CE FICHIER EST AUSSI INCLUS PAR C:\Claude\BASEXT-DRV (BASEXT residant dans un
0BE484                   	; bloc de pilote de S1:). Le pilote pose « def basext_pilote » puis fait
0BE484                   	; « include ..\..\BASEXT\src\BASEXT.ASM » : l'include de pce500.inc, l'org et
0BE484                   	; le pre_on ci-dessous sont alors les SIENS, et le corps est assemble a sa place
0BE484                   	; dans le bloc. Le module autonome, lui, ne definit rien et reste identique a
0BE484                   	; l'octet (verifie le 2026-09-16 : .OBJ inchange).
0BE484                   	;
0BE484                   	;    ⚠️ Le pilote RELOGE ce corps : sa table de relocation est mesuree par
0BE484                   	;       double assemblage (BASEXT-DRV/outils/reloc.py). Deux regles en
0BE484                   	;       decoulent pour tout ajout ici :
0BE484                   	;       - aucun octet ne doit dependre de l'adresse autrement que par un champ
0BE484                   	;         de 2 ou 3 octets (un « db etiquette/256 » isole est refuse) ;
0BE484                   	;       - aucun « assert » sur une adresse ABSOLUE (il echouerait aux autres
0BE484                   	;         origines) : ecrire les assertions en differences d'etiquettes.
0BE484                   	;
0BE484                   	;    ⛔ IFNDEF teste un symbole pose par DEF, PAS par EQU : un
0BE484                   	;       « basext_pilote: equ 1 » ne masque rien (mesure le 2026-09-16).
0BE484                   	; ============================================================================
0BE484                   	
0BE484                   	
0BE484                   	; --- les entrees LOINTAINES de la ROM (toutes terminees par RETF) -----------
0BE484                   	chknum:   equ   0EFBF3H    ; evalue l'expression numerique, verifie le type
0BE484                   	dec2bin:  equ   0EFAD4H    ; le nombre -> entier 24 bits en (bp+1)..(bp+3)
0BE484                   	bin2dec:  equ   0EFB6FH    ; l'entier de (bp+0)..(bp+3) -> nombre BASIC
0BE484                   	
0BE484                   	; ⛔ DEUX EVALUATEURS, ET ILS NE LISENT PAS LA MEME CHOSE.
0BE484                   	;    chknum (0EFBF3h) ne lit qu'UN TERME : un nombre, une variable, un appel de
0BE484                   	;    fonction, ou une expression entre parentheses -- mais il s'arrete au premier
0BE484                   	;    OPERATEUR. C'est ce que PEEK emploie (0F5F9Ch), et c'est pourquoi
0BE484                   	;    « PEEK &BFD1C*&100 » se lit « (PEEK &BFD1C)*&100 ».
0BE484                   	;    eval (0EF26Eh) evalue une EXPRESSION COMPLETE, operateurs compris. C'est ce
0BE484                   	;    qu'emploie POINT (x,y), via SUB_F5F65 en 0F5F65h -- et la reconnaissance des
0BE484                   	;    operateurs AND/OR/XOR est cablee juste a cote, en 0EF2C5h. Douze sites de la
0BE484                   	;    ROM l'appellent par « callf ».
0BE484                   	;
0BE484                   	;    MOD emprunte sa syntaxe a POINT : il lui faut donc le second, et LPEEK garde
0BE484                   	;    le premier puisqu'il est calque sur PEEK. Mesure sur machine avant la
0BE484                   	;    correction : MOD (17,5) et MOD (A,B) passaient, mais MOD (A+1,B) et
0BE484                   	;    MOD (I*3571,997) rendaient une erreur -- chknum lisait « A », puis butait
0BE484                   	;    sur le « + ».
0BE484                   	;
0BE484                   	;    ⚠️ eval ne signale PAS lui-meme le type : ses appelants de la ROM font le
0BE484                   	;    « test (000h),080h » a sa suite (0F5F6Bh). On fait de meme.
0BE484                   	eval:     equ   0EF26EH    ; expression numerique complete -> (bp+0)
0BE484                   	
0BE484                   	
0BE484                   	tk_lp:    equ   007H       ; LPEEK -- libre dans la table de la ROM
0BE484                   	tk_wp:    equ   00AH       ; WPEEK -- libre aussi (BASCOM occupe 04-06)
0BE484                   	tk_lpo:   equ   00EH       ; LPOKE -- libre
0BE484                   	tk_mod:   equ   00FH       ; MOD   -- libre
0BE484                   	tk_uc:    equ   0C6H       ; UCASE$ (fonctions chaine ajoutees)
0BE484                   	tk_lc:    equ   0C7H       ; LCASE$
0BE484                   	tk_tr:    equ   0C3H       ; TRIM$
0BE484                   	tk_lt:    equ   0C4H       ; LTRIM$
0BE484                   	tk_rt:    equ   0C5H       ; RTRIM$
0BE484                   	tk_rp:    equ   0C8H       ; REPT$
0BE484                   	tk_sr:    equ   0C9H       ; SREPT$
0BE484                   	tk_in:    equ   0C2H       ; INSTR (rend un NOMBRE)
0BE484                   	tk_xc:    equ   0CAH       ; XCONSOLE (instruction) -- libre, hors BASCOM (CB-CE)
0BE484                   	tk_xcl:   equ   0CFH       ; XCLS     (instruction) -- libre, hors BASCOM
0BE484                   	fhandle:  equ   0BFC6DH    ; FHANDLE : handle -> numero de bloc de controle
0BE484                   	                          ; (absent de pce500.inc ; lu par 0E06A1h)
0BE484                   	alloc:    equ   0EF0DDH    ; reserve BA octets sur U (U -= BA) ; carry = erreur 54
0BE484                   	
0BE484                   	
0BE484                   	; ⛔ NE PAS ECRIRE « baswrk » ICI. C'est la ZONE de travail, en memoire EXTERNE
0BE484                   	;    (0BFD0Eh) -- nom repris du listing de E. Kako, ou il est declare
0BE484                   	;    « baswrk: equ 0bfd0eh ». Le pointeur qu'il nous faut est en RAM INTERNE, a
0BE484                   	;    0D1h, que le carnet nommait « baswrk » lui aussi jusqu'au 2026-09-03 et
0BE484                   	;    nomme desormais « basptr ». Depuis, pce500.inc EXPOSE les deux et le
0BE484                   	;    generateur REFUSE une collision de noms : il n'y a plus d'equ local ici.
0BE484                   	;    Et « mv x,(baswrk) » ne proteste pas : l'operande interne fait 8 bits, XASM
0BE484                   	;    TRONQUE 0BFD0Eh en 0Eh. Le code ecrivait donc les crochets en
0BE484                   	;    [(00Eh)+090h], et la table d'extension n'a jamais ete installee.
0BE484                   	;    Verifiable dans l'objet : on doit lire « 30 84 D1 », pas « 30 84 0E ».
0BE484                   	err_syn:  equ   00AH       ; erreur BASIC 10, Syntax error
0BE484                   	err_range: equ  021H       ; erreur BASIC 33, Data out of range
0BE484                   	err_type: equ   05AH       ; erreur BASIC 90, Type mismatch -- le code que
0BE484                   	                          ; chknum emploie lui-meme (0EFC04h)
0BE484                   	err_buf:  equ   036H       ; erreur BASIC 54, Buffer space exceeded
0BE484                   	err_div:  equ   015H       ; erreur BASIC 21, Division by zero -- le code
0BE484                   	                          ; que la ROM elle-meme emploie, lu en 0ECD67h
0BE484                   	
0BE484                   	
0BE484                   	; ============================================================================
0BE484                   	; L'INSTALLATION -- c'est ici que mene CALL &BF000
0BE484                   	; ============================================================================
0BE484                   	start:
0BE484 2C                	        pushu   x               ; X porte le point de reprise de l'interpreteur
0BE485 2B                	        pushu   i
0BE486                   	; ⚠️ Un filtre d'une version PRECEDENTE du module peut rester branche sur le
0BE486                   	;    handle 0 (voir XCONSOLE) : ses adresses ne valent plus rien. On le
0BE486                   	;    debranche avant tout, en rendant l'entree d'origine du pilote.
0BE486 04 47 ED          	        call    xf_off
0BE489 30 84 D1          	        mv      x,(basptr)
0BE48C                   	
0BE48C                   	; ⛔ NE SAUVER LES CROCHETS QUE S'ILS SONT ENCORE CEUX DE LA ROM.
0BE48C                   	;    Une premiere version sauvait sans regarder : au SECOND CALL &BF000 elle
0BE48C                   	;    ecrasait old_kw et old_disp avec NOS PROPRES tables, et les valeurs
0BE48C                   	;    d'origine etaient perdues -- la desinstallation avec. Constate sur machine
0BE48C                   	;    le 2026-09-05 : le vidage montrait old_kw = 0BF1B1h et old_disp = 0BF1CCh,
0BE48C                   	;    c'est-a-dire kw_table et disp_table de ce module.
0BE48C                   	;
0BE48C                   	;    ⛔ ET LA RAISON N'EST PAS CELLE QUE J'AVAIS ECRITE. J'avais justifie le
0BE48C                   	;    test par « les tables du BASIC vivent en page 0F ». C'est faux : le crochet
0BE48C                   	;    ne pointe JAMAIS sur la table de la ROM. La ROM y ecrit une SENTINELLE,
0BE48C                   	;    0FFFFFh, et cela se lit en 0F93C3h :
0BE48C                   	;
0BE48C                   	;       mv  x,(basptr)
0BE48C                   	;       mv  y,0FFFFFh
0BE48C                   	;       mv  [x+090h],y
0BE48C                   	;       mv  [x+093h],y
0BE48C                   	;
0BE48C                   	;    L'octet de poids fort d'un crochet vierge vaut donc 0Fh, et le test le
0BE48C                   	;    reconnait -- mais ce qu'il reconnait est la sentinelle, pas une table. Une
0BE48C                   	;    extension, elle, vit en RAM, page 0B : son crochet ne peut pas valoir 0Fh.
0BE48C                   	;    Le test est donc juste, et il l'est desormais pour la bonne raison.
0BE48C                   	;
0BE48C                   	;    ⚠️ Il pourrait etre plus strict : comparer les TROIS octets a 0FFFFFh plutot
0BE48C                   	;    que le seul poids fort. En l'etat il accepterait n'importe quel 0Fxxxxh, ce
0BE48C                   	;    qu'aucune extension ne peut produire -- mais la ROM le pourrait un jour.
0BE48C                   	;
0BE48C                   	;    ⚠️ Et il n'y a PAS de chainage : un second module ecraserait le premier.
0BE48C                   	;    Refuser d'ecraser la sauvegarde est donc la seule conduite sensee.
0BE48C 90 84 92          	        mv      a,[x+092H]      ; poids fort du crochet des mots-cles
0BE48F 60 0F             	        cmp     a,00FH          ; encore la table de la ROM ?
0BE491 1A 0E             	        jrnz    deja_ext        ; non : ne rien ecraser
0BE493 95 84 90          	        mv      y,[x+090H]      ; l'ancienne table de mots-cles
0BE496 AD 11 EF 0B       	        mv      [old_kw],y      ;   sauvee : de quoi desinstaller
0BE49A 95 84 93          	        mv      y,[x+093H]      ; l'ancienne table de repartition
0BE49D AD 14 EF 0B       	        mv      [old_disp],y
0BE4A1                   	deja_ext:
0BE4A1 0D 69 ED 0B       	        mv      y,kw_table
0BE4A5 B5 84 90          	        mv      [x+090H],y
0BE4A8 0D D1 ED 0B       	        mv      y,disp_table
0BE4AC B5 84 93          	        mv      [x+093H],y
0BE4AF 3B                	        popu    i
0BE4B0 3C                	        popu    x
0BE4B1 9F                	        rc                      ; carry CLAIR : retour propre a BASIC
0BE4B2 07                	        retf
0BE4B3                   	
0BE4B3                   	; ============================================================================
0BE4B3                   	; LA FONCTION -- l'interpreteur y saute a lpeek_m3 + 3
0BE4B3                   	; ============================================================================
0BE4B3                   	lpeek_m3:
0BE4B3 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BE4B6                   	
0BE4B6                   	lpeek:
0BE4B6 05 F3 FB 0E       	        callf   chknum          ; l'argument -> cadre pousse, nombre en (bp+0)
0BE4BA 1C 27             	        jrc     dehors          ; X n'est pas encore sauve : rien a rendre
0BE4BC 05 D4 FA 0E       	        callf   dec2bin         ; -> entier 24 bits en (bp+1)..(bp+3)
0BE4C0 1C 21             	        jrc     dehors
0BE4C2 80 00             	        mv      a,(BP+0)        ; (bp+0) : bit 3 = signe
0BE4C4 64 08             	        test    a,008H
0BE4C6 1A 1C             	        jrnz    refus           ; adresse negative
0BE4C8 80 03             	        mv      a,(BP+3)        ; l'octet de poids fort du 24 bits
0BE4CA 60 10             	        cmp     a,010H
0BE4CC 1E 16             	        jrnc    refus           ; au-dela de 0FFFFFh : hors de l'espace
0BE4CE                   	
0BE4CE                   	; ⛔ X PORTE LE POINT DE REPRISE, ET bin2dec L'ECRASE.
0BE4CE                   	;    chknum a fait AVANCER X au-dela de l'argument : c'est cette valeur-la que
0BE4CE                   	;    l'interpreteur attend au retour. On la sauve donc APRES chknum, jamais
0BE4CE                   	;    avant -- exactement ou BAS_PEEK place son pushu (0F9F49h).
0BE4CE                   	;    L'oubli ne plante pas : le nom est reconnu, la fonction s'execute, et
0BE4CE                   	;    l'interpreteur reprend n'importe ou -- "Syntax error" sans autre indice.
0BE4CE 2C                	        pushu   x
0BE4CF                   	
0BE4CF 85 01             	        mv      y,(BP+1)        ; l'adresse demandee
0BE4D1 E2 05 01          	        mvp     (BP+1),[y]      ; les TROIS octets a cette adresse
0BE4D4                   	
0BE4D4                   	; ⛔ bin2dec NE CONVERTIT QUE 20 BITS, et c'est lu dans son code (0EFB8Bh) :
0BE4D4                   	;    trois passes de decalage, 8 bits sur (bp+11), 8 sur (bp+12), puis
0BE4D4                   	;    QUATRE seulement sur (bp+13) -- « mv (00Eh),004h ». 8+8+4 = 20. Le quartet
0BE4D4                   	;    haut du troisieme octet est ignore par construction : c'est un convertisseur
0BE4D4                   	;    d'ADRESSE, et une adresse fait 20 bits sur cette machine.
0BE4D4                   	;    Mesure : &345678 revenait en &045678, sans que rien ne le signale.
0BE4D4                   	;    On REFUSE donc plutot que de mentir -- une valeur fausse en silence est
0BE4D4                   	;    pire qu'une erreur.
0BE4D4 80 03             	        mv      a,(BP+3)
0BE4D6 70 F0             	        and     a,0F0H
0BE4D8 1A 12             	        jrnz    hors_plage      ; quartet haut non nul : bin2dec le perdrait
0BE4DA                   	
0BE4DA CC 00 00          	        mv      (BP+0),000H     ; positif, simple precision
0BE4DD 05 6F FB 0E       	        callf   bin2dec         ; -> nombre BASIC en (bp+0)
0BE4E1 9F                	        rc
0BE4E2 3C                	        popu    x               ; rendre son point de reprise a l'interpreteur
0BE4E3                   	dehors:
0BE4E3 07                	        retf
0BE4E4                   	
0BE4E4                   	refus:
0BE4E4 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; +15 : rendre BP comme le fait SUB_F5C9A
0BE4E8 08 0A             	        mv      a,err_syn
0BE4EA 97                	        sc
0BE4EB 07                	        retf
0BE4EC                   	
0BE4EC                   	; La valeur lue depasse 20 bits : erreur 33, celle que SUB_F5C9A emploie pour
0BE4EC                   	; le meme cas. X a ete sauve, il faut le rendre.
0BE4EC                   	hors_plage:
0BE4EC 3C                	        popu    x
0BE4ED 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BE4F1 08 21             	        mv      a,err_range
0BE4F3 97                	        sc
0BE4F4 07                	        retf
0BE4F5                   	
0BE4F5                   	; ============================================================================
0BE4F5                   	; LA SECONDE FONCTION -- WPEEK, deux octets au lieu de trois
0BE4F5                   	; ============================================================================
0BE4F5                   	; Meme structure exactement. Elle n'existe que pour eprouver l'ENCHAINEMENT :
0BE4F5                   	; nos deux tables n'avaient jamais porte qu'une seule entree, donc ni le
0BE4F5                   	; balayage de SUB_F593D (« add y,004h » en boucle) ni celui du tokeniseur
0BE4F5                   	; n'etaient exerces. Deux entrees suffisent a les mettre en defaut s'ils le
0BE4F5                   	; sont -- et a montrer qu'aucune adresse n'en ecrase une autre.
0BE4F5                   	;
0BE4F5                   	; WPEEK n'a pas besoin du garde-fou des 20 bits : deux octets tiennent
0BE4F5                   	; toujours dedans.
0BE4F5                   	
0BE4F5                   	wpeek_m3:
0BE4F5 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BE4F8                   	
0BE4F8                   	wpeek:
0BE4F8 05 F3 FB 0E       	        callf   chknum
0BE4FC 1C 24             	        jrc     dehors2
0BE4FE 05 D4 FA 0E       	        callf   dec2bin
0BE502 1C 1E             	        jrc     dehors2
0BE504 80 00             	        mv      a,(BP+0)
0BE506 64 08             	        test    a,008H
0BE508 1A 19             	        jrnz    refus2
0BE50A 80 03             	        mv      a,(BP+3)
0BE50C 60 10             	        cmp     a,010H
0BE50E 1E 13             	        jrnc    refus2
0BE510 2C                	        pushu   x
0BE511 85 01             	        mv      y,(BP+1)
0BE513                   	; ⛔ mvw, PAS mv. Les trois largeurs sont mv (1 octet), mvw (2) et mvp (3) --
0BE513                   	;    « mv » ne transfere QU'UN octet, et un commentaire disant « deux octets :
0BE513                   	;    mv, pas mvp » ne le rend pas vrai. Mesure : WPEEK rendait F178 et F1B8,
0BE513                   	;    l'octet bas juste et l'octet haut jamais ecrit, donc laisse a sa valeur
0BE513                   	;    precedente -- F1 les deux fois.
0BE513 E1 05 01          	        mvw     (BP+1),[y]      ; DEUX octets
0BE516 CC 03 00          	        mv      (BP+3),000H     ; le troisieme reste nul
0BE519 CC 00 00          	        mv      (BP+0),000H
0BE51C 05 6F FB 0E       	        callf   bin2dec
0BE520 9F                	        rc
0BE521 3C                	        popu    x
0BE522                   	dehors2:
0BE522 07                	        retf
0BE523                   	
0BE523                   	refus2:
0BE523 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BE527 08 0A             	        mv      a,err_syn
0BE529 97                	        sc
0BE52A 07                	        retf
0BE52B                   	
0BE52B                   	; ============================================================================
0BE52B                   	; L'INSTRUCTION LPOKE destination,valeur1,valeur2,...
0BE52B                   	; ============================================================================
0BE52B                   	; Ecrit chaque valeur sur TROIS octets, en ordre petit-boutien, a des adresses
0BE52B                   	; consecutives :
0BE52B                   	;
0BE52B                   	;   LPOKE &BF000,&123456,&789ABC   met 56 34 12 en &BF000
0BE52B                   	;                                  puis BC 9A 78 en &BF003
0BE52B                   	;
0BE52B                   	; C'est le pendant de LPEEK, et il comble un manque reel : ces pointeurs de
0BE52B                   	; trois octets se decomposaient jusqu'ici a la main, cote BASIC --
0BE52B                   	;   AH=INT (AD/&10000):AM=INT ((AD-AH*&10000)/&100):AL=AD-AH*&10000-AM*&100
0BE52B                   	;   POKE dest,AL,AM,AH
0BE52B                   	;
0BE52B                   	; ⛔ C'EST UNE INSTRUCTION, PAS UNE FONCTION. Le resolveur de la ROM n'est donc
0BE52B                   	;    pas le meme : 0F58E5h teste le bit 7 et prend l'adresse TELLE QUELLE, la ou
0BE52B                   	;    0F590Bh teste le bit 6 et ajoute 3. L'entree de repartition porte donc 080h
0BE52B                   	;    et il n'y a PAS de prefixe de trois octets devant le point d'entree.
0BE52B                   	;
0BE52B                   	; ⛔ LA BOUCLE EST CELLE DE BAS_POKE (0F9F27h), Y COMPRIS SA SORTIE.
0BE52B                   	;    On lit un caractere, on le compare a 02Ch ; si ce n'est pas une virgule, on
0BE52B                   	;    rend la main -- mais en REMETTANT le caractere par un « dec x ». La ROM le
0BE52B                   	;    fait par une chute : son « rc » de 0F9F2Fh tombe dans le « dec x » de
0BE52B                   	;    0F9F30h, partage avec le chemin d'erreur. On copie cette disposition.
0BE52B                   	;
0BE52B                   	; ⛔ ET CHAQUE chknum PREND UN CADRE DE 15 OCTETS, QU'IL FAUT RENDRE.
0BE52B                   	;    LPEEK n'appelle chknum qu'une fois et n'a donc jamais eu a s'en soucier.
0BE52B                   	;    Ici la boucle en appelle un par valeur : sans le « pmdf +15 » apres chacune,
0BE52B                   	;    les cadres s'empilent et BP finit par sortir de sa zone. Le compte doit
0BE52B                   	;    revenir a zero sur TOUS les chemins, erreurs comprises.
0BE52B                   	;
0BE52B                   	; ⛔ PORTEE DES VALEURS : 20 BITS, ET C'EST dec2bin QUI L'IMPOSE.
0BE52B                   	;    Son code (0EFB8Bh) ne convertit que 8+8+4 bits -- constate en ecrivant
0BE52B                   	;    LPEEK. Une valeur au-dela de 0FFFFFh serait donc tronquee AVANT de nous
0BE52B                   	;    parvenir, sans que rien ne le signale et sans que nous puissions le
0BE52B                   	;    detecter apres coup. Sans consequence pour l'usage vise, une adresse de
0BE52B                   	;    cette machine faisant 20 bits, mais cela doit etre dit.
0BE52B                   	
0BE52B                   	lpoke:
0BE52B 05 F3 FB 0E       	        callf   chknum          ; l'adresse de destination
0BE52F 1C 42             	        jrc     lp_ret          ; chknum a echoue : il n'a pas pris de cadre
0BE531 05 D4 FA 0E       	        callf   dec2bin
0BE535 1C 3C             	        jrc     lp_ret
0BE537 80 00             	        mv      a,(BP+0)        ; bit 3 = signe
0BE539 64 08             	        test    a,008H
0BE53B 1A 37             	        jrnz    lp_syn
0BE53D 80 03             	        mv      a,(BP+3)
0BE53F 60 10             	        cmp     a,010H
0BE541 1E 31             	        jrnc    lp_syn          ; au-dela de 0FFFFFh
0BE543 85 01             	        mv      y,(BP+1)        ; Y = la destination
0BE545 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; rendre le cadre de la destination
0BE549                   	
0BE549                   	lp_next:
0BE549 90 24             	        mv      a,[x++]
0BE54B 60 2C             	        cmp     a,02CH          ; ','
0BE54D 1A 21             	        jrnz    lp_done         ; plus de virgule : c'est fini
0BE54F 2D                	        pushu   y               ; la destination, que chknum n'a pas a connaitre
0BE550 05 F3 FB 0E       	        callf   chknum          ; la valeur
0BE554 1C 26             	        jrc     lp_pop
0BE556 05 D4 FA 0E       	        callf   dec2bin
0BE55A 1C 20             	        jrc     lp_pop
0BE55C 80 00             	        mv      a,(BP+0)
0BE55E 64 08             	        test    a,008H
0BE560 1A 1C             	        jrnz    lp_popsyn       ; valeur negative
0BE562 3D                	        popu    y
0BE563 EA 05 01          	        mvp     [y],(BP+1)      ; les TROIS octets, petit-boutien
0BE566 08 03             	        mv      a,003H
0BE568 45 50             	        add     y,a             ; adresse suivante
0BE56A 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; rendre le cadre de la valeur
0BE56E 13 27             	        jr      lp_next
0BE570                   	
0BE570                   	; --- sortie ----------------------------------------------------------------
0BE570                   	; « rc » tombe dans « dec x » : la disposition de BAS_POKE, ou le chemin de
0BE570                   	; succes et celui d'erreur partagent la remise en place du caractere.
0BE570                   	lp_done:
0BE570 9F                	        rc
0BE571                   	lp_back:
0BE571 7C 04             	        dec     x               ; rendre le caractere qui n'etait pas une virgule
0BE573                   	lp_ret:
0BE573 07                	        retf
0BE574                   	
0BE574                   	lp_syn:
0BE574 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BE578 08 0A             	        mv      a,err_syn
0BE57A 97                	        sc
0BE57B 07                	        retf
0BE57C                   	
0BE57C                   	; chknum ou dec2bin a echoue alors que Y etait empile : le depiler, et ne PAS
0BE57C                   	; rendre de cadre -- chknum n'en a pas pris.
0BE57C                   	lp_pop:
0BE57C 3D                	        popu    y
0BE57D 07                	        retf
0BE57E                   	
0BE57E                   	lp_popsyn:
0BE57E 3D                	        popu    y
0BE57F 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BE583 08 0A             	        mv      a,err_syn
0BE585 97                	        sc
0BE586 07                	        retf
0BE587                   	
0BE587                   	; ============================================================================
0BE587                   	; LA FONCTION MOD (A,B) -- le reste de la division entiere
0BE587                   	; ============================================================================
0BE587                   	; L'interpreteur y saute a modu_m3 + 3 : c'est une FONCTION (drapeau 040h).
0BE587                   	;
0BE587                   	;   PRINT MOD (17,5)      2
0BE587                   	;   R = MOD (A,B)
0BE587                   	;
0BE587                   	; ⛔ PAS D'INFIXE POSSIBLE. « A MOD B » est hors d'atteinte : la reconnaissance
0BE587                   	;    des operateurs est CABLEE EN DUR dans l'analyseur d'expression, en 0EF2C5h,
0BE587                   	;    par trois comparaisons litterales contre 0A1h (AND), 0A2h (OR) et 0A5h
0BE587                   	;    (XOR) -- ni table, ni plage, et nos deux crochets n'y donnent pas acces.
0BE587                   	;    La syntaxe est donc celle de POINT (x,y), que la machine possede deja.
0BE587                   	;
0BE587                   	; ⛔ ET LE CALCUL N'EMPRUNTE RIEN A LA BIBLIOTHEQUE FLOTTANTE DE LA ROM. Deux
0BE587                   	;    versions ont essaye de calculer A - B * INT (A/B) par les commandes du
0BE587                   	;    device 9 ; les deux ont plante la machine (CLS puis MENU principal), et la
0BE587                   	;    seconde alors meme que ses cinq adresses etaient JUSTES -- verifiees une a
0BE587                   	;    une dans la table de repartition DB_EF078 du driver drv_function :
0BE587                   	;
0BE587                   	;      047h add 0ECBA9h   048h sub 0ECBB4h   049h mul 0ECBBFh
0BE587                   	;      04Ah div 0ECBD8h   056h int 0EE4D5h
0BE587                   	;
0BE587                   	;    Ce que ces adresses ne disent pas, c'est le CONTRAT. Il y a deux diviseurs
0BE587                   	;    (SUB_ECCEA et SUB_ECD85), l'entree 04Ah ne mene qu'au second, et le seul
0BE587                   	;    appelant connu de la ROM -- l'evaluateur d'expression en 0E8559h -- fait
0BE587                   	;    « mv i,0000Fh / exl (000h),(00Fh) » AVANT d'appeler : il ECHANGE X et Y,
0BE587                   	;    ce que ne fait aucune des trois autres operations.
0BE587                   	;
0BE587                   	;    Le calcul est donc fait ici, en binaire, et ne s'appuie que sur des
0BE587                   	;    primitives EPROUVEES SUR LA MACHINE par LPEEK et LPOKE : chknum, dec2bin,
0BE587                   	;    bin2dec.
0BE587                   	;
0BE587                   	; ⛔ ET ON NE SUPPOSE RIEN DE CE QUE chknum FAIT DE BP. Une premiere version
0BE587                   	;    binaire tenait pour acquis qu'un chknum EMPILE un cadre de 15 octets, donc
0BE587                   	;    qu'apres le second appel le premier operande se lisait en (bp+16)..(bp+18).
0BE587                   	;    Je l'avais deduit d'un enchainement de la ROM en 0ECBCAh -- une inference,
0BE587                   	;    pas une mesure. LA MACHINE L'A DEMENTIE : elle rendait 0 pour toutes les
0BE587                   	;    valeurs, ce qui est la signature d'un A perdu (0 mod B, ou B mod B).
0BE587                   	;
0BE587                   	;    Plutot que de deviner une troisieme fois la taille et le sens du cadre,
0BE587                   	;    cette version REND LA QUESTION SANS OBJET :
0BE587                   	;      . le premier operande est mis a l'abri en RAM du module (sv_a) des que
0BE587                   	;        dec2bin l'a converti, donc avant que le second chknum ne puisse rien
0BE587                   	;        ecraser ;
0BE587                   	;      . BP est SAUVE et RESTAURE en absolu (sv_bp0, sv_bp1) au lieu d'etre
0BE587                   	;        rattrape par des pmdf comptes a la main.
0BE587                   	;    Le module se comporte alors exactement comme LPEEK, qui lui fonctionne :
0BE587                   	;    resultat en (bp+0)..(bp+3), BP tel qu'il etait apres LE PREMIER chknum.
0BE587                   	;    Que chknum empile 15 octets, 8, ou rien du tout, le resultat est le meme.
0BE587                   	;
0BE587                   	; LE DOMAINE : A et B sont des ENTIERS de 0 a 1048575, celui de LPEEK et de
0BE587                   	; LPOKE. La borne n'est pas un choix mais une mesure : dec2bin accumule dans X,
0BE587                   	; registre de 20 bits, et REFUSE lui-meme au-dela (« add x,a / jrc » en
0BE587                   	; 0EFAFBh, puis erreur 33) -- c'est donc la ROM, et non nous, qui signale un
0BE587                   	; operande trop grand. Un operande negatif est refuse ici : dec2bin en rend la
0BE587                   	; valeur absolue en laissant le signe dans le bit 3 de (bp+0), donc l'ignorer
0BE587                   	; rendrait un resultat faux en silence. Le reste etant toujours < B, il tient
0BE587                   	; toujours dans les 20 bits que bin2dec sait reconvertir.
0BE587                   	
0BE587                   	modu_m3:
0BE587 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BE58A                   	
0BE58A                   	modu:
0BE58A                   	; ⛔ LES PARENTHESES SONT OBLIGATOIRES, ET C'EST LA ROM QUI LE DIT.
0BE58A                   	;    SUB_FD5E7, le lecteur d'arguments de POINT (x,y), exige TROIS caracteres :
0BE58A                   	;    '(' en 0FD5ECh, ',' en 0FD5F9h et ')' en 0FD60Ah. Une premiere version de
0BE58A                   	;    cette fonction n'en verifiait qu'un : chknum recevait (17,5) tout entier et
0BE58A                   	;    tentait d'evaluer une expression parenthesee. PRINT MOD(17,5) repondait
0BE58A                   	;    Syntax error. Constate sur emulateur, corrige en relisant SUB_FD5E7.
0BE58A                   	md_sp:
0BE58A 90 24             	        mv      a,[x++]
0BE58C 60 20             	        cmp     a,020H          ; sauter les espaces -- ce que fait SUB_FB2D9
0BE58E 19 06             	        jrz     md_sp
0BE590 60 28             	        cmp     a,028H          ; '(' obligatoire
0BE592 1A 98             	        jrnz    md_syn0
0BE594                   	
0BE594                   	; BP a l'entree : l'etat a rendre si l'on doit signaler une erreur, puisque
0BE594                   	; c'est celui d'avant tout ce que nous avons pu prendre.
0BE594 30 D8 0D EE 0B EC 	        mv      [!sv_bp0],(bp_ram)
0BE59A                   	
0BE59A                   	; --- A, le dividende --------------------------------------------------------
0BE59A 05 6E F2 0E       	        callf   eval            ; expression complete -> (bp+0)
0BE59E 1C 8B             	        jrc     md_ret          ; echec : rien n'a ete pris
0BE5A0 65 00 80          	        test    (BP+0),080H     ; bit 7 : c'est une chaine
0BE5A3 1A 9F             	        jrnz    md_type
0BE5A5                   	
0BE5A5                   	; ⛔ BP D'APRES LA PREMIERE EVALUATION, SAUVE EN ABSOLU. Le cadre pousse par
0BE5A5                   	;    chknum vaut 15 octets, MESURE sur machine (BP 150 -> 135). Celui d'eval
0BE5A5                   	;    ne l'est PAS : je ne le suppose donc pas, et je restaure BP par sa valeur
0BE5A5                   	;    plutot que par un pmdf compte a la main. sv_bp0 et sv_bp1 etant tous deux
0BE5A5                   	;    lisibles depuis le BASIC, l'ecart se mesurera au prochain essai.
0BE5A5 30 D8 0E EE 0B EC 	        mv      [!sv_bp1],(bp_ram)
0BE5AB                   	
0BE5AB 05 D4 FA 0E       	        callf   dec2bin         ; A -> entier 20 bits en (bp+1)..(bp+3)
0BE5AF 1C 7A             	        jrc     md_ret
0BE5B1 65 00 08          	        test    (BP+0),008H     ; bit 3 : le signe
0BE5B4 1A 98             	        jrnz    md_neg
0BE5B6                   	
0BE5B6                   	; ⛔ A EST MIS A L'ABRI ICI, ET C'EST TOUT L'INTERET DE CETTE VERSION. Le second
0BE5B6                   	;    chknum ecrit sa valeur en (bp+0), et rien ne garantit qu'il ait d'abord
0BE5B6                   	;    decale le cadre : la version precedente l'a suppose et perdait A.
0BE5B6 DA 0A EE 0B 01    	        mvp     [!sv_a],(BP+1)
0BE5BB                   	
0BE5BB 90 24             	        mv      a,[x++]
0BE5BD 60 2C             	        cmp     a,02CH          ; ',' obligatoire : il faut DEUX arguments
0BE5BF 1A 79             	        jrnz    md_syn
0BE5C1                   	
0BE5C1                   	; --- B, le diviseur ---------------------------------------------------------
0BE5C1 05 6E F2 0E       	        callf   eval            ; expression complete -> (bp+0)
0BE5C5 1C 6B             	        jrc     md_bad
0BE5C7 65 00 80          	        test    (BP+0),080H     ; bit 7 : c'est une chaine
0BE5CA 1A 78             	        jrnz    md_type
0BE5CC 05 D4 FA 0E       	        callf   dec2bin         ; B -> entier 20 bits en (bp+1)..(bp+3)
0BE5D0 1C 60             	        jrc     md_bad
0BE5D2 65 00 08          	        test    (BP+0),008H
0BE5D5 1A 77             	        jrnz    md_neg
0BE5D7                   	
0BE5D7 90 24             	        mv      a,[x++]
0BE5D9 60 29             	        cmp     a,029H          ; ')' obligatoire
0BE5DB 1A 5D             	        jrnz    md_syn
0BE5DD                   	
0BE5DD                   	; --- B = 0 : erreur 21, celle que la ROM emploie pour le meme cas (0ECD67h) --
0BE5DD 80 01             	        mv      a,(BP+1)
0BE5DF 7F 02             	        or      a,(BP+2)
0BE5E1 7F 03             	        or      a,(BP+3)
0BE5E3 18 73             	        jrz     md_zero
0BE5E5                   	
0BE5E5 2C                	        pushu   x               ; le point de reprise de l'interpreteur
0BE5E6                   	
0BE5E6                   	; ============================================================================
0BE5E6                   	; LA DIVISION BINAIRE A RESTAURATION -- 24 tours, tout en RAM interne
0BE5E6                   	; ============================================================================
0BE5E6                   	; Tout tient dans la QUEUE du cadre courant, (bp+4) a (bp+14), dont dec2bin n'a
0BE5E6                   	; plus l'usage. C'est de la RAM interne, donc rapide, et cela reste valable quel
0BE5E6                   	; que soit le cadre ou nous sommes.
0BE5E6                   	;
0BE5E6                   	;   A    : (bp+4),(bp+5),(bp+6)     relu de sv_a ; consomme par le decalage --
0BE5E6                   	;                                   le quotient est jete, MOD n'en veut pas
0BE5E6                   	;   cnt  : (bp+7)                   le compteur de tours
0BE5E6                   	;   rst  : (bp+8),(bp+9),(bp+10)    le reste en construction
0BE5E6                   	;   tmp  : (bp+12),(bp+13),(bp+14)  rst - B, garde s'il n'y a pas d'emprunt
0BE5E6                   	;   B    : (bp+1),(bp+2),(bp+3)     la ou dec2bin vient de le mettre
0BE5E6                   	;
0BE5E6                   	; ⛔ SHL, ET SURTOUT PAS ROL -- C'EST LA QUE MOD RENDAIT 0 POUR TOUT.
0BE5E6                   	;    Sur ce processeur, ROL/ROR sont CIRCULAIRES dans l'octet : la retenue recoit
0BE5E6                   	;    bien le bit sortant, mais ce bit revient aussi en bas du MEME octet, et rien
0BE5E6                   	;    ne passe a l'octet suivant. Une premiere version decalait A avec six « rol » :
0BE5E6                   	;    chaque octet tournait sur lui-meme, le reste ne recevait jamais aucun bit et
0BE5E6                   	;    valait donc 0 -- pour toutes les valeurs, ce qu'a montre la machine.
0BE5E6                   	;
0BE5E6                   	;    LA ROM TRANCHE, ET DANS LES DEUX SENS :
0BE5E6                   	;      . elle CHAINE « shr » sur des octets consecutifs -- « F5 12 F5 13 F5 14
0BE5E6                   	;        F5 15 F5 16 » en 0EEBB8h, un decalage de cinq octets. Seul un decalage
0BE5E6                   	;        A TRAVERS la retenue peut se chainer ainsi ;
0BE5E6                   	;      . et elle emploie « ror » la ou il faut LIRE les bits sans detruire
0BE5E6                   	;        l'octet : bin2dec fait « ror (00Bh) / jrnc » huit fois par octet
0BE5E6                   	;        (0EFBA3h), et huit rotations circulaires le rendent intact.
0BE5E6                   	;    Les deux usages sont coherents, et ils s'excluent.
0BE5E6                   	;
0BE5E6                   	; 📄 Notre propre reference (SC62015_InstructionSet_Reference.md) decrit ROL et
0BE5E6                   	;    SHL de la MEME facon, « via C » -- ce qui ne peut pas etre vrai des deux.
0BE5E6                   	;    A corriger la-bas : la ROM est l'arbitre.
0BE5E6                   	;
0BE5E6                   	; ⛔ ET CES DECALAGES NE CONSULTENT PAS I. bin2dec enchaine « ror (00Bh) / jrnc »
0BE5E6                   	;    alors que IL vaut encore 4 d'un dadl precedent, et n'en rotationne qu'un
0BE5E6                   	;    octet. Les instructions BLOC, elles, bouclent I fois -- « mv il,00Fh /
0BE5E6                   	;    mvl (000h),(00Fh) » de la ROM recopie bien 15 octets.
0BE5E6                   	md_calc:
0BE5E6 D2 04 0A EE 0B    	        mvp     (BP+4),[!sv_a]  ; A, revenu de l'abri
0BE5EB DC 08 00 00 00    	        mvp     (BP+8),000000H  ; reste = 0
0BE5F0 CC 07 18          	        mv      (BP+7),00024    ; 24 tours : la largeur de A
0BE5F3                   	md_loop:
0BE5F3 9F                	        rc
0BE5F4 F7 04             	        shl     (BP+4)          ; A <<= 1 ; le bit sortant part dans la retenue
0BE5F6 F7 05             	        shl     (BP+5)
0BE5F8 F7 06             	        shl     (BP+6)
0BE5FA F7 08             	        shl     (BP+8)          ; reste = reste<<1 | ce bit
0BE5FC F7 09             	        shl     (BP+9)
0BE5FE F7 0A             	        shl     (BP+10)
0BE600                   	
0BE600 CA 0C 08          	        mvp     (BP+12),(BP+8)  ; tmp = reste
0BE603 9F                	        rc                      ; SBCL retranche AUSSI la retenue : la vider
0BE604 09 03             	        mv      il,003
0BE606 5C 0C 01          	        sbcl    (BP+12),(BP+1)  ; tmp = reste - B, sur trois octets
0BE609 1C 03             	        jrc     md_next         ; emprunt : reste < B, on ne retranche pas
0BE60B CA 08 0C          	        mvp     (BP+8),(BP+12)  ; sinon le reste devient tmp
0BE60E                   	md_next:
0BE60E 7D 07             	        dec     (BP+7)
0BE610 1B 1F             	        jrnz    md_loop
0BE612                   	
0BE612                   	; --- rendre le reste exactement comme LPEEK rend le sien --------------------
0BE612                   	; ⛔ LE DECALAGE DE chknum EST DESORMAIS MESURE, ET NON SUPPOSE. Le module a
0BE612                   	;    laisse BP en RAM avant et apres son premier chknum ; releve sur la machine :
0BE612                   	;    96h puis 87h, soit QUINZE octets tout rond. Le cadre du resultat est donc
0BE612                   	;    celui d'un pmdf +15, et sv_a n'a plus a servir de pont -- ce qui le laisse
0BE612                   	;    porter A, donc mesurable a son tour.
0BE612                   	; sv_a a rendu A a la boucle : il sert maintenant de pont vers l'autre cadre.
0BE612 DA 0A EE 0B 08    	        mvp     [!sv_a],(BP+8)          ; le reste, le temps de changer de cadre
0BE617 30 D0 EC 0E EE 0B 	        mv      (bp_ram),[!sv_bp1]      ; le cadre du resultat, en ABSOLU
0BE61D CC 00 00          	        mv      (BP+0),000H             ; positif, simple precision
0BE620 D2 01 0A EE 0B    	        mvp     (BP+1),[!sv_a]
0BE625 05 6F FB 0E       	        callf   bin2dec                 ; -> nombre BASIC en (bp+0)
0BE629 3C                	        popu    x
0BE62A 9F                	        rc
0BE62B                   	md_ret:
0BE62B 07                	        retf
0BE62C                   	
0BE62C                   	; ============================================================================
0BE62C                   	; LES ERREURS
0BE62C                   	; ============================================================================
0BE62C                   	; ⛔ ON NE COMPTE PAS LES CADRES, ON RESTAURE BP. C'est la ce qui rend ces
0BE62C                   	;    sorties sures : rendre l'etat d'avant l'appel est la politique de la ROM
0BE62C                   	;    elle-meme (0ECD63h rend ce qu'il a pris avant de signaler l'erreur 21), et
0BE62C                   	;    une restauration ABSOLUE ne peut pas se tromper de compte -- meme apres un
0BE62C                   	;    dec2bin en echec, qui a deja rendu le sien (LOC_ECB5C : sc / pmdf +15 / ret).
0BE62C                   	
0BE62C                   	; '(' manquante : la ROM remet le caractere en place avant de se plaindre
0BE62C                   	; (LOC_FD619) ; on fait de meme. Rien n'a encore ete pris, ni meme sv_bp0 ecrit.
0BE62C                   	md_syn0:
0BE62C 7C 04             	        dec     x
0BE62E 08 0A             	        mv      a,err_syn
0BE630 97                	        sc
0BE631 07                	        retf
