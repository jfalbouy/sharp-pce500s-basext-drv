0BEDD1                   	disp_table:
0BEDD1                   	; Trois entrees de 4 octets, puis le terminateur. Le quartet haut du 3e octet
0BEDD1                   	; d'adresse est un DRAPEAU : 040h = fonction, routine a l'adresse + 3 ; 080h =
0BEDD1                   	; instruction, routine a l'adresse telle quelle. LPOKE est du second genre, et
0BEDD1                   	; n'a donc pas de prefixe de trois octets.
0BEDD1 07                	        db      tk_lp
0BEDD2 B3                	        db      lpeek_m3
0BEDD3 E4                	        db      lpeek_m3/256
0BEDD4 4B                	        db      lpeek_m3/65536+040H
0BEDD5 0A                	        db      tk_wp
0BEDD6 F5                	        db      wpeek_m3
0BEDD7 E4                	        db      wpeek_m3/256
0BEDD8 4B                	        db      wpeek_m3/65536+040H
0BEDD9 0E                	        db      tk_lpo
0BEDDA 2B                	        db      lpoke
0BEDDB E5                	        db      lpoke/256
0BEDDC 8B                	        db      lpoke/65536+080H
0BEDDD 0F                	        db      tk_mod
0BEDDE 87                	        db      modu_m3
0BEDDF E5                	        db      modu_m3/256
0BEDE0 4B                	        db      modu_m3/65536+040H
0BEDE1 C6 AA E6 4B       	        db      tk_uc, ucase_m3, ucase_m3/256, ucase_m3/65536+040H
0BEDE5 C7 D5 E6 4B       	        db      tk_lc, lcase_m3, lcase_m3/256, lcase_m3/65536+040H
0BEDE9 C3 00 E7 4B       	        db      tk_tr, trim_m3,  trim_m3/256,  trim_m3/65536+040H
0BEDED C4 07 E7 4B       	        db      tk_lt, ltrim_m3, ltrim_m3/256, ltrim_m3/65536+040H
0BEDF1 C5 0E E7 4B       	        db      tk_rt, rtrim_m3, rtrim_m3/256, rtrim_m3/65536+040H
0BEDF5 C8 99 E7 4B       	        db      tk_rp, rept_m3,  rept_m3/256,  rept_m3/65536+040H
0BEDF9 C9 7E E8 4B       	        db      tk_sr, srept_m3, srept_m3/256, srept_m3/65536+040H
0BEDFD C2 8C E9 4B       	        db      tk_in, instr_m3, instr_m3/256, instr_m3/65536+040H
0BEE01 CA B3 EA 8B       	        db      tk_xc,  xconsole, xconsole/256, xconsole/65536+080H   ; instructions :
0BEE05 CF 93 EB 8B       	        db      tk_xcl, xcls,     xcls/256,     xcls/65536+080H       ; pas de +3
0BEE09 00                	        db      0                       ; fin de table
0BEE0A                   	
0BEE0A                   	; ============================================================================
0BEE0A                   	; LES CROCHETS D'ORIGINE, pour desinstaller
0BEE0A                   	; ============================================================================
0BEE0A                   	; Le premier operande, hors d'atteinte du second chknum. Il n'est PLUS ecrase
0BEE0A                   	; ensuite : apres un appel, LPEEK &BF1EC rend A tel que dec2bin l'a converti.
0BEE0A                   	; C'est notre seul point de mesure, et le module doit rester assez court pour
0BEE0A                   	; que le BASIC ne vienne pas le manger -- le vidage du 2026-09-05 montre du
0BEE0A                   	; texte BASIC des 0BF1F7h.
0BEE0A 00 00 00          	sv_a:     db    0,0,0
0BEE0D 00                	sv_bp0:   db    0             ; BP a l'entree -- l'etat a rendre en erreur
0BEE0E 00                	sv_bp1:   db    0             ; BP apres la 1re evaluation -- cadre du resultat
0BEE0F                   	
0BEE0F                   	; ⛔ LES TROIS TEMOINS DE MESURE ONT ETE RETIRES LE 2026-09-05, une fois MOD
0BEE0F                   	;    valide sur machine. Ils portaient A et B tels que dec2bin les rendait, et le
0BEE0F                   	;    reste au sortir de la boucle ; c'est par eux que la cause a ete trouvee deux
0BEE0F                   	;    fois, la ou le raisonnement s'etait trompe. Les remettre est l'affaire de
0BEE0F                   	;    trois « mvp [!dbg_x],(BP+n) » et de trois mots de 3 octets -- le faire
0BEE0F                   	;    plutot que de deviner, si la fonction se remet a mentir.
0BEE0F                   	
0BEE0F                   	
0BEE0F 00                	tmode:    db    0
0BEE10 00                	rp_n:     db    0
0BEE11 00                	rp_c:     db    0
0BEE12 00                	in_start: db    0
0BEE13 00                	in_lt:    db    0
0BEE14 00                	in_res:   db    0
0BEE15 00                	in_p:     db    0
0BEE16 00                	sr_n:     db    0
0BEE17 00                	sr_cnt:   db    0
0BEE18 00 00 00          	sr_src:   db    0,0,0
0BEE1B 00                	xc_t:     db    0             ; XCONSOLE : debut lu
0BEE1C 00                	xc_c:     db    0             ; XCONSOLE : nombre lu, 0FFh = absent
0BEE1D 00                	xc_top:   db    0             ; la premiere ligne de la fenetre, relue par XCLS
0BEE1E 00                	xcl_y:    db    0             ; XCLS : la ligne en cours d'effacement
0BEE1F 00                	xf_w:     db    0             ; filtre : 1 si retour a la ligne differe
0BEE20 00                	xf_y:     db    0             ; filtre : la ligne en cours de remontee
