0BEB3D 3C                	        popu    x
0BEB3E 30 D0 EC 0D EE 0B 	        mv      (bp_ram),[!sv_bp0]
0BEB44 9F                	        rc
0BEB45 07                	        retf
0BEB46                   	
0BEB46                   	xc_syn:
0BEB46 08 0A             	        mv      a,err_syn
0BEB48 12 02             	        jr      xc_err
0BEB4A                   	xc_range:
0BEB4A 08 21             	        mv      a,err_range
0BEB4C                   	xc_err:
0BEB4C 30 D0 EC 0D EE 0B 	        mv      (bp_ram),[!sv_bp0]
0BEB52 97                	        sc
0BEB53 07                	        retf
0BEB54                   	
0BEB54                   	; xc_skip -- saute les espaces ; X reste SUR le premier non-espace, rendu dans A.
0BEB54                   	;            APPEL PROCHE.
0BEB54                   	xc_skip:
0BEB54 90 04             	        mv      a,[x]
0BEB56 60 20             	        cmp     a,020H
0BEB58 1A 04             	        jrnz    xs_ret
0BEB5A 6C 04             	        inc     x
0BEB5C 13 0A             	        jr      xc_skip
0BEB5E                   	xs_ret:
0BEB5E 06                	        ret
0BEB5F                   	
0BEB5F                   	; xc_num -- une expression numerique entiere de 0 a 255.
0BEB5F                   	;           CY=0 : A = la valeur, BP rendu a sv_bp0.
0BEB5F                   	;           CY=1 : A = code d'erreur, BP rendu a sv_bp0.  APPEL PROCHE.
0BEB5F                   	xc_num:
0BEB5F 05 6E F2 0E       	        callf   eval
0BEB63 1C 26             	        jrc     xn_fail                 ; A porte deja le code
0BEB65 65 00 80          	        test    (BP+0),080H
0BEB68 1A 1B             	        jrnz    xn_type
0BEB6A 05 D4 FA 0E       	        callf   dec2bin
0BEB6E 1C 1B             	        jrc     xn_fail
0BEB70 65 00 08          	        test    (BP+0),008H
0BEB73 1A 14             	        jrnz    xn_range                ; negatif
0BEB75 80 02             	        mv      a,(BP+2)
0BEB77 7F 03             	        or      a,(BP+3)
0BEB79 1A 0E             	        jrnz    xn_range                ; au-dela de 255
0BEB7B 80 01             	        mv      a,(BP+1)
0BEB7D 30 D0 EC 0D EE 0B 	        mv      (bp_ram),[!sv_bp0]      ; rendre le cadre d'eval
0BEB83 9F                	        rc
0BEB84 06                	        ret
0BEB85                   	xn_type:
0BEB85 08 5A             	        mv      a,err_type
0BEB87 12 02             	        jr      xn_fail
0BEB89                   	xn_range:
0BEB89 08 21             	        mv      a,err_range
0BEB8B                   	xn_fail:
0BEB8B 30 D0 EC 0D EE 0B 	        mv      (bp_ram),[!sv_bp0]
0BEB91 97                	        sc
0BEB92 06                	        ret
0BEB93                   	
0BEB93                   	; ============================================================================
0BEB93                   	; XCLS  --  efface la fenetre de XCONSOLE (INSTRUCTION)
0BEB93                   	; ============================================================================
0BEB93                   	; Pendant de CLS, qui reste celui de la ROM et efface les lignes 0 ..
0BEB93                   	; lcd_height-1, lignes figees comprises. XCLS n'efface que xc_top ..
0BEB93                   	; lcd_height-1 et place le curseur en (0,xc_top).
0BEB93                   	;
0BEB93                   	; Calque sur 0F9307h, la fin de CLS, avec les commandes documentees du device 0 :
0BEB93                   	;   CLS  : 51h clear_disp            / 45h cursor_type, BA=0 / curseur (0,0)
0BEB93                   	;   XCLS : 49h clear_line par ligne  / 45h cursor_type, BA=0 / curseur (0,xc_top)
0BEB93                   	; et, comme CLS (0F9367h), les bits 0-1 de [(basptr)+070h] remis a zero --
0BEB93                   	; ceux que LOCATE arme (0FC698h).
0BEB93                   	;
0BEB93                   	; La hauteur est RELUE dans lcd_height a chaque appel, et non memorisee : si
0BEB93                   	; l'editeur l'a changee, XCLS suit la ROM au lieu de la contredire.
0BEB93                   	xcls:
0BEB93 2C                	        pushu   x                       ; le point de reprise
0BEB94 2B                	        pushu   i
0BEB95 88 1D EE 0B       	        mv      a,[!xc_top]
0BEB99 A8 1E EE 0B       	        mv      [!xcl_y],a
0BEB9D                   	xl_loop:
0BEB9D 88 1E EE 0B       	        mv      a,[!xcl_y]
0BEBA1 30 A0 D5          	        mv      (bh),a                  ; ordonnee de la ligne (argument de 49h)
0BEBA4 88 9E FC 0B       	        mv      a,[lcd_height]
0BEBA8 30 63 D5          	        cmp     (bh),a                  ; ligne - hauteur : NC = hors fenetre
0BEBAB 1E 17             	        jrnc    xl_done
0BEBAD 30 CD D6 00 00    	        mvw     (cl),00000H             ; device 0, lecteur 0
0BEBB2 09 49             	        mv      il,d0_clear_line
0BEBB4 05 E8 FF 0F       	        callf   iocs_call
0BEBB8 88 1E EE 0B       	        mv      a,[!xcl_y]
0BEBBC 6C 00             	        inc     a
0BEBBE A8 1E EE 0B       	        mv      [!xcl_y],a
0BEBC2 13 27             	        jr      xl_loop
0BEBC4                   	xl_done:
0BEBC4 09 45             	        mv      il,d0_cursor_type
0BEBC6 4C 22             	        sub     ba,ba                   ; pas de curseur, comme 0F930Eh
0BEBC8 30 CD D6 00 00    	        mvw     (cl),00000H
0BEBCD 05 E8 FF 0F       	        callf   iocs_call
0BEBD1 08 00             	        mv      a,000H
0BEBD3 A8 27 FC 0B       	        mv      [scrn_crsr_x],a
0BEBD7 88 1D EE 0B       	        mv      a,[!xc_top]
0BEBDB A8 28 FC 0B       	        mv      [scrn_crsr_y],a
0BEBDF 30 84 D1          	        mv      x,(basptr)
0BEBE2 90 84 70          	        mv      a,[x+070H]
0BEBE5 70 FC             	        and     a,0FCH                  ; les bits de LOCATE, comme CLS
0BEBE7 B0 84 70          	        mv      [x+070H],a
0BEBEA 3B                	        popu    i
0BEBEB 3C                	        popu    x
0BEBEC 9F                	        rc
0BEBED 07                	        retf
0BEBEE                   	
0BEBEE                   	; ============================================================================
0BEBEE                   	; LE FILTRE D'ECRITURE DE STDO:  --  confine le defilement a la fenetre
0BEBEE                   	; ============================================================================
0BEBEE                   	; ⛔ LE FILTRE NE SE CHAINE PAS DANS d_link, ET C'EST LA MACHINE QUI LE DIT.
0BEBEE                   	;    L'ecriture par le FCS ne passe PAS par iocs_call : en 0E0907h, il saute
0BEBEE                   	;    (retf) a l'adresse rangee en [bloc+2] du bloc de controle du handle, et
0BEBEE                   	;    cette adresse est memorisee a l'OUVERTURE (0E07F1h). Releve dans la System
0BEBEE                   	;    Data Area d'un PC-E500S reel (Samples/Extraction/s1-1.bin) :
0BEBEE                   	;
0BEBEE                   	;      bloc du handle 0 en 0BEE48h : 00 00 E7 21 0F A2 02
0BEBEE                   	;                                    |  |  \______/ \
0BEBEE                   	;                                device lecteur  0F21E7h = drv_display, attribut
0BEBEE                   	;
0BEBEE                   	;    Un en-tete ajoute en tete de d_link (la methode de MEMCHECK) ne verrait donc
0BEBEE                   	;    jamais un PRINT. On remplace l'adresse du bloc du handle 0 par xf_entry, et
0BEBEE                   	;    le filtre transmet a l'ancienne adresse -- recopiee dans les operandes de
0BEBEE                   	;    xf_pass et xf_call (auto-modification, comme MEMCHECK). Si la ROM rouvre
0BEBEE                   	;    STDO:, le filtre disparait simplement : l'echec est sans danger.
0BEBEE                   	;
0BEBEE                   	; LE BLOC DE CONTROLE se trouve comme en 0E0698h / 0E066Ah :
0BEBEE                   	;    numero = [fhandle + handle] ; bloc = [(iocsw)] + [(iocsw)+25h]
0BEBEE                   	;    + numero * 1Fh, borne par [(iocsw)+27h] ; octet 0 = device (0FFh = libre).
0BEBEE                   	;
0BEBEE                   	; LE PRINCIPE : DEFILER AVANT LA ROM. Pour un octet, le pilote fait (0F2A47h) :
0BEBEE                   	;    affichable        : retour a la ligne differe (0F2B57h : X >= largeur ->
0BEBEE                   	;                        X=0, Y+1), puis 0F2B6Ah (Y >= lcd_height -> defilement
0BEBEE                   	;                        de la ROM, Y = lcd_height-1), puis l'affichage ;
0BEBEE                   	;    0Dh               : 0F2B6Ah seul ;
0BEBEE                   	;    08 09 0A 0B 1C 1D 1F : 0F2B57h puis 0F2B6Ah ;
0BEBEE                   	;    07 0C 1E et le reste : pas de 0F2B6Ah.
0BEBEE                   	; Le filtre calcule la ligne que verra 0F2B6Ah. Si la ROM allait defiler, il
0BEBEE                   	; defile LUI-MEME les lignes debut .. lcd_height-1 (55h pattern_read, 56h
0BEBEE                   	; pattern_write, 49h clear_line), puis remonte Y pour que la ROM ne defile plus.
0BEBEE                   	; L'octet est ensuite transmis tel quel : le pilote fait tout le reste.
0BEBEE                   	;
0BEBEE                   	; ⚠️ SEULS LES ECRITURES DU HANDLE 0 SONT VUES. Un OPEN "SCRN:" ouvre un autre
0BEBEE                   	;    handle, qui garde l'adresse de la ROM.
0BEBEE                   	; ⚠️ NE PAS RECHARGER LE MODULE FILTRE BRANCHE. Entre LOAD M et CALL &BF000, le
0BEBEE                   	;    handle 0 designerait du code ecrase. Faire XCONSOLE avant de recharger ;
0BEBEE                   	;    CALL &BF000 debranche ensuite tout filtre reste dans la zone du module.
0BEBEE                   	
0BEBEE                   	; xf_entry -- l'entree du filtre : memes registres qu'une entree de pilote.
0BEBEE                   	xf_entry:
0BEBEE 2A                	        pushu   ba
0BEBEF FD 23             	        mv      ba,i
0BEBF1 60 0D             	        cmp     a,00DH                  ; write_byte
0BEBF3 18 09             	        jrz     xf_wbyte
0BEBF5 60 0B             	        cmp     a,00BH                  ; write_block
0BEBF7 18 13             	        jrz     xf_wblock
0BEBF9 3A                	        popu    ba
0BEBFA                   	xf_pass:
0BEBFA 03 E7 21 0F       	        jpf     0F21E7H                 ; OPERANDE REECRIT par xf_on
0BEBFE                   	xf_wbyte:
0BEBFE 3A                	        popu    ba                      ; A = l'octet, I = 0Dh
0BEBFF 2C                	        pushu   x
0BEC00 2D                	        pushu   y
0BEC01 2B                	        pushu   i
0BEC02 2A                	        pushu   ba
0BEC03 04 30 EC          	        call    xf_pre
0BEC06 3A                	        popu    ba
0BEC07 3B                	        popu    i
0BEC08 3D                	        popu    y
0BEC09 3C                	        popu    x
0BEC0A 13 12             	        jr      xf_pass
0BEC0C                   	
0BEC0C                   	; write_block : X = source, Y = compte. On le rend octet par octet au pilote,
0BEC0C                   	; chacun precede de son controle ; Y est rendu tel quel, comme 0F2A18h.
0BEC0C                   	xf_wblock:
0BEC0C 3A                	        popu    ba
0BEC0D 2D                	        pushu   y
0BEC0E                   	xb_lp:
0BEC0E 6C 05             	        inc     y
0BEC10 7C 05             	        dec     y
0BEC12 18 14             	        jrz     xb_end
0BEC14 90 24             	        mv      a,[x++]
0BEC16 2C                	        pushu   x
0BEC17 2D                	        pushu   y
0BEC18 28                	        pushu   a
0BEC19 04 30 EC          	        call    xf_pre
0BEC1C 38                	        popu    a
0BEC1D 09 0D             	        mv      il,00DH
0BEC1F 04 2B EC          	        call    xf_call                 ; write_byte de l'ancien pilote
0BEC22 3D                	        popu    y
0BEC23 3C                	        popu    x
0BEC24 7C 05             	        dec     y
0BEC26 13 1A             	        jr      xb_lp
0BEC28                   	xb_end:
0BEC28 3D                	        popu    y
0BEC29 9F                	        rc
0BEC2A 07                	        retf
0BEC2B                   	
0BEC2B                   	; xf_call -- appelle l'ancien pilote, commande dans IL.  APPEL PROCHE.
0BEC2B                   	xf_call:
0BEC2B 05 E7 21 0F       	        callf   0F21E7H                 ; OPERANDE REECRIT par xf_on
0BEC2F 06                	        ret
0BEC30                   	
0BEC30                   	; xf_pre -- A = l'octet a ecrire. Defile la fenetre si la ROM allait le faire.
0BEC30                   	;           Detruit A, I, X, Y, (bl), (bh).  APPEL PROCHE.
0BEC30                   	xf_pre:
0BEC30 30 A0 D4          	        mv      (bl),a                  ; l'octet, le temps de le classer
0BEC33 88 1D EE 0B       	        mv      a,[!xc_top]
0BEC37 60 00             	        cmp     a,000H
0BEC39 18 6E             	        jrz     xp_none                 ; debut 0 : la ROM suffit
0BEC3B 30 A0 D5          	        mv      (bh),a
0BEC3E 88 9E FC 0B       	        mv      a,[lcd_height]
0BEC42 30 63 D5          	        cmp     (bh),a                  ; debut - hauteur : NC = pas de fenetre
0BEC45 1E 62             	        jrnc    xp_none
0BEC47 30 80 D4          	        mv      a,(bl)
0BEC4A 60 20             	        cmp     a,020H
0BEC4C 1E 1B             	        jrnc    xp_wrap                 ; affichable
0BEC4E 66 29 FC 0B 40    	        test    [ctrl_disp],040H
0BEC53 1A 14             	        jrnz    xp_wrap                 ; code de controle affiche (0F2A56h)
0BEC55 60 0D             	        cmp     a,00DH
0BEC57 18 25             	        jrz     xp_nw                   ; CR : 0F2B6Ah sans 0F2B57h
0BEC59 60 08             	        cmp     a,008H
0BEC5B 1C 4C             	        jrc     xp_none                 ; 00-07
0BEC5D 60 0C             	        cmp     a,00CH
0BEC5F 1C 08             	        jrc     xp_wrap                 ; 08 09 0A 0B
0BEC61 60 1C             	        cmp     a,01CH
0BEC63 1C 44             	        jrc     xp_none                 ; 0C-1B
0BEC65 60 1E             	        cmp     a,01EH
0BEC67 18 40             	        jrz     xp_none                 ; 1E, curseur vers le haut
0BEC69                   	xp_wrap:                                ; 1C 1D 1F et les affichables
0BEC69 09 00             	        mv      il,000H
0BEC6B 30 D0 D4 27 FC 0B 	        mv      (bl),[scrn_crsr_x]
0BEC71 88 9D FC 0B       	        mv      a,[lcd_width]
0BEC75 30 63 D4          	        cmp     (bl),a                  ; X - largeur : NC = retour differe
0BEC78 1C 06             	        jrc     xp_chk
0BEC7A 09 01             	        mv      il,001H
0BEC7C 12 02             	        jr      xp_chk
0BEC7E                   	xp_nw:
0BEC7E 09 00             	        mv      il,000H
0BEC80                   	xp_chk:
0BEC80 88 28 FC 0B       	        mv      a,[scrn_crsr_y]
0BEC84 46 01             	        add     a,il                    ; la ligne que verra 0F2B6Ah
0BEC86 30 A0 D5          	        mv      (bh),a
0BEC89 88 9E FC 0B       	        mv      a,[lcd_height]
0BEC8D 30 63 D5          	        cmp     (bh),a                  ; NC : la ROM defilerait
0BEC90 1C 17             	        jrc     xp_none
0BEC92 A9 1F EE 0B       	        mv      [!xf_w],il
0BEC96 04 AA EC          	        call    xf_scroll
0BEC99 88 9E FC 0B       	        mv      a,[lcd_height]
0BEC9D 7C 00             	        dec     a
0BEC9F 89 1F EE 0B       	        mv      il,[!xf_w]
0BECA3 4E 01             	        sub     a,il                    ; lcd_height-1-retour : plus de defilement ROM
0BECA5 A8 28 FC 0B       	        mv      [scrn_crsr_y],a
0BECA9                   	xp_none:
0BECA9 06                	        ret
0BECAA                   	
0BECAA                   	; xf_scroll -- remonte d'une ligne les lignes debut+1 .. lcd_height-1, puis
0BECAA                   	;              efface la derniere.  APPEL PROCHE.
0BECAA                   	xf_scroll:
0BECAA 88 1D EE 0B       	        mv      a,[!xc_top]
0BECAE A8 20 EE 0B       	        mv      [!xf_y],a
0BECB2                   	xs_lp:
0BECB2 88 20 EE 0B       	        mv      a,[!xf_y]
0BECB6 6C 00             	        inc     a
0BECB8 30 A0 D5          	        mv      (bh),a                  ; la ligne du dessous
0BECBB 88 9E FC 0B       	        mv      a,[lcd_height]
0BECBF 30 63 D5          	        cmp     (bh),a
0BECC2 1E 25             	        jrnc    xs_clr                  ; plus rien a remonter
0BECC4 0C 21 EE 0B       	        mv      x,xf_buf
0BECC8 09 55             	        mv      il,d0_pattern_read
0BECCA 04 2B EC          	        call    xf_call
0BECCD 88 20 EE 0B       	        mv      a,[!xf_y]
0BECD1 30 A0 D5          	        mv      (bh),a
0BECD4 0C 21 EE 0B       	        mv      x,xf_buf
0BECD8 09 56             	        mv      il,d0_pattern_write
0BECDA 04 2B EC          	        call    xf_call
0BECDD 88 20 EE 0B       	        mv      a,[!xf_y]
0BECE1 6C 00             	        inc     a
0BECE3 A8 20 EE 0B       	        mv      [!xf_y],a
0BECE7 13 37             	        jr      xs_lp
0BECE9                   	xs_clr:
0BECE9 88 9E FC 0B       	        mv      a,[lcd_height]
0BECED 7C 00             	        dec     a
0BECEF 30 A0 D5          	        mv      (bh),a
0BECF2 09 49             	        mv      il,d0_clear_line
0BECF4 04 2B EC          	        call    xf_call
0BECF7 06                	        ret
0BECF8                   	
0BECF8                   	; xf_fcb -- X = le bloc de controle du handle 0 ; CY=1 s'il n'est pas l'ecran.
0BECF8                   	;           Detruit A, I, (bl).  APPEL PROCHE.
0BECF8                   	xf_fcb:
0BECF8 88 6D FC 0B       	        mv      a,[fhandle]             ; handle 0 -> numero de bloc
0BECFC 30 A0 D4          	        mv      (bl),a
0BECFF 30 84 E6          	        mv      x,(iocsw)
0BED02 90 84 27          	        mv      a,[x+027H]              ; nombre de blocs
0BED05 30 63 D4          	        cmp     (bl),a
0BED08 1E 1E             	        jrnc    xfc_no
0BED0A 93 84 25          	        mv      i,[x+025H]
0BED0D 45 43             	        add     x,i                     ; le premier bloc
0BED0F 0B 1F 00          	        mv      i,0001FH                ; 31 octets par bloc
0BED12                   	xfc_lp:
0BED12 30 80 D4          	        mv      a,(bl)
0BED15 60 00             	        cmp     a,000H
0BED17 18 07             	        jrz     xfc_at
0BED19 45 43             	        add     x,i
0BED1B 30 7D D4          	        dec     (bl)
0BED1E 13 0E             	        jr      xfc_lp
0BED20                   	xfc_at:
0BED20 90 04             	        mv      a,[x]                   ; le device du bloc
0BED22 60 00             	        cmp     a,000H
0BED24 1A 02             	        jrnz    xfc_no                  ; libre (0FFh) ou pas l'ecran
0BED26 9F                	        rc
0BED27 06                	        ret
0BED28                   	xfc_no:
0BED28 97                	        sc
0BED29 06                	        ret
0BED2A                   	
0BED2A                   	; xf_on -- branche le filtre sur le handle 0.  APPEL PROCHE.
0BED2A                   	;          Deja branche (adresse dans la zone du module) : ne rien faire, sans
0BED2A                   	;          quoi le filtre se transmettrait a lui-meme.
0BED2A                   	;
0BED2A                   	;    ⛔ DANS LE PILOTE (BASEXT-DRV), LA PLAGE 0BF000h-0BFFFFh NE DIT RIEN : le
0BED2A                   	;       bloc reside ailleurs dans S1:, et un « deja nous » par plage laisserait
0BED2A                   	;       le filtre se brancher sur lui-meme au second XCONSOLE (recursion sans
0BED2A                   	;       fin). Le pilote compare donc l'adresse en place a xf_entry, exactement.
0BED2A                   	;       Ces octets de plage ne sont pas des champs d'adresse : la mesure de
0BED2A                   	;       relocation (reloc.py) ne pouvait pas les voir. Releve a la lecture le
0BED2A                   	;       2026-09-16. Le module autonome garde son test, eprouve sur machine.
0BED2A                   	xf_on:
0BED2A 04 F8 EC          	        call    xf_fcb
0BED2D 1C 17             	        jrc     xon_ret
0BED2F 04 59 ED          	        call    xf_nous                 ; Z = l'adresse en place est xf_entry
0BED32 18 12             	        jrz     xon_ret                 ; deja nous
0BED34                   	xon_set:
0BED34 95 84 02          	        mv      y,[x+002H]              ; l'adresse en place : la ROM, ou un autre
0BED37 AD FB EB 0B       	        mv      [!xf_pass+1],y
0BED3B AD 2C EC 0B       	        mv      [!xf_call+1],y
0BED3F 0D EE EB 0B       	        mv      y,xf_entry
0BED43 B5 84 02          	        mv      [x+002H],y              ; une seule instruction : atomique
0BED46                   	xon_ret:
0BED46 06                	        ret
0BED47                   	
0BED47                   	; xf_off -- debranche le filtre : rend l'adresse gardee dans xf_pass. Apres un
0BED47                   	;           rechargement du module, c'est celle de l'assemblage, 0F21E7h.
0BED47                   	;           APPEL PROCHE.
0BED47                   	xf_off:
0BED47 04 F8 EC          	        call    xf_fcb
0BED4A 1C 0C             	        jrc     xof_ret
0BED4C 04 59 ED          	        call    xf_nous                 ; pilote : seulement NOTRE filtre
0BED4F 1A 07             	        jrnz    xof_ret
0BED51 8D FB EB 0B       	        mv      y,[!xf_pass+1]
0BED55 B5 84 02          	        mv      [x+002H],y
0BED58                   	xof_ret:
0BED58 06                	        ret
0BED59                   	
0BED59                   	; xf_nous -- Z=1 si l'adresse en place dans le bloc X ([x+2], 3 octets) est
0BED59                   	;            xf_entry. Preserve X. Detruit Y. APPEL PROCHE. Pilote seulement.
0BED59                   	;            Le test de zero sur 20 bits emprunte l'idiome du DRIVER_TEMPLATE
0BED59                   	;            (« inc x / jrz » sur 0FFFFFh) : dec puis inc ramene a zero.
0BED59                   	xf_nous:
0BED59 2C                	        pushu   x
0BED5A 95 84 02          	        mv      y,[x+002H]
0BED5D 0C EE EB 0B       	        mv      x,xf_entry
0BED61 4D 54             	        sub     y,x
0BED63 3C                	        popu    x
0BED64 7C 05             	        dec     y
0BED66 6C 05             	        inc     y
0BED68 06                	        ret
