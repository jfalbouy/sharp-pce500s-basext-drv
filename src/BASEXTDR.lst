0BE1E6                   	
0BE1E6                   	; ============================================================================
0BE1E6                   	; LA DIVISION BINAIRE A RESTAURATION -- 24 tours, tout en RAM interne
0BE1E6                   	; ============================================================================
0BE1E6                   	; Tout tient dans la QUEUE du cadre courant, (bp+4) a (bp+14), dont dec2bin n'a
0BE1E6                   	; plus l'usage. C'est de la RAM interne, donc rapide, et cela reste valable quel
0BE1E6                   	; que soit le cadre ou nous sommes.
0BE1E6                   	;
0BE1E6                   	;   A    : (bp+4),(bp+5),(bp+6)     relu de sv_a ; consomme par le decalage --
0BE1E6                   	;                                   le quotient est jete, MOD n'en veut pas
0BE1E6                   	;   cnt  : (bp+7)                   le compteur de tours
0BE1E6                   	;   rst  : (bp+8),(bp+9),(bp+10)    le reste en construction
0BE1E6                   	;   tmp  : (bp+12),(bp+13),(bp+14)  rst - B, garde s'il n'y a pas d'emprunt
0BE1E6                   	;   B    : (bp+1),(bp+2),(bp+3)     la ou dec2bin vient de le mettre
0BE1E6                   	;
0BE1E6                   	; ⛔ SHL, ET SURTOUT PAS ROL -- C'EST LA QUE MOD RENDAIT 0 POUR TOUT.
0BE1E6                   	;    Sur ce processeur, ROL/ROR sont CIRCULAIRES dans l'octet : la retenue recoit
0BE1E6                   	;    bien le bit sortant, mais ce bit revient aussi en bas du MEME octet, et rien
0BE1E6                   	;    ne passe a l'octet suivant. Une premiere version decalait A avec six « rol » :
0BE1E6                   	;    chaque octet tournait sur lui-meme, le reste ne recevait jamais aucun bit et
0BE1E6                   	;    valait donc 0 -- pour toutes les valeurs, ce qu'a montre la machine.
0BE1E6                   	;
0BE1E6                   	;    LA ROM TRANCHE, ET DANS LES DEUX SENS :
0BE1E6                   	;      . elle CHAINE « shr » sur des octets consecutifs -- « F5 12 F5 13 F5 14
0BE1E6                   	;        F5 15 F5 16 » en 0EEBB8h, un decalage de cinq octets. Seul un decalage
0BE1E6                   	;        A TRAVERS la retenue peut se chainer ainsi ;
0BE1E6                   	;      . et elle emploie « ror » la ou il faut LIRE les bits sans detruire
0BE1E6                   	;        l'octet : bin2dec fait « ror (00Bh) / jrnc » huit fois par octet
0BE1E6                   	;        (0EFBA3h), et huit rotations circulaires le rendent intact.
0BE1E6                   	;    Les deux usages sont coherents, et ils s'excluent.
0BE1E6                   	;
0BE1E6                   	; 📄 Notre propre reference (SC62015_InstructionSet_Reference.md) decrit ROL et
0BE1E6                   	;    SHL de la MEME facon, « via C » -- ce qui ne peut pas etre vrai des deux.
0BE1E6                   	;    A corriger la-bas : la ROM est l'arbitre.
0BE1E6                   	;
0BE1E6                   	; ⛔ ET CES DECALAGES NE CONSULTENT PAS I. bin2dec enchaine « ror (00Bh) / jrnc »
0BE1E6                   	;    alors que IL vaut encore 4 d'un dadl precedent, et n'en rotationne qu'un
0BE1E6                   	;    octet. Les instructions BLOC, elles, bouclent I fois -- « mv il,00Fh /
0BE1E6                   	;    mvl (000h),(00Fh) » de la ROM recopie bien 15 octets.
0BE1E6                   	md_calc:
0BE1E6 D2 04 04 EB 0B    	        mvp     (BP+4),[!sv_a]  ; A, revenu de l'abri
0BE1EB DC 08 00 00 00    	        mvp     (BP+8),000000H  ; reste = 0
0BE1F0 CC 07 18          	        mv      (BP+7),00024    ; 24 tours : la largeur de A
0BE1F3                   	md_loop:
0BE1F3 9F                	        rc
0BE1F4 F7 04             	        shl     (BP+4)          ; A <<= 1 ; le bit sortant part dans la retenue
0BE1F6 F7 05             	        shl     (BP+5)
0BE1F8 F7 06             	        shl     (BP+6)
0BE1FA F7 08             	        shl     (BP+8)          ; reste = reste<<1 | ce bit
0BE1FC F7 09             	        shl     (BP+9)
0BE1FE F7 0A             	        shl     (BP+10)
0BE200                   	
0BE200 CA 0C 08          	        mvp     (BP+12),(BP+8)  ; tmp = reste
0BE203 9F                	        rc                      ; SBCL retranche AUSSI la retenue : la vider
0BE204 09 03             	        mv      il,003
0BE206 5C 0C 01          	        sbcl    (BP+12),(BP+1)  ; tmp = reste - B, sur trois octets
0BE209 1C 03             	        jrc     md_next         ; emprunt : reste < B, on ne retranche pas
0BE20B CA 08 0C          	        mvp     (BP+8),(BP+12)  ; sinon le reste devient tmp
0BE20E                   	md_next:
0BE20E 7D 07             	        dec     (BP+7)
0BE210 1B 1F             	        jrnz    md_loop
