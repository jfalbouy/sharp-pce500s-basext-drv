10 REM KILLSOUS : ET SI ON KILL UN PILOTE INSTALLE SOUS BASEXT.SYS ?
20 REM A LANCER AVEC PLINK.SYS ET BASEXT.SYS INSTALLES, TOUS DEUX DANS S1:
30 REM TOUT SE FAIT DANS CE SEUL RUN : NE RIEN TAPER TANT QU'IL N'A PAS FINI,
40 REM CAR UN CROCHET PERIME FAIT TOKENISER PAR UNE TABLE DEPLACEE.
50 REM PEEK ET POKE SEULEMENT : AUCUN MOT-CLE D'EXTENSION.
60 CLEAR :WAIT 150:R0=&57
70 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
80 W=PEEK &BFD0E+PEEK &BFD0F*256+PEEK &BFD10*65536
90 GOSUB 500:B1=B:P1=P
100 IF B1=0 THEN PRINT "BASEXT.SYS ABSENT":END
110 IF P1=0 THEN PRINT "PLINK.SYS ABSENT":END
120 IF P1>B1 THEN PRINT "PLINK EST AU-DESSUS : RIEN A MESURER":END
130 K1=PEEK (W+&90)+PEEK (W+&91)*256+PEEK (W+&92)*65536
140 D1=PEEK (W+&93)+PEEK (W+&94)*256+PEEK (W+&95)*65536
150 O1=K1-B1:O2=D1-B1:GOSUB 600:L1=E
160 PRINT "AVANT BEXT ";HEX$ B1;" PLINK ";HEX$ P1
170 PRINT " NOMS +";HEX$ O1;" ADR +";HEX$ O2;" D_LINK ";L1
180 SET "S1:PLINK.SYS"," "
190 KILL "S1:PLINK.SYS"
200 GOSUB 500:B2=B
210 IF B2=0 THEN PRINT "BLOC PERDU : RESET":END
220 K2=PEEK (W+&90)+PEEK (W+&91)*256+PEEK (W+&92)*65536
230 PRINT "APRES BEXT ";HEX$ B2;" NOMS ";HEX$ K2
240 IF B2=B1 THEN PRINT "BLOC IMMOBILE":GOTO 300
250 PRINT "BLOC DESCENDU DE ";B1-B2
260 IF K2=B2+O1 THEN PRINT "CROCHETS SUIVIS":GOTO 300
270 PRINT "CROCHETS PERIMES : JE LES REFAIS"
280 V=B2+O1:GOSUB 700:V=B2+O2:GOSUB 750
290 GOSUB 600:IF E=0 THEN GOSUB 800
300 GOSUB 600
310 PRINT "FIN NOMS ";HEX$ (PEEK (W+&90)+PEEK (W+&91)*256+PEEK (W+&92)*65536);" D_LINK ";E
320 PRINT "TXT ";HEX$ (PEEK &CB+PEEK &CC*256+PEEK &CD*65536);" DAT ";HEX$ (PEEK &CE+PEEK &CF*256+PEEK &D0*65536)
330 PRINT "REPRISE &";HEX$ (B2+R0);" SI BESOIN"
340 END
500 REM --- CHERCHER BASEXT.SYS (B) ET PLINK.SYS (P) DANS LA CHAINE
510 B=0:P=0:X=T+PEEK (T+18)+PEEK (T+19)*256+PEEK (T+20)*65536
520 IF PEEK X<>&FB THEN RETURN
530 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
540 IF N$="BASEXT  SYS" THEN B=X
550 IF N$="PLINK   SYS" THEN P=X
560 L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536
570 IF L=0 THEN RETURN
580 X=X+L:GOTO 520
600 REM --- E=1 SI NOTRE EN-TETE IOCS EST ENCORE DANS LA CHAINE D_LINK
610 E=0:Q=PEEK &BFCA2+PEEK &BFCA3*256+PEEK &BFCA4*65536
620 IF Q=&FFFFF THEN RETURN
630 IF Q=B2+34 OR Q=B1+34 THEN E=1:RETURN
640 Q=PEEK Q+PEEK (Q+1)*256+PEEK (Q+2)*65536:GOTO 620
700 REM --- REECRIRE LE CROCHET DES NOMS AVEC V
710 POKE W+&90,V-INT (V/256)*256
720 POKE W+&91,INT (V/256)-INT (V/65536)*256
730 POKE W+&92,INT (V/65536):RETURN
750 REM --- REECRIRE LE CROCHET DES ADRESSES AVEC V
760 POKE W+&93,V-INT (V/256)*256
770 POKE W+&94,INT (V/256)-INT (V/65536)*256
780 POKE W+&95,INT (V/65536):RETURN
800 REM --- RECHAINER NOTRE EN-TETE EN TETE DE D_LINK
810 V=PEEK &BFCA2+PEEK &BFCA3*256+PEEK &BFCA4*65536
820 POKE B2+34,V -INT (V/256)*256
830 POKE B2+35,INT (V/256)-INT (V/65536)*256
840 POKE B2+36,INT (V/65536)
850 V=B2+34:POKE &BFCA2,V-INT (V/256)*256
860 POKE &BFCA3,INT (V/256)-INT (V/65536)*256
870 POKE &BFCA4,INT (V/65536):RETURN
