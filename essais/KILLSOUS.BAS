10 REM KILLSOUS : RETIRER SANS CASSE UN PILOTE INSTALLE SOUS BASEXT.SYS
20 REM PHASE 1 : RUN      DETACHE BASEXT (CROCHETS RENDUS, MAILLON DELIE)
30 REM PHASE 2 : RUN 500  APRES LE SET/KILL TAPE EN MODE DIRECT
40 REM SET ET KILL SONT DES COMMANDES DE MODE DIRECT : UN PROGRAMME QUI LES
50 REM CONTIENT REND DIRECT COMMAND ERROR. MESURE LE 2026-09-25.
60 REM A0=BD_ARRET +32H, R0=BD_REPRISE +57H, IH=EN-TETE IOCS +22H
70 CLEAR :A0=&32:R0=&57:IH=&22
80 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
90 W=PEEK &BFD0E+PEEK &BFD0F*256+PEEK &BFD10*65536
100 GOSUB 700
110 IF B=0 THEN PRINT "BASEXT.SYS ABSENT":END
120 PRINT "BLOC ";HEX$ B;" ARRET &";HEX$ (B+A0);" REPRISE &";HEX$ (B+R0)
130 K=PEEK (W+&90)+PEEK (W+&91)*256+PEEK (W+&92)*65536
140 PRINT "CROCHET NOMS ";HEX$ K
150 PRINT "1) JE RENDS LES CROCHETS"
160 CALL B+A0
170 K=PEEK (W+&90)+PEEK (W+&91)*256+PEEK (W+&92)*65536
180 IF K<>&FFFFF THEN PRINT "ECHEC : CROCHET ";HEX$ K:END
190 PRINT " OK, SENTINELLE RENDUE"
200 PRINT "2) JE DELIE LE MAILLON D_LINK"
210 GOSUB 800
220 IF E=0 THEN PRINT " DEJA ABSENT":GOTO 240
230 PRINT " OK, DELIE"
240 PRINT "3) TAPEZ MAINTENANT, EN DIRECT :"
250 PRINT "   SET ""S1:PLINK.SYS"","" """
260 PRINT "   KILL ""S1:PLINK.SYS"""
270 PRINT "4) PUIS : RUN 500"
280 END
500 REM --- PHASE 2 : APRES LE KILL
510 CLEAR :A0=&32:R0=&57:IH=&22
520 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
530 W=PEEK &BFD0E+PEEK &BFD0F*256+PEEK &BFD10*65536
540 GOSUB 700
550 IF B=0 THEN PRINT "BLOC PERDU AU KILL":END
560 IF P>0 THEN PRINT "PLINK EST TOUJOURS LA":END
570 PRINT "BLOC ";HEX$ B
580 CALL B+R0
590 GOSUB 800
600 K=PEEK (W+&90)+PEEK (W+&91)*256+PEEK (W+&92)*65536
610 PRINT "REPRISE FAITE : NOMS ";HEX$ K;" D_LINK ";E
620 IF K=B+&969 THEN PRINT "CROCHET CONFORME"
630 PRINT "TXT ";HEX$ (PEEK &CB+PEEK &CC*256+PEEK &CD*65536);" DAT ";HEX$ (PEEK &CE+PEEK &CF*256+PEEK &D0*65536)
640 END
700 REM --- B=BASEXT.SYS, P=PLINK.SYS
710 B=0:P=0:X=T+PEEK (T+18)+PEEK (T+19)*256+PEEK (T+20)*65536
720 IF PEEK X<>&FB THEN RETURN
730 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
740 IF N$="BASEXT  SYS" THEN B=X
750 IF N$="PLINK   SYS" THEN P=X
760 L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536
770 IF L=0 THEN RETURN
780 X=X+L:GOTO 720
800 REM --- E=1 SI NOTRE EN-TETE EST DANS D_LINK ; SINON LE DELIER
810 E=0:H=B+IH:Q=&BFCA2:V=PEEK Q+PEEK (Q+1)*256+PEEK (Q+2)*65536
820 IF V=&FFFFF THEN RETURN
830 IF V=H THEN E=1:GOTO 850
840 Q=V:V=PEEK Q+PEEK (Q+1)*256+PEEK (Q+2)*65536:GOTO 820
850 REM --- Q PORTE LE LIEN VERS NOTRE EN-TETE : Y METTRE NOTRE SUIVANT
860 V=PEEK H+PEEK (H+1)*256+PEEK (H+2)*65536
870 POKE Q,V -INT (V/256)*256
880 POKE Q+1,INT (V/256)-INT (V/65536)*256
890 POKE Q+2,INT (V/65536):RETURN
