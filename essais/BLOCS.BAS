10 REM BLOCS : LA CHAINE DES BLOCS DE S1: (PEEK SEULEMENT)
20 CLEAR :WAIT 150
30 T=PEEK &BFC15+PEEK &BFC16*256+PEEK &BFC17*65536
40 X=T+PEEK (T+18)+PEEK (T+19)*256+PEEK (T+20)*65536
50 IF PEEK X<>&FB THEN 110
60 N$="":FOR I=1 TO 11:N$=N$+CHR$ PEEK (X+I):NEXT I
70 L=PEEK (X+17)+PEEK (X+18)*256+PEEK (X+19)*65536
80 PRINT HEX$ X;" ";N$;" ";HEX$ PEEK (X+12);" ";L
90 IF L=0 THEN 110
100 X=X+L:GOTO 50
110 PRINT "FIN ";HEX$ X;" S1BTM ";HEX$ (PEEK &BFCDE+PEEK &BFCDF*256+PEEK &BFCE0*65536)
120 PRINT "TXT ";HEX$ (PEEK &CB+PEEK &CC*256+PEEK &CD*65536);" DAT ";HEX$ (PEEK &CE+PEEK &CF*256+PEEK &D0*65536)
